    umlmeta:oclConstraint "self.base_Class->closure(part->select(p|p.type.oclIsKindOf(UML::Class)).type.oclAsType(UML::Class))->excludes(self.base_Class)" ;
    umlmeta:oclConstraint "UML::Classifier.allInstances()->select(c | c.general->includes(self.base_Class))->forAll(c | Block.allInstances()->includes(c))" ;
    umlmeta:oclConstraint "self.base_Class.ownedAttribute->select(a| ValueType.allInstances().base_DataType->includes(a.type))->forAll(a|a.isComposite())" .

