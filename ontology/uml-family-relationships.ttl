    umlmeta:oclConstraint "templateParameterSubstitution.actual->forAll(a | a.oclIsKindOf(Classifier))" ;
    umlmeta:oclConstraint "templateParameterSubstitution.actual->forAll( a | let arg : Classifier = a.oclAsType(Classifier) in constrainingClassifier->forAll( cc | arg = cc or arg.conformsTo(cc) or (allowSubstitutable and arg.isSubstitutableFor(cc)) ) )" ;
    umlmeta:oclConstraint "constrainingClassifier->forAll( cc | parameteredElement = cc or parameteredElement.conformsTo(cc) or (allowSubstitutable and parameteredElement.isSubstitutableFor(cc)) )" .

uml:Clause a owl:Class ;
    rdfs:label "Clause"@en ;
