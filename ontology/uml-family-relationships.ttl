    umlmeta:oclConstraint "(selection<>null) = (ordering=ObjectNodeOrderingKind::ordered)" ;
    umlmeta:oclConstraint "(not isControlType) implies incoming->union(outgoing)->forAll(oclIsKindOf(ObjectFlow))" .

