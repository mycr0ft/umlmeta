uml:Message a owl:Class ;
    rdfs:label "Message"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Interactions" ;
    skos:definition "A Message defines a particular communication between Lifelines of an Interaction."@en ;
    rdfs:subClassOf uml:NamedElement ;
    umlmeta:oclConstraint "receiveEvent.oclIsKindOf(MessageOccurrenceSpecification) implies let f : Lifeline = sendEvent->select(oclIsKindOf(MessageOccurrenceSpecification)).oclAsType(MessageOccurrenceSpecification)->asOrderedSet()->first().covered in f = receiveEvent->select(oclIsKindOf(MessageOccurrenceSpecification)).oclAsType(MessageOccurrenceSpecification)->asOrderedSet()->first().covered implies f.events->indexOf(sendEvent.oclAsType(MessageOccurrenceSpecification)->asOrderedSet()->first() ) indexOf(receiveEvent.oclAsType(MessageOccurrenceSpecification)->asOrderedSet()->first() )" ;
    umlmeta:oclConstraint "(no specification serialized)" ;
    umlmeta:oclConstraint "sendEvent->notEmpty() and receiveEvent->notEmpty() implies let sendEnclosingFrag : Set(InteractionFragment) = sendEvent->asOrderedSet()->first().enclosingFragment() in let receiveEnclosingFrag : Set(InteractionFragment) = receiveEvent->asOrderedSet()->first().enclosingFragment() in sendEnclosingFrag = receiveEnclosingFrag" ;
    umlmeta:oclConstraint "(messageSort = MessageSort::asynchSignal ) and signature.oclIsKindOf(Signal) implies let signalAttributes : OrderedSet(Property) = signature.oclAsType(Signal).inheritedMember()-> select(n:NamedElement | n.oclIsTypeOf(Property))->collect(oclAsType(Property))->asOrderedSet() in signalAttributes->size() = self.argument->size() and self.argument->forAll( o: ValueSpecification | not (o.oclIsKindOf(Expression) and o.oclAsType(Expression).symbol->size()=0 and o.oclAsType(Expression).operand->isEmpty() ) implies let p : Property = signalAttributes->at(self.argument->indexOf(o)) in o.type.oclAsType(Classifier).conformsTo(p.type.oclAsType(Classifier)))" ;
    umlmeta:oclConstraint "(no specification serialized)" ;
    umlmeta:oclConstraint "signature->notEmpty() implies ((signature.oclIsKindOf(Operation) and (messageSort = MessageSort::asynchCall or messageSort = MessageSort::synchCall or messageSort = MessageSort::reply) ) or (signature.oclIsKindOf(Signal) and messageSort = MessageSort::asynchSignal ) ) and name = signature.name" ;
    umlmeta:oclConstraint "(messageSort = MessageSort::asynchCall or messageSort = MessageSort::synchCall) and signature.oclIsKindOf(Operation) implies let requestParms : OrderedSet(Parameter) = signature.oclAsType(Operation).ownedParameter-> select(direction = ParameterDirectionKind::inout or direction = ParameterDirectionKind::_'in' ) in requestParms->size() = self.argument->size() and self.argument->forAll( o: ValueSpecification | not (o.oclIsKindOf(Expression) and o.oclAsType(Expression).symbol->size()=0 and o.oclAsType(Expression).operand->isEmpty() ) implies let p : Parameter = requestParms->at(self.argument->indexOf(o)) in o.type.oclAsType(Classifier).conformsTo(p.type.oclAsType(Classifier)) )" ;
    umlmeta:oclConstraint "(messageSort = MessageSort::reply) and signature.oclIsKindOf(Operation) implies let replyParms : OrderedSet(Parameter) = signature.oclAsType(Operation).ownedParameter-> select(direction = ParameterDirectionKind::inout or direction = ParameterDirectionKind::out or direction = ParameterDirectionKind::return) in replyParms->size() = self.argument->size() and self.argument->forAll( o: ValueSpecification | o.oclIsKindOf(Expression) and let e : Expression = o.oclAsType(Expression) in e.operand->notEmpty() implies let p : Parameter = replyParms->at(self.argument->indexOf(o)) in e.operand->asSequence()->first().type.oclAsType(Classifier).conformsTo(p.type.oclAsType(Classifier)) )" .

uml:Package a owl:Class ;
    rdfs:label "Package"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Packages" ;
    skos:definition "A package can have one or more profile applications to indicate which profiles have been applied. Because a profile is a package, it is possible to apply a profile not only to packages, but also to profiles. Package specializes TemplateableElement and PackageableElement specializes ParameterableElement to specify that a package can be used as a template and a PackageableElement as a template parameter. A package is used to group elements, and provides a namespace for the grouped elements."@en ;
    rdfs:subClassOf uml:PackageableElement ;
    rdfs:subClassOf uml:Namespace ;
    rdfs:subClassOf uml:TemplateableElement ;
    umlmeta:oclConstraint "packagedElement->forAll(e | e.visibility<> null implies e.visibility = VisibilityKind::public or e.visibility = VisibilityKind::private)" .

uml:Model a owl:Class ;
    rdfs:label "Model"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Packages" ;
    skos:definition "A model captures a view of a physical system. It is an abstraction of the physical system, with a certain purpose. This purpose determines what is to be included in the model and what is irrelevant. Thus the model completely describes those aspects of the physical system that are relevant to the purpose of the model, at the appropriate level of detail."@en ;
    rdfs:subClassOf uml:Package ;
    umlmeta:oclConstraint "packagedElement->forAll(e | e.visibility<> null implies e.visibility = VisibilityKind::public or e.visibility = VisibilityKind::private)" .

uml:ObjectFlow a owl:Class ;
    rdfs:label "ObjectFlow"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Activities" ;
    skos:definition "An ObjectFlow is an ActivityEdge that is traversed by object tokens that may hold values. Object flows also support multicast/receive, token selection from object nodes, and transformation of tokens."@en ;
    rdfs:subClassOf uml:ActivityEdge ;
    umlmeta:oclConstraint "selection<>null implies selection.inputParameters()->size()=1 and selection.inputParameters()->forAll(not isUnique and is(0,*)) and selection.outputParameters()->size()=1" ;
    umlmeta:oclConstraint "not (source.oclIsKindOf(ExecutableNode) or target.oclIsKindOf(ExecutableNode))" ;
    umlmeta:oclConstraint "transformation<>null implies transformation.inputParameters()->size()=1 and transformation.outputParameters()->size()=1" ;
    umlmeta:oclConstraint "selection<>null implies source.oclIsKindOf(ObjectNode)" ;
    umlmeta:oclConstraint "(no specification serialized)" ;
    umlmeta:oclConstraint "(no specification serialized)" ;
    umlmeta:oclConstraint "(no specification serialized)" ;
    umlmeta:oclConstraint "not (isMulticast and isMultireceive)" .

uml:OpaqueAction a owl:Class ;
    rdfs:label "OpaqueAction"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Actions" ;
    skos:definition "An OpaqueAction is an Action whose functionality is not specified within UML."@en ;
    rdfs:subClassOf uml:Action ;
    umlmeta:oclConstraint "language->notEmpty() implies (_'body'->size() = language->size())" .

uml:OpaqueExpression a owl:Class ;
    rdfs:label "OpaqueExpression"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Values" ;
    skos:definition "An OpaqueExpression is a ValueSpecification that specifies the computation of a collection of values either in terms of a UML Behavior or based on a textual statement in a language other than UML"@en ;
    rdfs:subClassOf uml:ValueSpecification ;
    umlmeta:oclConstraint "language->notEmpty() implies (_'body'->size() = language->size())" ;
    umlmeta:oclConstraint "behavior <> null implies behavior.ownedParameter->select(direction=ParameterDirectionKind::return)->size() = 1" ;
    umlmeta:oclConstraint "behavior <> null implies behavior.ownedParameter->forAll(not isStream and (direction=ParameterDirectionKind::in or direction=ParameterDirectionKind::return))" .

uml:Operation a owl:Class ;
    rdfs:label "Operation"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Classification" ;
    skos:definition "An Operation is a BehavioralFeature of a Classifier that specifies the name, type, parameters, and constraints for invoking an associated Behavior. An Operation may invoke both the execution of method behaviors as well as other behavioral responses. Operation specializes TemplateableElement in order to support specification of template operations and bound operations. Operation specializes ParameterableElement to specify that an operation can be exposed as a formal template parameter, and provided as an actual parameter in a binding of a template."@en ;
    rdfs:subClassOf uml:BehavioralFeature ;
    rdfs:subClassOf uml:TemplateableElement ;
    rdfs:subClassOf uml:ParameterableElement ;
    umlmeta:oclConstraint "self.ownedParameter->select(direction = ParameterDirectionKind::return)->size() <= 1" ;
    umlmeta:oclConstraint "bodyCondition <> null implies isQuery" .

uml:OperationTemplateParameter a owl:Class ;
    rdfs:label "OperationTemplateParameter"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Classification" ;
    skos:definition "An OperationTemplateParameter exposes an Operation as a formal parameter for a template."@en ;
    rdfs:subClassOf uml:TemplateParameter ;
    umlmeta:oclConstraint "default->notEmpty() implies (default.oclIsKindOf(Operation) and (let defaultOp : Operation = default.oclAsType(Operation) in defaultOp.ownedParameter->size() = parameteredElement.ownedParameter->size() and Sequence{1.. defaultOp.ownedParameter->size()}->forAll( ix | let p1: Parameter = defaultOp.ownedParameter->at(ix), p2 : Parameter = parameteredElement.ownedParameter->at(ix) in p1.type = p2.type and p1.upper = p2.upper and p1.lower = p2.lower and p1.direction = p2.direction and p1.isOrdered = p2.isOrdered and p1.isUnique = p2.isUnique)))" .

uml:OutputPin a owl:Class ;
    rdfs:label "OutputPin"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Actions" ;
    skos:definition "An OutputPin is a Pin that holds output values produced by an Action."@en ;
    rdfs:subClassOf uml:Pin ;
    umlmeta:oclConstraint "incoming->notEmpty() implies action<>null and action.oclIsKindOf(StructuredActivityNode) and action.oclAsType(StructuredActivityNode).allOwnedNodes()->includesAll(incoming.source)" .

uml:PackageImport a owl:Class ;
    rdfs:label "PackageImport"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "CommonStructure" ;
    skos:definition "A PackageImport is a Relationship that imports all the non-private members of a Package into the Namespace owning the PackageImport, so that those Elements may be referred to by their unqualified names in the importingNamespace."@en ;
    rdfs:subClassOf uml:DirectedRelationship ;
    umlmeta:oclConstraint "visibility = VisibilityKind::public or visibility = VisibilityKind::private" .

uml:PackageMerge a owl:Class ;
    rdfs:label "PackageMerge"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Packages" ;
    skos:definition "A package merge defines how the contents of one package are extended by the contents of another package."@en ;
    rdfs:subClassOf uml:DirectedRelationship ;
    umlmeta:oclConstraint "mustBeOwned() implies owner->notEmpty()" ;
    umlmeta:oclConstraint "not allOwnedElements()->includes(self)" .

uml:Parameter a owl:Class ;
    rdfs:label "Parameter"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Classification" ;
    skos:definition "A Parameter is a specification of an argument used to pass information into or out of an invocation of a BehavioralFeature. Parameters can be treated as ConnectableElements within Collaborations."@en ;
    rdfs:subClassOf uml:ConnectableElement ;
    rdfs:subClassOf uml:MultiplicityElement ;
    umlmeta:oclConstraint "(effect = ParameterEffectKind::delete implies (direction = ParameterDirectionKind::_'in' or direction = ParameterDirectionKind::inout)) and (effect = ParameterEffectKind::create implies (direction = ParameterDirectionKind::out or direction = ParameterDirectionKind::inout or direction = ParameterDirectionKind::return))" ;
    umlmeta:oclConstraint "isException implies (direction <> ParameterDirectionKind::_'in' and direction <> ParameterDirectionKind::inout)" ;
    umlmeta:oclConstraint "end->notEmpty() implies collaboration->notEmpty()" ;
    umlmeta:oclConstraint "(isStream and behavior <> null) implies not behavior.isReentrant" ;
    umlmeta:oclConstraint "not (isException and isStream)" ;
    umlmeta:oclConstraint "(type.oclIsKindOf(DataType)) implies (effect = null)" .

uml:ParameterSet a owl:Class ;
    rdfs:label "ParameterSet"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Classification" ;
    skos:definition "A ParameterSet designates alternative sets of inputs or outputs that a Behavior may use."@en ;
    rdfs:subClassOf uml:NamedElement ;
    umlmeta:oclConstraint "parameter->forAll(p1, p2 | self.owner = p1.owner and self.owner = p2.owner and p1.direction = p2.direction)" ;
    umlmeta:oclConstraint "((parameter->exists(direction = ParameterDirectionKind::_'in')) implies behavioralFeature.ownedParameter->select(p | p.direction = ParameterDirectionKind::_'in' and p.parameterSet->isEmpty())->forAll(isStream)) and ((parameter->exists(direction = ParameterDirectionKind::out)) implies behavioralFeature.ownedParameter->select(p | p.direction = ParameterDirectionKind::out and p.parameterSet->isEmpty())->forAll(isStream))" ;
    umlmeta:oclConstraint "parameter->forAll(parameterSet->forAll(s1, s2 | s1->size() = s2->size() implies s1.parameter->exists(p | not s2.parameter->includes(p))))" .

uml:PartDecomposition a owl:Class ;
    rdfs:label "PartDecomposition"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Interactions" ;
    skos:definition "A PartDecomposition is a description of the internal Interactions of one Lifeline relative to an Interaction."@en ;
    rdfs:subClassOf uml:InteractionUse ;
    umlmeta:oclConstraint "(no specification serialized)" ;
    umlmeta:oclConstraint "(no specification serialized)" ;
    umlmeta:oclConstraint "(no specification serialized)" .

uml:Port a owl:Class ;
    rdfs:label "Port"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "StructuredClassifiers" ;
    skos:definition "A Port is a property of an EncapsulatedClassifier that specifies a distinct interaction point between that EncapsulatedClassifier and its environment or between the (behavior of the) EncapsulatedClassifier and its internal parts. Ports are connected to Properties of the EncapsulatedClassifier by Connectors through which requests can be made to invoke BehavioralFeatures. A Port may specify the services an EncapsulatedClassifier provides (offers) to its environment as well as the services that an EncapsulatedClassifier expects (requires) of its environment. A Port may have an associated ProtocolStateMachine."@en ;
    rdfs:subClassOf uml:Property ;
    umlmeta:oclConstraint "aggregation = AggregationKind::composite" ;
    umlmeta:oclConstraint "type.oclIsKindOf(Interface) implies defaultValue->isEmpty()" ;
    umlmeta:oclConstraint "owner = encapsulatedClassifier" .

uml:PrimitiveType a owl:Class ;
    rdfs:label "PrimitiveType"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "SimpleClassifiers" ;
    skos:definition "A PrimitiveType defines a predefined DataType, without any substructure. A PrimitiveType may have an algebra and operations defined outside of UML, for example, mathematically."@en ;
    rdfs:subClassOf uml:DataType ;
    umlmeta:oclConstraint "parents()->forAll(c | self.maySpecializeType(c))" ;
    umlmeta:oclConstraint "powertypeExtent->forAll( gs | gs.generalization->forAll( gen | not (gen.general = self) and not gen.general.allParents()->includes(self) and not (gen.specific = self) and not self.allParents()->includes(gen.specific) ))" ;
    umlmeta:oclConstraint "parents()->forAll(not isFinalSpecialization)" ;
    umlmeta:oclConstraint "not allParents()->includes(self)" .

uml:Profile a owl:Class ;
    rdfs:label "Profile"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Packages" ;
    skos:definition "A profile defines limited extensions to a reference metamodel with the purpose of adapting the metamodel to a specific platform or domain."@en ;
    rdfs:subClassOf uml:Package ;
    umlmeta:oclConstraint "metaclassReference.importedElement-> select(c | c.oclIsKindOf(Classifier) and (c.oclAsType(Classifier).allParents()->collect(namespace)->includes(self)))->isEmpty() and packagedElement-> select(oclIsKindOf(Classifier))->collect(oclAsType(Classifier).allParents())-> intersection(metaclassReference.importedElement->select(oclIsKindOf(Classifier))->collect(oclAsType(Classifier)))->isEmpty()" ;
    umlmeta:oclConstraint "metamodelReference.importedPackage.elementImport.importedElement.allOwningPackages()-> union(metaclassReference.importedElement.allOwningPackages() )->notEmpty()" .

uml:ProfileApplication a owl:Class ;
    rdfs:label "ProfileApplication"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Packages" ;
    skos:definition "A profile application is used to show which profiles have been applied to a package."@en ;
    rdfs:subClassOf uml:DirectedRelationship ;
    umlmeta:oclConstraint "mustBeOwned() implies owner->notEmpty()" ;
    umlmeta:oclConstraint "not allOwnedElements()->includes(self)" .

uml:ProtocolConformance a owl:Class ;
    rdfs:label "ProtocolConformance"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "StateMachines" ;
    skos:definition "A ProtocolStateMachine can be redefined into a more specific ProtocolStateMachine or into behavioral StateMachine. ProtocolConformance declares that the specific ProtocolStateMachine specifies a protocol that conforms to the general ProtocolStateMachine or that the specific behavioral StateMachine abides by the protocol of the general ProtocolStateMachine."@en ;
    rdfs:subClassOf uml:DirectedRelationship ;
    umlmeta:oclConstraint "mustBeOwned() implies owner->notEmpty()" ;
    umlmeta:oclConstraint "not allOwnedElements()->includes(self)" .

uml:StateMachine a owl:Class ;
    rdfs:label "StateMachine"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "StateMachines" ;
    skos:definition "StateMachines can be used to express event-driven behaviors of parts of a system. Behavior is modeled as a traversal of a graph of Vertices interconnected by one or more joined Transition arcs that are triggered by the dispatching of successive Event occurrences. During this traversal, the StateMachine may execute a sequence of Behaviors associated with various elements of the StateMachine."@en ;
    rdfs:subClassOf uml:Behavior ;
    umlmeta:oclConstraint "connectionPoint->forAll (kind = PseudostateKind::entryPoint or kind = PseudostateKind::exitPoint)" ;
    umlmeta:oclConstraint "_'context' <> null implies not _'context'.oclIsKindOf(Interface)" ;
    umlmeta:oclConstraint "specification <> null implies connectionPoint->isEmpty()" ;
    umlmeta:oclConstraint "specification <> null implies ( _'context' <> null and specification.featuringClassifier->exists(c | c = _'context'))" .

uml:ProtocolStateMachine a owl:Class ;
    rdfs:label "ProtocolStateMachine"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "StateMachines" ;
    skos:definition "A ProtocolStateMachine is always defined in the context of a Classifier. It specifies which BehavioralFeatures of the Classifier can be called in which State and under which conditions, thus specifying the allowed invocation sequences on the Classifier's BehavioralFeatures. A ProtocolStateMachine specifies the possible and permitted Transitions on the instances of its context Classifier, together with the BehavioralFeatures that carry the Transitions. In this manner, an instance lifecycle can be specified for a Classifier, by defining the order in which the BehavioralFeatures can be activated and the States through which an instance progresses during its existence."@en ;
    rdfs:subClassOf uml:StateMachine ;
    umlmeta:oclConstraint "_'context' <> null and specification = null" ;
    umlmeta:oclConstraint "region->forAll (r | r.subvertex->forAll (v | v.oclIsKindOf(Pseudostate) implies ((v.oclAsType(Pseudostate).kind <> PseudostateKind::deepHistory) and (v.oclAsType(Pseudostate).kind <> PseudostateKind::shallowHistory))))" ;
    umlmeta:oclConstraint "region->forAll(r | r.subvertex->forAll(v | v.oclIsKindOf(State) implies (v.oclAsType(State).entry->isEmpty() and v.oclAsType(State).exit->isEmpty() and v.oclAsType(State).doActivity->isEmpty())))" ;
    umlmeta:oclConstraint "region->forAll(r | r.transition->forAll(t | t.oclIsTypeOf(ProtocolTransition)))" .

uml:Transition a owl:Class ;
    rdfs:label "Transition"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "StateMachines" ;
    skos:definition "A Transition represents an arc between exactly one source Vertex and exactly one Target vertex (the source and targets may be the same Vertex). It may form part of a compound transition, which takes the StateMachine from one steady State configuration to another, representing the full response of the StateMachine to an occurrence of an Event that triggered it."@en ;
    rdfs:subClassOf uml:Namespace ;
    rdfs:subClassOf uml:RedefinableElement ;
    umlmeta:oclConstraint "(kind = TransitionKind::external) implies not (source.oclIsKindOf(Pseudostate) and source.oclAsType(Pseudostate).kind = PseudostateKind::entryPoint)" ;
    umlmeta:oclConstraint "(target.oclIsKindOf(Pseudostate) and target.oclAsType(Pseudostate).kind = PseudostateKind::join) implies (guard = null and trigger->isEmpty())" ;
    umlmeta:oclConstraint "(kind = TransitionKind::internal) implies (source.oclIsKindOf (State) and source = target)" ;
    umlmeta:oclConstraint "source.oclIsKindOf(Pseudostate) and (source.oclAsType(Pseudostate).kind <> PseudostateKind::initial) implies trigger->isEmpty()" ;
    umlmeta:oclConstraint "(target.oclIsKindOf(Pseudostate) and target.oclAsType(Pseudostate).kind = PseudostateKind::join) implies (source.oclIsKindOf(State))" ;
    umlmeta:oclConstraint "(source.oclIsKindOf(Pseudostate) and source.oclAsType(Pseudostate).kind = PseudostateKind::fork) implies (target.oclIsKindOf(State))" ;
    umlmeta:oclConstraint "(kind = TransitionKind::local) implies ((source.oclIsKindOf (State) and source.oclAsType(State).isComposite) or (source.oclIsKindOf (Pseudostate) and source.oclAsType(Pseudostate).kind = PseudostateKind::entryPoint))" ;
    umlmeta:oclConstraint "(source.oclIsKindOf(Pseudostate) and container.stateMachine->notEmpty()) implies trigger->isEmpty()" ;
    umlmeta:oclConstraint "(source.oclIsKindOf(Pseudostate) and source.oclAsType(Pseudostate).kind = PseudostateKind::fork) implies (guard = null and trigger->isEmpty())" ;
    umlmeta:oclConstraint "let stateMachine = self.containingStateMachine() in source.containingStateMachine() = stateMachine and target.containingStateMachine() = stateMachine" .

uml:ProtocolTransition a owl:Class ;
    rdfs:label "ProtocolTransition"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "StateMachines" ;
    skos:definition "A ProtocolTransition specifies a legal Transition for an Operation. Transitions of ProtocolStateMachines have the following information: a pre-condition (guard), a Trigger, and a post-condition. Every ProtocolTransition is associated with at most one BehavioralFeature belonging to the context Classifier of the ProtocolStateMachine."@en ;
    rdfs:subClassOf uml:Transition ;
    umlmeta:oclConstraint "if (referred()->notEmpty() and containingStateMachine()._'context'->notEmpty()) then containingStateMachine()._'context'.oclAsType(BehavioredClassifier).allFeatures()->includesAll(referred()) else true endif" ;
    umlmeta:oclConstraint "effect = null" ;
    umlmeta:oclConstraint "container.belongsToPSM()" .

uml:Pseudostate a owl:Class ;
    rdfs:label "Pseudostate"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "StateMachines" ;
    skos:definition "A Pseudostate is an abstraction that encompasses different types of transient Vertices in the StateMachine graph. A StateMachine instance never comes to rest in a Pseudostate, instead, it will exit and enter the Pseudostate within a single run-to-completion step."@en ;
    rdfs:subClassOf uml:Vertex ;
    umlmeta:oclConstraint "(kind = PseudostateKind::fork) implies -- for any pair of outgoing transitions there exists an orthogonal state which contains the targets of these transitions -- such that these targets belong to different regions of that orthogonal state outgoing->forAll(t1:Transition, t2:Transition | let contState:State = containingStateMachine().LCAState(t1.target, t2.target) in ((contState <> null) and (contState.region ->exists(r1:Region, r2: Region | (r1 <> r2) and t1.target.isContainedInRegion(r1) and t2.target.isContainedInRegion(r2)))))" ;
    umlmeta:oclConstraint "(kind = PseudostateKind::choice) implies (incoming->size() >= 1 and outgoing->size() >= 1)" ;
    umlmeta:oclConstraint "(kind = PseudostateKind::initial) implies (outgoing.guard = null and outgoing.trigger->isEmpty())" ;
    umlmeta:oclConstraint "(kind = PseudostateKind::join) implies (outgoing->size() = 1 and incoming->size() >= 2)" ;
    umlmeta:oclConstraint "(kind = PseudostateKind::junction) implies (incoming->size() >= 1 and outgoing->size() >= 1)" ;
    umlmeta:oclConstraint "((kind = PseudostateKind::deepHistory) or (kind = PseudostateKind::shallowHistory)) implies (outgoing->size() <= 1)" ;
    umlmeta:oclConstraint "(kind = PseudostateKind::initial) implies (outgoing->size() <= 1)" ;
    umlmeta:oclConstraint "(kind = PseudostateKind::fork) implies (incoming->size() = 1 and outgoing->size() >= 2)" ;
    umlmeta:oclConstraint "(kind = PseudostateKind::join) implies -- for any pair of incoming transitions there exists an orthogonal state which contains the source vetices of these transitions -- such that these source vertices belong to different regions of that orthogonal state incoming->forAll(t1:Transition, t2:Transition | let contState:State = containingStateMachine().LCAState(t1.source, t2.source) in ((contState <> null) and (contState.region ->exists(r1:Region, r2: Region | (r1 <> r2) and t1.source.isContainedInRegion(r1) and t2.source.isContainedInRegion(r2)))))" .

uml:QualifierValue a owl:Class ;
    rdfs:label "QualifierValue"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Actions" ;
    skos:definition "A QualifierValue is an Element that is used as part of LinkEndData to provide the value for a single qualifier of the end given by the LinkEndData."@en ;
    rdfs:subClassOf uml:Element ;
    umlmeta:oclConstraint "value.is(1,1)" ;
    umlmeta:oclConstraint "value.type.conformsTo(qualifier.type)" ;
    umlmeta:oclConstraint "linkEndData.end.qualifier->includes(qualifier)" .

uml:RaiseExceptionAction a owl:Class ;
    rdfs:label "RaiseExceptionAction"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Actions" ;
    skos:definition "A RaiseExceptionAction is an Action that causes an exception to occur. The input value becomes the exception object."@en ;
    rdfs:subClassOf uml:Action ;
    umlmeta:oclConstraint "redefinedElement->forAll(re | re.isConsistentWith(self))" ;
    umlmeta:oclConstraint "redefinedElement->forAll(re | not re.isLeaf)" ;
    umlmeta:oclConstraint "redefinedElement->forAll(re | self.isRedefinitionContextValid(re))" .

uml:ReadExtentAction a owl:Class ;
    rdfs:label "ReadExtentAction"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Actions" ;
    skos:definition "A ReadExtentAction is an Action that retrieves the current instances of a Classifier."@en ;
    rdfs:subClassOf uml:Action ;
    umlmeta:oclConstraint "result.type = classifier" ;
    umlmeta:oclConstraint "result.is(0,*)" .

uml:ReadIsClassifiedObjectAction a owl:Class ;
    rdfs:label "ReadIsClassifiedObjectAction"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Actions" ;
    skos:definition "A ReadIsClassifiedObjectAction is an Action that determines whether an object is classified by a given Classifier."@en ;
    rdfs:subClassOf uml:Action ;
    umlmeta:oclConstraint "object.type = null" ;
    umlmeta:oclConstraint "result.is(1,1)" ;
    umlmeta:oclConstraint "result.type = Boolean" ;
    umlmeta:oclConstraint "object.is(1,1)" .

uml:ReadLinkAction a owl:Class ;
    rdfs:label "ReadLinkAction"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Actions" ;
    skos:definition "A ReadLinkAction is a LinkAction that navigates across an Association to retrieve the objects on one end."@en ;
    rdfs:subClassOf uml:LinkAction ;
    umlmeta:oclConstraint "self.openEnd()->forAll(type=result.type and isOrdered=result.isOrdered)" ;
    umlmeta:oclConstraint "self.openEnd()->first().compatibleWith(result)" ;
    umlmeta:oclConstraint "let openEnd : Property = self.openEnd()->first() in openEnd.visibility = VisibilityKind::public or endData->exists(oed | oed.end<>openEnd and (_'context' = oed.end.type or (openEnd.visibility = VisibilityKind::protected and _'context'.conformsTo(oed.end.type.oclAsType(Classifier)))))" ;
    umlmeta:oclConstraint "self.openEnd()->size() = 1" ;
    umlmeta:oclConstraint "self.openEnd()->first().isNavigable()" .

uml:ReadLinkObjectEndAction a owl:Class ;
    rdfs:label "ReadLinkObjectEndAction"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Actions" ;
    skos:definition "A ReadLinkObjectEndAction is an Action that retrieves an end object from a link object."@en ;
    rdfs:subClassOf uml:Action ;
    umlmeta:oclConstraint "end.association <> null" ;
    umlmeta:oclConstraint "object.is(1,1)" ;
    umlmeta:oclConstraint "end.association.memberEnd->forAll(e | not e.isStatic)" ;
    umlmeta:oclConstraint "result.type = end.type" ;
    umlmeta:oclConstraint "result.is(1,1)" ;
    umlmeta:oclConstraint "object.type = end.association" ;
    umlmeta:oclConstraint "end.association.oclIsKindOf(AssociationClass)" .

uml:ReadLinkObjectEndQualifierAction a owl:Class ;
    rdfs:label "ReadLinkObjectEndQualifierAction"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Actions" ;
    skos:definition "A ReadLinkObjectEndQualifierAction is an Action that retrieves a qualifier end value from a link object."@en ;
    rdfs:subClassOf uml:Action ;
    umlmeta:oclConstraint "object.is(1,1)" ;
    umlmeta:oclConstraint "object.type = qualifier.associationEnd.association" ;
    umlmeta:oclConstraint "qualifier.is(1,1)" ;
    umlmeta:oclConstraint "qualifier.associationEnd.association.memberEnd->forAll(e | not e.isStatic)" ;
    umlmeta:oclConstraint "result.is(1,1)" ;
    umlmeta:oclConstraint "result.type = qualifier.type" ;
    umlmeta:oclConstraint "qualifier.associationEnd.association.oclIsKindOf(AssociationClass)" ;
    umlmeta:oclConstraint "qualifier.associationEnd <> null" .

uml:ReadSelfAction a owl:Class ;
    rdfs:label "ReadSelfAction"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Actions" ;
    skos:definition "A ReadSelfAction is an Action that retrieves the context object of the Behavior execution within which the ReadSelfAction execution is taking place."@en ;
    rdfs:subClassOf uml:Action ;
    umlmeta:oclConstraint "_'context' <> null" ;
    umlmeta:oclConstraint "result.is(1,1)" ;
    umlmeta:oclConstraint "let behavior: Behavior = self.containingBehavior() in behavior.specification<>null implies not behavior.specification.isStatic" ;
    umlmeta:oclConstraint "result.type = _'context'" .

uml:ReadStructuralFeatureAction a owl:Class ;
    rdfs:label "ReadStructuralFeatureAction"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Actions" ;
    skos:definition "A ReadStructuralFeatureAction is a StructuralFeatureAction that retrieves the values of a StructuralFeature."@en ;
    rdfs:subClassOf uml:StructuralFeatureAction ;
    umlmeta:oclConstraint "structuralFeature.compatibleWith(result)" ;
    umlmeta:oclConstraint "result.type =structuralFeature.type and result.isOrdered = structuralFeature.isOrdered" .

uml:ReadVariableAction a owl:Class ;
    rdfs:label "ReadVariableAction"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Actions" ;
    skos:definition "A ReadVariableAction is a VariableAction that retrieves the values of a Variable."@en ;
    rdfs:subClassOf uml:VariableAction ;
    umlmeta:oclConstraint "result.type =variable.type and result.isOrdered = variable.isOrdered" ;
    umlmeta:oclConstraint "variable.compatibleWith(result)" .

uml:Reception a owl:Class ;
    rdfs:label "Reception"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "SimpleClassifiers" ;
    skos:definition "A Reception is a declaration stating that a Classifier is prepared to react to the receipt of a Signal."@en ;
    rdfs:subClassOf uml:BehavioralFeature ;
    umlmeta:oclConstraint "name = signal.name" ;
    umlmeta:oclConstraint "signal.ownedAttribute->size() = ownedParameter->size() and Sequence{1..signal.ownedAttribute->size()}->forAll( i | ownedParameter->at(i).direction = ParameterDirectionKind::_'in' and ownedParameter->at(i).name = signal.ownedAttribute->at(i).name and ownedParameter->at(i).type = signal.ownedAttribute->at(i).type and ownedParameter->at(i).lowerBound() = signal.ownedAttribute->at(i).lowerBound() and ownedParameter->at(i).upperBound() = signal.ownedAttribute->at(i).upperBound() )" .

uml:ReclassifyObjectAction a owl:Class ;
    rdfs:label "ReclassifyObjectAction"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Actions" ;
    skos:definition "A ReclassifyObjectAction is an Action that changes the Classifiers that classify an object."@en ;
    rdfs:subClassOf uml:Action ;
    umlmeta:oclConstraint "object.type = null" ;
    umlmeta:oclConstraint "not newClassifier->exists(isAbstract)" ;
    umlmeta:oclConstraint "object.is(1,1)" .

uml:TemplateSignature a owl:Class ;
    rdfs:label "TemplateSignature"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "CommonStructure" ;
    skos:definition "A Template Signature bundles the set of formal TemplateParameters for a template."@en ;
    rdfs:subClassOf uml:Element ;
    umlmeta:oclConstraint "template.ownedElement->includesAll(parameter.parameteredElement->asSet() - parameter.ownedParameteredElement->asSet())" ;
    umlmeta:oclConstraint "parameter->forAll( p1, p2 | (p1 <> p2 and p1.parameteredElement.oclIsKindOf(NamedElement) and p2.parameteredElement.oclIsKindOf(NamedElement) ) implies p1.parameteredElement.oclAsType(NamedElement).name <> p2.parameteredElement.oclAsType(NamedElement).name)" .

uml:RedefinableTemplateSignature a owl:Class ;
    rdfs:label "RedefinableTemplateSignature"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Classification" ;
    skos:definition "A RedefinableTemplateSignature supports the addition of formal template parameters in a specialization of a template classifier."@en ;
    rdfs:subClassOf uml:RedefinableElement ;
    rdfs:subClassOf uml:TemplateSignature ;
    umlmeta:oclConstraint "classifier.allParents()->forAll(c | c.ownedTemplateSignature->notEmpty() implies self->closure(extendedSignature)->includes(c.ownedTemplateSignature))" .

uml:ReduceAction a owl:Class ;
    rdfs:label "ReduceAction"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Actions" ;
    skos:definition "A ReduceAction is an Action that reduces a collection to a single value by repeatedly combining the elements of the collection using a reducer Behavior."@en ;
    rdfs:subClassOf uml:Action ;
    umlmeta:oclConstraint "let inputs: OrderedSet(Parameter) = reducer.inputParameters() in let outputs: OrderedSet(Parameter) = reducer.outputParameters() in inputs->size()=2 and outputs->size()=1 and inputs.type->forAll(t | outputs.type->forAll(conformsTo(t)) and -- Note that the following only checks the case when the collection is via multiple tokens. collection.upperBound()>1 implies collection.type.conformsTo(t))" ;
    umlmeta:oclConstraint "(no specification serialized)" ;
    umlmeta:oclConstraint "reducer.outputParameters().type->forAll(conformsTo(result.type))" .

uml:Region a owl:Class ;
    rdfs:label "Region"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "StateMachines" ;
    skos:definition "A Region is a top-level part of a StateMachine or a composite State, that serves as a container for the Vertices and Transitions of the StateMachine. A StateMachine or composite State may contain multiple Regions representing behaviors that may occur in parallel."@en ;
    rdfs:subClassOf uml:Namespace ;
    rdfs:subClassOf uml:RedefinableElement ;
    umlmeta:oclConstraint "self.subvertex->select (oclIsKindOf(Pseudostate))->collect(oclAsType(Pseudostate))-> select(kind = PseudostateKind::deepHistory)->size() <= 1" ;
    umlmeta:oclConstraint "subvertex->select(oclIsKindOf(Pseudostate))->collect(oclAsType(Pseudostate))-> select(kind = PseudostateKind::shallowHistory)->size() <= 1" ;
    umlmeta:oclConstraint "(stateMachine <> null implies state = null) and (state <> null implies stateMachine = null)" ;
    umlmeta:oclConstraint "self.subvertex->select (oclIsKindOf(Pseudostate))->collect(oclAsType(Pseudostate))-> select(kind = PseudostateKind::initial)->size() <= 1" .

uml:RemoveStructuralFeatureValueAction a owl:Class ;
    rdfs:label "RemoveStructuralFeatureValueAction"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Actions" ;
    skos:definition "A RemoveStructuralFeatureValueAction is a WriteStructuralFeatureAction that removes values from a StructuralFeature."@en ;
    rdfs:subClassOf uml:WriteStructuralFeatureAction ;
    umlmeta:oclConstraint "if structuralFeature.isOrdered and not structuralFeature.isUnique and not isRemoveDuplicates then value = null and removeAt <> null and removeAt.type = UnlimitedNatural and removeAt.is(1,1) else removeAt = null and value <> null endif" .

uml:RemoveVariableValueAction a owl:Class ;
    rdfs:label "RemoveVariableValueAction"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Actions" ;
    skos:definition "A RemoveVariableValueAction is a WriteVariableAction that removes values from a Variables."@en ;
    rdfs:subClassOf uml:WriteVariableAction ;
    umlmeta:oclConstraint "if variable.isOrdered and not variable.isUnique and not isRemoveDuplicates then value = null and removeAt <> null and removeAt.type = UnlimitedNatural and removeAt.is(1,1) else removeAt = null and value <> null endif" .

uml:ReplyAction a owl:Class ;
    rdfs:label "ReplyAction"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Actions" ;
    skos:definition "A ReplyAction is an Action that accepts a set of reply values and a value containing return information produced by a previous AcceptCallAction. The ReplyAction returns the values to the caller of the previous call, completing execution of the call."@en ;
    rdfs:subClassOf uml:Action ;
    umlmeta:oclConstraint "let parameter:OrderedSet(Parameter) = replyToCall.event.oclAsType(CallEvent).operation.outputParameters() in replyValue->size()=parameter->size() and Sequence{1..replyValue->size()}->forAll(i | replyValue->at(i).type.conformsTo(parameter->at(i).type) and replyValue->at(i).isOrdered=parameter->at(i).isOrdered and replyValue->at(i).compatibleWith(parameter->at(i)))" ;
    umlmeta:oclConstraint "replyToCall.event.oclIsKindOf(CallEvent)" .

uml:SendObjectAction a owl:Class ;
    rdfs:label "SendObjectAction"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Actions" ;
    skos:definition "A SendObjectAction is an InvocationAction that transmits an input object to the target object, which is handled as a request message by the target object. The requestor continues execution immediately after the object is sent out and cannot receive reply values."@en ;
    rdfs:subClassOf uml:InvocationAction ;
    umlmeta:oclConstraint "onPort<>null implies target.type.oclAsType(Classifier).allFeatures()->includes(onPort)" .

uml:SendSignalAction a owl:Class ;
    rdfs:label "SendSignalAction"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Actions" ;
    skos:definition "A SendSignalAction is an InvocationAction that creates a Signal instance and transmits it to the target object. Values from the argument InputPins are used to provide values for the attributes of the Signal. The requestor continues execution immediately after the Signal instance is sent out and cannot receive reply values."@en ;
    rdfs:subClassOf uml:InvocationAction ;
    umlmeta:oclConstraint "let attribute: OrderedSet(Property) = signal.allAttributes() in Sequence{1..argument->size()}->forAll(i | argument->at(i).type.conformsTo(attribute->at(i).type) and argument->at(i).isOrdered = attribute->at(i).isOrdered and argument->at(i).compatibleWith(attribute->at(i)))" ;
    umlmeta:oclConstraint "argument->size()=signal.allAttributes()->size()" ;
    umlmeta:oclConstraint "not onPort->isEmpty() implies target.type.oclAsType(Classifier).allFeatures()->includes(onPort)" .

uml:SequenceNode a owl:Class ;
    rdfs:label "SequenceNode"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Actions" ;
    skos:definition "A SequenceNode is a StructuredActivityNode that executes a sequence of ExecutableNodes in order."@en ;
    rdfs:subClassOf uml:StructuredActivityNode ;
    umlmeta:oclConstraint "output.outgoing.target->excludesAll(allOwnedNodes()-input)" ;
    umlmeta:oclConstraint "edge=self.sourceNodes().outgoing->intersection(self.allOwnedNodes().incoming)-> union(self.targetNodes().incoming->intersection(self.allOwnedNodes().outgoing))->asSet()" ;
    umlmeta:oclConstraint "input.incoming.source->excludesAll(allOwnedNodes()-output)" .

uml:Signal a owl:Class ;
    rdfs:label "Signal"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "SimpleClassifiers" ;
    skos:definition "A Signal is a specification of a kind of communication between objects in which a reaction is asynchronously triggered in the receiver without a reply."@en ;
    rdfs:subClassOf uml:Classifier ;
    umlmeta:oclConstraint "parents()->forAll(c | self.maySpecializeType(c))" ;
    umlmeta:oclConstraint "powertypeExtent->forAll( gs | gs.generalization->forAll( gen | not (gen.general = self) and not gen.general.allParents()->includes(self) and not (gen.specific = self) and not self.allParents()->includes(gen.specific) ))" ;
    umlmeta:oclConstraint "parents()->forAll(not isFinalSpecialization)" ;
    umlmeta:oclConstraint "not allParents()->includes(self)" .

uml:SignalEvent a owl:Class ;
    rdfs:label "SignalEvent"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "CommonBehavior" ;
    skos:definition "A SignalEvent represents the receipt of an asynchronous Signal instance."@en ;
    rdfs:subClassOf uml:MessageEvent ;
    umlmeta:oclConstraint "visibility = null implies namespace = null" .

uml:Slot a owl:Class ;
    rdfs:label "Slot"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Classification" ;
    skos:definition "A Slot designates that an entity modeled by an InstanceSpecification has a value or values for a specific StructuralFeature."@en ;
    rdfs:subClassOf uml:Element ;
    umlmeta:oclConstraint "mustBeOwned() implies owner->notEmpty()" ;
    umlmeta:oclConstraint "not allOwnedElements()->includes(self)" .

uml:StartClassifierBehaviorAction a owl:Class ;
    rdfs:label "StartClassifierBehaviorAction"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Actions" ;
    skos:definition "A StartClassifierBehaviorAction is an Action that starts the classifierBehavior of the input object."@en ;
    rdfs:subClassOf uml:Action ;
    umlmeta:oclConstraint "object.is(1,1)" ;
    umlmeta:oclConstraint "object.type->notEmpty() implies (object.type.oclIsKindOf(BehavioredClassifier) and object.type.oclAsType(BehavioredClassifier).classifierBehavior<>null)" .

uml:StartObjectBehaviorAction a owl:Class ;
    rdfs:label "StartObjectBehaviorAction"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Actions" ;
    skos:definition "A StartObjectBehaviorAction is an InvocationAction that starts the execution either of a directly instantiated Behavior or of the classifierBehavior of an object. Argument values may be supplied for the input Parameters of the Behavior. If the Behavior is invoked synchronously, then output values may be obtained for output Parameters."@en ;
    rdfs:subClassOf uml:CallAction ;
    umlmeta:oclConstraint "object.is(1,1)" ;
    umlmeta:oclConstraint "self.behavior()<>null" ;
    umlmeta:oclConstraint "onPort->isEmpty()" .

uml:StateInvariant a owl:Class ;
    rdfs:label "StateInvariant"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Interactions" ;
    skos:definition "A StateInvariant is a runtime constraint on the participants of the Interaction. It may be used to specify a variety of different kinds of Constraints, such as values of Attributes or Variables, internal or external States, and so on. A StateInvariant is an InteractionFragment and it is placed on a Lifeline."@en ;
    rdfs:subClassOf uml:InteractionFragment ;
    umlmeta:oclConstraint "(namespace = null and owner <> null) implies visibility = null" ;
    umlmeta:oclConstraint "(name <> null and allNamespaces()->select(ns | ns.name = null)->isEmpty()) implies qualifiedName = allNamespaces()->iterate( ns : Namespace; agg: String = name | ns.name.concat(self.separator()).concat(agg))" ;
    umlmeta:oclConstraint "name=null or allNamespaces()->select( ns | ns.name=null )->notEmpty() implies qualifiedName = null" .

uml:Stereotype a owl:Class ;
    rdfs:label "Stereotype"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Packages" ;
    skos:definition "A stereotype defines how an existing metaclass may be extended, and enables the use of platform or domain specific terminology or notation in place of, or in addition to, the ones used for the extended metaclass."@en ;
    rdfs:subClassOf uml:Class ;
    umlmeta:oclConstraint "ownedAttribute.association->forAll(memberEnd->size()=2)" ;
    umlmeta:oclConstraint "allParents()->forAll(oclIsKindOf(Stereotype)) and Classifier.allInstances()->forAll(c | c.allParents()->exists(oclIsKindOf(Stereotype)) implies c.oclIsKindOf(Stereotype))" ;
    umlmeta:oclConstraint "(no specification serialized)" ;
    umlmeta:oclConstraint "ownedAttribute ->select(association->notEmpty() and not association.oclIsKindOf(Extension) and not type.oclIsKindOf(Stereotype)) ->forAll(opposite.owner = association)" ;
    umlmeta:oclConstraint "(no specification serialized)" ;
    umlmeta:oclConstraint "(no specification serialized)" ;
    umlmeta:oclConstraint "(no specification serialized)" .

uml:StringExpression a owl:Class ;
    rdfs:label "StringExpression"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Values" ;
    skos:definition "A StringExpression is an Expression that specifies a String value that is derived by concatenating a sequence of operands with String values or a sequence of subExpressions, some of which might be template parameters."@en ;
    rdfs:subClassOf uml:Expression ;
    rdfs:subClassOf uml:TemplateableElement ;
    umlmeta:oclConstraint "operand->forAll (oclIsKindOf (LiteralString))" ;
    umlmeta:oclConstraint "if subExpression->notEmpty() then operand->isEmpty() else operand->notEmpty() endif" .

uml:Substitution a owl:Class ;
    rdfs:label "Substitution"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Classification" ;
    skos:definition "A substitution is a relationship between two classifiers signifying that the substituting classifier complies with the contract specified by the contract classifier. This implies that instances of the substituting classifier are runtime substitutable where instances of the contract classifier are expected."@en ;
    rdfs:subClassOf uml:Realization ;
    umlmeta:oclConstraint "visibility = null implies namespace = null" .

uml:TemplateBinding a owl:Class ;
    rdfs:label "TemplateBinding"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "CommonStructure" ;
    skos:definition "A TemplateBinding is a DirectedRelationship between a TemplateableElement and a template. A TemplateBinding specifies the TemplateParameterSubstitutions of actual parameters for the formal parameters of the template."@en ;
    rdfs:subClassOf uml:DirectedRelationship ;
    umlmeta:oclConstraint "parameterSubstitution->forAll(b | signature.parameter->includes(b.formal))" ;
    umlmeta:oclConstraint "signature.parameter->forAll(p | parameterSubstitution->select(b | b.formal = p)->size() <= 1)" .

uml:TemplateParameterSubstitution a owl:Class ;
    rdfs:label "TemplateParameterSubstitution"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "CommonStructure" ;
    skos:definition "A TemplateParameterSubstitution relates the actual parameter to a formal TemplateParameter as part of a template binding."@en ;
    rdfs:subClassOf uml:Element ;
    umlmeta:oclConstraint "actual->forAll(a | a.isCompatibleWith(formal.parameteredElement))" .

uml:TestIdentityAction a owl:Class ;
    rdfs:label "TestIdentityAction"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Actions" ;
    skos:definition "A TestIdentityAction is an Action that tests if two values are identical objects."@en ;
    rdfs:subClassOf uml:Action ;
    umlmeta:oclConstraint "first.is(1,1) and second.is(1,1)" ;
    umlmeta:oclConstraint "first.type= null and second.type = null" ;
    umlmeta:oclConstraint "result.type=Boolean" .

uml:TimeConstraint a owl:Class ;
    rdfs:label "TimeConstraint"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Values" ;
    skos:definition "A TimeConstraint is a Constraint that refers to a TimeInterval."@en ;
    rdfs:subClassOf uml:IntervalConstraint ;
    umlmeta:oclConstraint "constrainedElement->size() = 1" .

uml:TimeEvent a owl:Class ;
    rdfs:label "TimeEvent"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "CommonBehavior" ;
    skos:definition "A TimeEvent is an Event that occurs at a specific point in time."@en ;
    rdfs:subClassOf uml:Event ;
    umlmeta:oclConstraint "when.integerValue() >= 0" .

uml:TimeExpression a owl:Class ;
    rdfs:label "TimeExpression"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Values" ;
    skos:definition "A TimeExpression is a ValueSpecification that represents a time value."@en ;
    rdfs:subClassOf uml:ValueSpecification ;
    umlmeta:oclConstraint "expr = null implies (observation->size() = 1 and observation->forAll(oclIsKindOf(TimeObservation)))" .

uml:TimeInterval a owl:Class ;
    rdfs:label "TimeInterval"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Values" ;
    skos:definition "A TimeInterval defines the range between two TimeExpressions."@en ;
    rdfs:subClassOf uml:Interval ;
    umlmeta:oclConstraint "visibility = null implies namespace = null" .

uml:TimeObservation a owl:Class ;
    rdfs:label "TimeObservation"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Values" ;
    skos:definition "A TimeObservation is a reference to a time instant during an execution. It points out the NamedElement in the model to observe and whether the observation is when this NamedElement is entered or when it is exited."@en ;
    rdfs:subClassOf uml:Observation ;
    umlmeta:oclConstraint "visibility = null implies namespace = null" .

uml:Trigger a owl:Class ;
    rdfs:label "Trigger"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "CommonBehavior" ;
    skos:definition "A Trigger specifies a specific point at which an Event occurrence may trigger an effect in a Behavior. A Trigger may be qualified by the Port on which the Event occurred."@en ;
    rdfs:subClassOf uml:NamedElement ;
    umlmeta:oclConstraint "port->notEmpty() implies event.oclIsKindOf(MessageEvent)" .

uml:UnmarshallAction a owl:Class ;
    rdfs:label "UnmarshallAction"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Actions" ;
    skos:definition "An UnmarshallAction is an Action that retrieves the values of the StructuralFeatures of an object and places them on OutputPins."@en ;
    rdfs:subClassOf uml:Action ;
    umlmeta:oclConstraint "unmarshallType.allAttributes()->size() >= 1" ;
    umlmeta:oclConstraint "unmarshallType.allAttributes()->size() = result->size()" ;
    umlmeta:oclConstraint "let attribute:OrderedSet(Property) = unmarshallType.allAttributes() in Sequence{1..result->size()}->forAll(i | attribute->at(i).type.conformsTo(result->at(i).type) and attribute->at(i).isOrdered=result->at(i).isOrdered and attribute->at(i).compatibleWith(result->at(i)))" ;
    umlmeta:oclConstraint "object.is(1,1)" ;
    umlmeta:oclConstraint "object.type.conformsTo(unmarshallType)" .

uml:Usage a owl:Class ;
    rdfs:label "Usage"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "CommonStructure" ;
    skos:definition "A Usage is a Dependency in which the client Element requires the supplier Element (or set of Elements) for its full implementation or operation."@en ;
    rdfs:subClassOf uml:Dependency ;
    umlmeta:oclConstraint "visibility = null implies namespace = null" .

uml:UseCase a owl:Class ;
    rdfs:label "UseCase"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "UseCases" ;
    skos:definition "A UseCase specifies a set of actions performed by its subjects, which yields an observable result that is of value for one or more Actors or other stakeholders of each subject."@en ;
    rdfs:subClassOf uml:BehavioredClassifier ;
    umlmeta:oclConstraint "Association.allInstances()->forAll(a | a.memberEnd.type->includes(self) implies a.memberEnd->size() = 2)" ;
