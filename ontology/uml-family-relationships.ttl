    skos:definition "MessageEnd is an abstract specialization of NamedElement that represents what can occur at the end of a Message."@en ;
    rdfs:subClassOf uml:NamedElement ;
    umlmeta:oclConstraint "(namespace = null and owner <> null) implies visibility = null" ;
    umlmeta:oclConstraint "(name <> null and allNamespaces()->select(ns | ns.name = null)->isEmpty()) implies qualifiedName = allNamespaces()->iterate( ns : Namespace; agg: String = name | ns.name.concat(self.separator()).concat(agg))" ;
    umlmeta:oclConstraint "name=null or allNamespaces()->select( ns | ns.name=null )->notEmpty() implies qualifiedName = null" .

uml:OccurrenceSpecification a owl:Class ;
    rdfs:label "OccurrenceSpecification"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Interactions" ;
    skos:definition "An OccurrenceSpecification is the basic semantic unit of Interactions. The sequences of occurrences specified by them are the meanings of Interactions."@en ;
    rdfs:subClassOf uml:InteractionFragment ;
    umlmeta:oclConstraint "(namespace = null and owner <> null) implies visibility = null" ;
    umlmeta:oclConstraint "(name <> null and allNamespaces()->select(ns | ns.name = null)->isEmpty()) implies qualifiedName = allNamespaces()->iterate( ns : Namespace; agg: String = name | ns.name.concat(self.separator()).concat(agg))" ;
    umlmeta:oclConstraint "name=null or allNamespaces()->select( ns | ns.name=null )->notEmpty() implies qualifiedName = null" .

uml:MessageOccurrenceSpecification a owl:Class ;
    rdfs:label "MessageOccurrenceSpecification"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Interactions" ;
    skos:definition "A MessageOccurrenceSpecification specifies the occurrence of Message events, such as sending and receiving of Signals or invoking or receiving of Operation calls. A MessageOccurrenceSpecification is a kind of MessageEnd. Messages are generated either by synchronous Operation calls or asynchronous Signal sends. They are received by the execution of corresponding AcceptEventActions."@en ;
    rdfs:subClassOf uml:OccurrenceSpecification ;
    rdfs:subClassOf uml:MessageEnd ;
    umlmeta:oclConstraint "(namespace = null and owner <> null) implies visibility = null" ;
    umlmeta:oclConstraint "(name <> null and allNamespaces()->select(ns | ns.name = null)->isEmpty()) implies qualifiedName = allNamespaces()->iterate( ns : Namespace; agg: String = name | ns.name.concat(self.separator()).concat(agg))" ;
    umlmeta:oclConstraint "name=null or allNamespaces()->select( ns | ns.name=null )->notEmpty() implies qualifiedName = null" .

uml:DestructionOccurrenceSpecification a owl:Class ;
    rdfs:label "DestructionOccurrenceSpecification"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Interactions" ;
    skos:definition "A DestructionOccurenceSpecification models the destruction of an object."@en ;
    rdfs:subClassOf uml:MessageOccurrenceSpecification ;
    umlmeta:oclConstraint "let o : InteractionOperand = enclosingOperand in o->notEmpty() and let peerEvents : OrderedSet(OccurrenceSpecification) = covered.events->select(enclosingOperand = o) in peerEvents->last() = self" .

uml:Node a owl:Class ;
    rdfs:label "Node"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Deployments" ;
    skos:definition "A Node is computational resource upon which artifacts may be deployed for execution. Nodes can be interconnected through communication paths to define network structures."@en ;
    rdfs:subClassOf uml:Class ;
    rdfs:subClassOf uml:DeploymentTarget ;
