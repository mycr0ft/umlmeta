    umlmeta:oclConstraint "ownedParameter->forAll(p | p.type <> null and p.type.oclIsTypeOf(DataType) and hasAllDataTypeAttributes(p.type.oclAsType(DataType)))" .

uml:Gate a owl:Class ;
    rdfs:label "Gate"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Interactions" ;
    skos:definition "A Gate is a MessageEnd which serves as a connection point for relating a Message which has a MessageEnd (sendEvent / receiveEvent) outside an InteractionFragment with another Message which has a MessageEnd (receiveEvent / sendEvent) inside that InteractionFragment."@en ;
    rdfs:subClassOf uml:MessageEnd ;
    umlmeta:oclConstraint "interactionUse->notEmpty() implies interactionUse.refersTo.formalGate->select(matches(self))->size()=1" ;
    umlmeta:oclConstraint "isInsideCF() implies combinedFragment.cfragmentGate->select(isOutsideCF() and matches(self))->size()=1" ;
    umlmeta:oclConstraint "isOutsideCF() implies if self.combinedFragment.interactionOperator->asOrderedSet()->first() = InteractionOperatorKind::alt then self.combinedFragment.operand->forAll(op : InteractionOperand | self.combinedFragment.cfragmentGate->select(isInsideCF() and oppositeEnd().enclosingFragment()->includes(self.combinedFragment) and matches(self))->size()=1) else self.combinedFragment.cfragmentGate->select(isInsideCF() and matches(self))->size()=1 endif" ;
    umlmeta:oclConstraint "isFormal() implies interaction.formalGate->select(getName() = self.getName())->size()=1" ;
    umlmeta:oclConstraint "isActual() implies interactionUse.actualGate->select(getName() = self.getName())->size()=1" ;
    umlmeta:oclConstraint "isOutsideCF() implies combinedFragment.cfragmentGate->select(getName() = self.getName())->size()=1" ;
    umlmeta:oclConstraint "isInsideCF() implies let selfOperand : InteractionOperand = self.getOperand() in combinedFragment.cfragmentGate->select(isInsideCF() and getName() = self.getName())->select(getOperand() = selfOperand)->size()=1" .

uml:GeneralOrdering a owl:Class ;
    rdfs:label "GeneralOrdering"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Interactions" ;
    skos:definition "A GeneralOrdering represents a binary relation between two OccurrenceSpecifications, to describe that one OccurrenceSpecification must occur before the other in a valid trace. This mechanism provides the ability to define partial orders of OccurrenceSpecifications that may otherwise not have a specified order."@en ;
    rdfs:subClassOf uml:NamedElement ;
    umlmeta:oclConstraint "after->closure(toAfter.after)->excludes(before)" .

uml:Generalization a owl:Class ;
    rdfs:label "Generalization"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Classification" ;
    skos:definition "A Generalization is a taxonomic relationship between a more general Classifier and a more specific Classifier. Each instance of the specific Classifier is also an instance of the general Classifier. The specific Classifier inherits the features of the more general Classifier. A Generalization is owned by the specific Classifier."@en ;
    rdfs:subClassOf uml:DirectedRelationship ;
    umlmeta:oclConstraint "mustBeOwned() implies owner->notEmpty()" ;
    umlmeta:oclConstraint "not allOwnedElements()->includes(self)" .

uml:GeneralizationSet a owl:Class ;
    rdfs:label "GeneralizationSet"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Classification" ;
    skos:definition "A GeneralizationSet is a PackageableElement whose instances represent sets of Generalization relationships."@en ;
    rdfs:subClassOf uml:PackageableElement ;
    umlmeta:oclConstraint "generalization->collect(general)->asSet()->size() <= 1" ;
    umlmeta:oclConstraint "powertype <> null implies generalization->forAll( gen | not (gen.general = powertype) and not gen.general.allParents()->includes(powertype) and not (gen.specific = powertype) and not powertype.allParents()->includes(gen.specific) )" .

uml:Image a owl:Class ;
    rdfs:label "Image"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Packages" ;
    skos:definition "Physical definition of a graphical image."@en ;
    rdfs:subClassOf uml:Element ;
    umlmeta:oclConstraint "mustBeOwned() implies owner->notEmpty()" ;
    umlmeta:oclConstraint "not allOwnedElements()->includes(self)" .

uml:Include a owl:Class ;
    rdfs:label "Include"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "UseCases" ;
    skos:definition "An Include relationship specifies that a UseCase contains the behavior defined in another UseCase."@en ;
    rdfs:subClassOf uml:DirectedRelationship ;
    rdfs:subClassOf uml:NamedElement ;
    umlmeta:oclConstraint "(namespace = null and owner <> null) implies visibility = null" ;
    umlmeta:oclConstraint "(name <> null and allNamespaces()->select(ns | ns.name = null)->isEmpty()) implies qualifiedName = allNamespaces()->iterate( ns : Namespace; agg: String = name | ns.name.concat(self.separator()).concat(agg))" ;
    umlmeta:oclConstraint "name=null or allNamespaces()->select( ns | ns.name=null )->notEmpty() implies qualifiedName = null" .

uml:InformationFlow a owl:Class ;
    rdfs:label "InformationFlow"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "InformationFlows" ;
    skos:definition "InformationFlows describe circulation of information through a system in a general manner. They do not specify the nature of the information, mechanisms by which it is conveyed, sequences of exchange or any control conditions. During more detailed modeling, representation and realization links may be added to specify which model elements implement an InformationFlow and to show how information is conveyed. InformationFlows require some kind of “information channel” for unidirectional transmission of information items from sources to targets. They specify the information channel’s realizations, if any, and identify the information that flows along them. Information moving along the information channel may be represented by abstract InformationItems and by concrete Classifiers."@en ;
    rdfs:subClassOf uml:DirectedRelationship ;
    rdfs:subClassOf uml:PackageableElement ;
    umlmeta:oclConstraint "(no specification serialized)" ;
    umlmeta:oclConstraint "(self.informationSource->forAll( sis | oclIsKindOf(Actor) or oclIsKindOf(Node) or oclIsKindOf(UseCase) or oclIsKindOf(Artifact) or oclIsKindOf(Class) or oclIsKindOf(Component) or oclIsKindOf(Port) or oclIsKindOf(Property) or oclIsKindOf(Interface) or oclIsKindOf(Package) or oclIsKindOf(ActivityNode) or oclIsKindOf(ActivityPartition) or (oclIsKindOf(InstanceSpecification) and not sis.oclAsType(InstanceSpecification).classifier->exists(oclIsKindOf(Relationship))))) and (self.informationTarget->forAll( sit | oclIsKindOf(Actor) or oclIsKindOf(Node) or oclIsKindOf(UseCase) or oclIsKindOf(Artifact) or oclIsKindOf(Class) or oclIsKindOf(Component) or oclIsKindOf(Port) or oclIsKindOf(Property) or oclIsKindOf(Interface) or oclIsKindOf(Package) or oclIsKindOf(ActivityNode) or oclIsKindOf(ActivityPartition) or (oclIsKindOf(InstanceSpecification) and not sit.oclAsType(InstanceSpecification).classifier->exists(oclIsKindOf(Relationship)))))" ;
    umlmeta:oclConstraint "self.conveyed->forAll(oclIsKindOf(Class) or oclIsKindOf(Interface) or oclIsKindOf(InformationItem) or oclIsKindOf(Signal) or oclIsKindOf(Component))" .

uml:InformationItem a owl:Class ;
    rdfs:label "InformationItem"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "InformationFlows" ;
    skos:definition "InformationItems represent many kinds of information that can flow from sources to targets in very abstract ways. They represent the kinds of information that may move within a system, but do not elaborate details of the transferred information. Details of transferred information are the province of other Classifiers that may ultimately define InformationItems. Consequently, InformationItems cannot be instantiated and do not themselves have features, generalizations, or associations. An important use of InformationItems is to represent information during early design stages, possibly before the detailed modeling decisions that will ultimately define them have been made. Another purpose of InformationItems is to abstract portions of complex models in less precise, but perhaps more general and communicable, ways."@en ;
    rdfs:subClassOf uml:Classifier ;
    umlmeta:oclConstraint "(self.represented->select(oclIsKindOf(InformationItem))->forAll(p | p.conveyingFlow.source->forAll(q | self.conveyingFlow.source->includes(q)) and p.conveyingFlow.target->forAll(q | self.conveyingFlow.target->includes(q)))) and (self.represented->forAll(oclIsKindOf(Class) or oclIsKindOf(Interface) or oclIsKindOf(InformationItem) or oclIsKindOf(Signal) or oclIsKindOf(Component)))" ;
    umlmeta:oclConstraint "self.generalization->isEmpty() and self.feature->isEmpty()" ;
    umlmeta:oclConstraint "isAbstract" .

uml:InitialNode a owl:Class ;
    rdfs:label "InitialNode"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Activities" ;
    skos:definition "An InitialNode is a ControlNode that offers a single control token when initially enabled."@en ;
    rdfs:subClassOf uml:ControlNode ;
