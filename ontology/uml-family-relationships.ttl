sysml2:Element a owl:Class ;
    rdfs:label "Element"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Elements" ;
    umlmeta:abstract true ;
    skos:definition "An Element is a constituent of a model that is uniquely identified relative to all other Elements . It can have Relationships with other Elements . Some of these Relationships might imply ownership of other Elements , which means that if an Element is deleted from a model, then so are all the Elements that it owns."@en ;
    umlmeta:oclConstraint "name = effectiveName()" ;
    umlmeta:oclConstraint "qualifiedName = if owningNamespace = null then null else if name <> null and owningNamespace.ownedMember-> select(m | m.name = name).indexOf(self) <> 1 then null else if owningNamespace.owner = null then escapedName() else if owningNamespace.qualifiedName = null or escapedName() = null then null else owningNamespace.qualifiedName + '::' + escapedName() endif endif endif endif" ;
    umlmeta:oclConstraint "ownedAnnotation = ownedRelationship-> selectByKind(Annotation)-> select(a | a.annotatedElement = self)" ;
    umlmeta:oclConstraint "shortName = effectiveShortName()" ;
    umlmeta:oclConstraint "owner = owningRelationship.owningRelatedElement" ;
    umlmeta:oclConstraint "isLibraryElement = libraryNamespace() <> null" ;
    umlmeta:oclConstraint "textualRepresentation = ownedElement->selectByKind(TextualRepresentation)" ;
    umlmeta:oclConstraint "ownedElement = ownedRelationship.ownedRelatedElement" ;
    umlmeta:oclConstraint "owningNamespace = if owningMembership = null then null else owningMembership.membershipOwningNamespace endif" ;
    umlmeta:oclConstraint "documentation = ownedElement->selectByKind(Documentation)" ;
    umlmeta:oclConstraint "ownedRelationship->exists(isImplied) implies isImpliedIncluded" .

sysml2:Namespace a owl:Class ;
    rdfs:label "Namespace"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Namespaces" ;
    skos:definition "A Namespace is an Element that contains other Elements , known as its members , via Membership Relationships with those Elements . The members of a Namespace may be owned by the Namespace , aliased in the Namespace , or imported into the Namespace via Import Relationships . A Namespace can provide names for its members via the memberNames and memberShortNames specified by the Memberships in the Namespace . If a Membership specifies a memberName and/or memberShortName , then those are names of the corresponding memberElement relative to the Namespace . For an Own...[truncated]"@en ;
    rdfs:subClassOf sysml2:Element ;
    umlmeta:oclConstraint "membership->forAll(m1 | membership->forAll(m2 | m1 <> m2 implies m1.isDistinguishableFrom(m2)))" ;
    umlmeta:oclConstraint "importedMembership = importedMemberships(Set{})" ;
    umlmeta:oclConstraint "ownedMembership = ownedRelationship->selectByKind(Membership)" ;
    umlmeta:oclConstraint "ownedMember = ownedMembership->selectByKind(OwningMembership).ownedMemberElement" ;
    umlmeta:oclConstraint "member = membership.memberElement" ;
    umlmeta:oclConstraint "ownedImport = ownedRelationship->selectByKind(Import)" .

sysml2:Type a owl:Class ;
    rdfs:label "Type"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Types" ;
    skos:definition "A Type is a Namespace that is the most general kind of Element supporting the semantics of classification. A Type may be a Classifier or a Feature , defining conditions on what is classified by the Type (see also the description of isSufficient )."@en ;
    rdfs:subClassOf sysml2:Namespace ;
    umlmeta:oclConstraint "ownedConjugator = let ownedConjugators: Sequence(Conjugator) = ownedRelationship->selectByKind(Conjugation) in if ownedConjugators->isEmpty() then null else ownedConjugators->at(1) endif" ;
    umlmeta:oclConstraint "differencingType->excludes(self)" ;
    umlmeta:oclConstraint "unioningType = ownedUnioning.unioningType" ;
    umlmeta:oclConstraint "inheritedFeature = inheritedMemberships-> selectByKind(FeatureMembership).memberFeature" ;
    umlmeta:oclConstraint "differencingType = ownedDifferencing.differencingType" ;
    umlmeta:oclConstraint "endFeature = feature->select(isEnd)" ;
    umlmeta:oclConstraint "ownedRelationship->selectByKind(Intersecting)" ;
    umlmeta:oclConstraint "inheritedMembership = inheritedMemberships(Set{}, Set{}, false)" ;
    umlmeta:oclConstraint "ownedDisjoining = ownedRelationship->selectByKind(Disjoining)" ;
    umlmeta:oclConstraint "ownedDifferencing = ownedRelationship->selectByKind(Differencing)" ;
    umlmeta:oclConstraint "ownedMember->selectByKind(Multiplicity)->size() <= 1" ;
    umlmeta:oclConstraint "ownedFeatureMembership = ownedRelationship->selectByKind(FeatureMembership)" ;
    umlmeta:oclConstraint "specializesFromLibrary('Base::Anything')" ;
    umlmeta:oclConstraint "intersectingType = ownedIntersecting.intersectingType" ;
    umlmeta:oclConstraint "multiplicity = let ownedMultiplicities: Sequence(Multiplicity) = ownedMember->selectByKind(Multiplicity) in if ownedMultiplicities->isEmpty() then null else ownedMultiplicities->first() endif" ;
    umlmeta:oclConstraint "input = feature->select(f | let direction: FeatureDirectionKind = directionOf(f) in direction = FeatureDirectionKind::_'in' or direction = FeatureDirectionKind::inout)" ;
    umlmeta:oclConstraint "unioningType->excludes(self)" ;
    umlmeta:oclConstraint "ownedIntersecting->size() <> 1" ;
    umlmeta:oclConstraint "ownedSpecialization = ownedRelationship->selectByKind(Specialization)-> select(s | s.special = self)" ;
    umlmeta:oclConstraint "output = feature->select(f | let direction: FeatureDirectionKind = directionOf(f) in direction = FeatureDirectionKind::out or direction = FeatureDirectionKind::inout)" ;
    umlmeta:oclConstraint "ownedEndFeature = ownedFeature->select(isEnd)" ;
    umlmeta:oclConstraint "directedFeature = feature->select(f | directionOf(f) <> null)" ;
    umlmeta:oclConstraint "ownedUnioning->size() <> 1" ;
    umlmeta:oclConstraint "ownedRelationship->selectByKind(Conjugation)->size() <= 1" ;
    umlmeta:oclConstraint "ownedFeature = ownedFeatureMembership.ownedMemberFeature" ;
    umlmeta:oclConstraint "featureMembership = ownedFeatureMembership->union( inheritedMembership->selectByKind(FeatureMembership))" ;
    umlmeta:oclConstraint "ownedUnioning = ownedRelationship->selectByKind(Unioning)" ;
    umlmeta:oclConstraint "ownedDifferencing->size() <> 1" ;
    umlmeta:oclConstraint "feature = featureMembership.ownedMemberFeature" ;
    umlmeta:oclConstraint "intersectingType->excludes(self)" .

sysml2:Feature a owl:Class ;
    rdfs:label "Feature"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Features" ;
    skos:definition "A Feature is a Type that classifies relations between multiple things (in the universe). The domain of the relation is the intersection of the featuringTypes of the Feature . (The domain of a Feature with no featuringTyps is implicitly the most general Type Base::Anything from the Kernel Semantic Library.) The co-domain of the relation is the intersection of the types of the Feature . In the simplest cases, the featuringTypes and types are Classifiers and the Feature relates two things, one from the domain and one from the range. Examples include cars paired with wheels, people paired with other people, and cars paired with numbers representing the car length. Since Features a...[truncated]"@en ;
    rdfs:subClassOf sysml2:Type ;
    umlmeta:oclConstraint "isEnd implied direction = null" ;
    umlmeta:oclConstraint "ownedCrossFeature() <> null implies crossFeature = ownedCrossFeature()" ;
    umlmeta:oclConstraint "isEnd and isVariable implies isConstant" ;
    umlmeta:oclConstraint "ownedTyping.type->exists(selectByKind(Structure)) implies specializesFromLibary('Objects::objects')" ;
    umlmeta:oclConstraint "ownedFeatureChaining = ownedRelationship->selectByKind(FeatureChaining)" ;
    umlmeta:oclConstraint "ownedTyping.type->exists(selectByKind(Class)) implies specializesFromLibrary('Occurrences::occurrences')" ;
    umlmeta:oclConstraint "ownedFeatureInverting = ownedRelationship->selectByKind(FeatureInverting)-> select(fi | fi.featureInverted = self)" ;
    umlmeta:oclConstraint "isVariable implies owningType <> null and owningType.specializes('Occurrences::Occurrence')" ;
    umlmeta:oclConstraint "owningType <> null and not owningFeatureMembership. oclIsKindOf(ReturnParameterMembership) and (owningType.oclIsKindOf(Behavior) or owningType.oclIsKindOf(Step) and (owningType.oclIsKindOf(InvocationExpression) implies not ownedRedefinition->exists(not isImplied)) implies let i : Integer = owningType.ownedFeature->select(direction <> null)-> reject(owningFeatureMembership. oclIsKindOf(ReturnParameterMembership))-> indexOf(self) in owningType.ownedSpecialization.general-> forAll(supertype | let ownedParameters : Sequence(Feature) = supertype.ownedFeature->select(direction <> null)-> reject(owningFeatureMembership. oclIsKindOf(ReturnParameterMembership)) in ownedParameters->size() >= i implies redefines(ownedParameters->at(i))" ;
    umlmeta:oclConstraint "ownedRedefinition = ownedSubsetting->selectByKind(Redefinition)" ;
    umlmeta:oclConstraint "chainingFeature->size() <> 1" ;
    umlmeta:oclConstraint "chainingFeature = ownedFeatureChaining.chainingFeature" ;
    umlmeta:oclConstraint "isEnd and owningType <> null implies let i : Integer = owningType.ownedEndFeature->indexOf(self) in owningType.ownedSpecialization.general-> forAll(supertype | supertype.endFeature->size() >= i implies redefines(supertype.endFeature->at(i))" ;
    umlmeta:oclConstraint "direction = null and ownedSpecializations->forAll(isImplied) implies ownedMembership-> selectByKind(FeatureValue)-> forAll(fv | specializes(fv.value.result))" ;
    umlmeta:oclConstraint "isOwnedCrossFeature() implies owner.oclAsType(Feature).type->forAll(t | self.specializes(t))" ;
    umlmeta:oclConstraint "crossFeature <> null implies crossFeature.type->asSet() = type->asSet()" ;
    umlmeta:oclConstraint "multiplicity <> null implies multiplicity.featuringType = featuringType" ;
    umlmeta:oclConstraint "Sequence{2..chainingFeature->size()}->forAll(i | chainingFeature->at(i).isFeaturedWithin(chainingFeature->at(i-1)))" ;
    umlmeta:oclConstraint "crossFeature = if ownedCrossSubsetting = null then null else let chainingFeatures: Sequence(Feature) = ownedCrossSubsetting.crossedFeature.chainingFeature in if chainingFeatures->size() at(2) endif" ;
    umlmeta:oclConstraint "isConstant implies isVariable" ;
    umlmeta:oclConstraint "isPortion implies not isVariable" ;
    umlmeta:oclConstraint "ownedSubsetting = ownedSpecialization->selectByKind(Subsetting)" ;
    umlmeta:oclConstraint "chainingFeature->excludes(self)" ;
    umlmeta:oclConstraint "ownedCrossSubsetting = let crossSubsettings: Sequence(CrossSubsetting) = ownedSubsetting->selectByKind(CrossSubsetting) in if crossSubsettings->isEmpty() then null else crossSubsettings->first() endif" ;
    umlmeta:oclConstraint "featuringType = let featuringTypes : OrderedSet(Type) = featuring.type->asOrderedSet() in if chainingFeature->isEmpty() then featuringTypes else featuringTypes-> union(chainingFeature->first().featuringType)-> asOrderedSet() endif" ;
    umlmeta:oclConstraint "owningType <> null and (owningType.oclIsKindOf(Function) and self = owningType.oclAsType(Function).result or owningType.oclIsKindOf(Expression) and self = owningType.oclAsType(Expression).result) implies owningType.ownedSpecialization.general-> select(oclIsKindOf(Function) or oclIsKindOf(Expression))-> forAll(supertype | redefines( if superType.oclIsKindOf(Function) then superType.oclAsType(Function).result else superType.oclAsType(Expression).result endif)" ;
    umlmeta:oclConstraint "ownedTyping = ownedGeneralization->selectByKind(FeatureTyping)" ;
    umlmeta:oclConstraint "isPortion and ownedTyping.type->includes(oclIsKindOf(Class)) and owningType <> null and (owningType.oclIsKindOf(Class) or owningType.oclIsKindOf(Feature) and owningType.oclAsType(Feature).type-> exists(oclIsKindOf(Class))) implies specializesFromLibrary('Occurrence::Occurrence::portions')" ;
    umlmeta:oclConstraint "isEnd and owningType <> null and (owningType.oclIsKindOf(Association) or owningType.oclIsKindOf(Connector)) implies specializesFromLibrary('Links::Link::participant')" ;
    umlmeta:oclConstraint "type = let types : OrderedSet(Types) = OrderedSet{self}-> -- Note: The closure operation automatically handles circular relationships. closure(typingFeatures()).typing.type->asOrderedSet() in types->reject(t1 | types->exist(t2 | t2 <> t1 and t2.specializes(t1)))" ;
    umlmeta:oclConstraint "ownedSubsetting->selectByKind(CrossSubsetting)->size() <= 1" ;
    umlmeta:oclConstraint "isComposite and ownedTyping.type->includes(oclIsKindOf(Class)) and owningType <> null and (owningType.oclIsKindOf(Class) or owningType.oclIsKindOf(Feature) and owningType.oclAsType(Feature).type-> exists(oclIsKindOf(Class))) implies specializesFromLibrary('Occurrence::Occurrence::suboccurrences')" ;
    umlmeta:oclConstraint "ownedReferenceSubsetting = let referenceSubsettings : OrderedSet(ReferenceSubsetting) = ownedSubsetting->selectByKind(ReferenceSubsetting) in if referenceSubsettings->isEmpty() then null else referenceSubsettings->first() endif" ;
    umlmeta:oclConstraint "isComposite and ownedTyping.type->includes(oclIsKindOf(Structure)) and owningType <> null and (owningType.oclIsKindOf(Structure) or owningType.type->includes(oclIsKindOf(Structure))) implies specializesFromLibrary('Occurrence::Occurrence::suboccurrences')" ;
    umlmeta:oclConstraint "crossFeature <> null implies ownedRedefinition.redefinedFeature.crossFeature-> forAll(f | f <> null implies crossFeature.specializes(f))" ;
    umlmeta:oclConstraint "ownedTypeFeaturing = ownedRelationship->selectByKind(TypeFeaturing)-> select(tf | tf.featureOfType = self)" ;
    umlmeta:oclConstraint "ownedSubsetting->selectByKind(ReferenceSubsetting)->size() <= 1" ;
    umlmeta:oclConstraint "ownedTyping.type->exists(selectByKind(DataType)) implies specializesFromLibrary('Base::dataValues')" ;
    umlmeta:oclConstraint "owningType <> null and owningType.oclIsKindOf(FlowEnd) and owningType.ownedFeature->at(1) = self implies let flowType : Type = owningType.owningType in flowType <> null implies let i : Integer = flowType.ownedFeature.indexOf(owningType) in (i = 1 implies redefinesFromLibrary('Transfers::Transfer::source::sourceOutput')) and (i = 2 implies redefinesFromLibrary('Transfers::Transfer::source::targetInput'))" ;
    umlmeta:oclConstraint "featureTarget = if chainingFeature->isEmpty() then self else chainingFeature->last() endif" ;
    umlmeta:oclConstraint "isEnd implies multiplicities().allSuperTypes()->flatten()-> selectByKind(MultiplicityRange)->exists(hasBounds(1,1))" ;
    umlmeta:oclConstraint "isOwnedCrossFeature() implies let otherEnds : OrderedSet(Feature) = owner.oclAsType(Feature).owningType.endFeature->excluding(self) in if (otherEnds->size() = 1) then featuringType = otherEnds->first().type else featuringType->size() = 1 and featuringType->first().isCartesianProduct() and featuringType->first().asCartesianProduct() = otherEnds.type and featuringType->first().allSupertypes()->includesAll( owner.oclAsType(Feature).ownedRedefinition.redefinedFeature-> select(crossFeature() <> null).crossFeature().featuringType) endif" ;
    umlmeta:oclConstraint "isOwnedCrossFeature() implies ownedSubsetting.subsettedFeature->includesAll( owner.oclAsType(Feature).ownedRedefinition.redefinedFeature-> select(crossFeature <> null).crossFeature)" ;
    umlmeta:oclConstraint "owningFeatureMembership <> null implies featuringTypes->exists(t | isFeaturingType(t))" ;
    umlmeta:oclConstraint "isEnd implies not (isDerived or isAbstract or isComposite or isPortion)" ;
    umlmeta:oclConstraint "specializesFromLibrary('Base::things')" .

sysml2:Step a owl:Class ;
    rdfs:label "Step"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Behaviors" ;
    skos:definition "A Step is a Feature that is typed by one or more Behaviors . Steps may be used by one Behavior to coordinate the performance of other Behaviors , supporting a steady refinement of behavioral descriptions. Steps can be ordered in time and can be connected using Flows to specify things flowing between their parameters ."@en ;
    rdfs:subClassOf sysml2:Feature ;
    umlmeta:oclConstraint "behavior = type->selectByKind(Behavior)" ;
    umlmeta:oclConstraint "owningType <> null and (owningType.oclIsKindOf(Behavior) or owningType.oclIsKindOf(Step)) and self.isComposite implies specializesFromLibrary('Performances::Performance::subperformance')" ;
    umlmeta:oclConstraint "specializesFromLibrary('Performances::performances')" ;
    umlmeta:oclConstraint "owningType <> null and (owningType.oclIsKindOf(Behavior) or owningType.oclIsKindOf(Step)) implies specializesFromLibrary('Performances::Performance::enclosedPerformance')" ;
    umlmeta:oclConstraint "isComposite and owningType <> null and (owningType.oclIsKindOf(Structure) or owningType.oclIsKindOf(Feature) and owningType.oclAsType(Feature).type-> exists(oclIsKindOf(Structure)) implies specializesFromLibrary('Objects::Object::ownedPerformance')" .

sysml2:Usage a owl:Class ;
    rdfs:label "Usage"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "DefinitionAndUsage" ;
    skos:definition "A Usage is a usage of a Definition . A Usage may have nestedUsages that model features that apply in the context of the owningUsage . A Usage may also have Definitions nested in it, but this has no semantic significance, other than the nested scoping resulting from the Usage being considered as a Namespace for any nested Definitions . However, if a Usage has isVariation = true , then it represents a variation point Usage . In this case, all of its members must be variant Usages , related to the Usage by VariantMembership Relationships . Rather than being features of the Usage , varia...[truncated]"@en ;
    rdfs:subClassOf sysml2:Feature ;
    umlmeta:oclConstraint "nestedView = nestedUsage->selectByKind(ViewUsage)" ;
    umlmeta:oclConstraint "isVariation implies isAbstract" ;
    umlmeta:oclConstraint "usage = feature->selectByKind(Usage)" ;
    umlmeta:oclConstraint "ownedNested = nestedUsage->selectByKind(EnumerationUsage)" ;
    umlmeta:oclConstraint "nestedConstraint = nestedUsage->selectByKind(ConstraintUsage)" ;
    umlmeta:oclConstraint "nestedOccurrence = nestedUsage->selectByKind(OccurrenceUsage)" ;
    umlmeta:oclConstraint "nestedViewpoint = nestedUsage->selectByKind(ViewpointUsage)" ;
    umlmeta:oclConstraint "nestedAction = nestedUsage->selectByKind(ActionUsage)" ;
    umlmeta:oclConstraint "nestedFlow = nestedUsage->selectByKind(FlowConnectionUsage)" ;
    umlmeta:oclConstraint "owningVariationUsage <> null implies specializes(owningVariationUsage)" ;
    umlmeta:oclConstraint "isVariation implies ownedFeatureMembership->isEmpty()" ;
    umlmeta:oclConstraint "nestedItem = nestedUsage->selectByKind(ItemUsage)" ;
    umlmeta:oclConstraint "isVariation implies not ownedSpecialization.specific->exists( oclIsKindOf(Definition) and oclAsType(Definition).isVariation or oclIsKindOf(Usage) and oclAsType(Usage).isVariation)" ;
    umlmeta:oclConstraint "nestedState = nestedUsage->selectByKind(StateUsage)" ;
    umlmeta:oclConstraint "nestedConcern = nestedUsage->selectByKind(ConcernUsage)" ;
    umlmeta:oclConstraint "nestedVerificationCase = nestedUsage->selectByKind(VerificationCaseUsage)" ;
    umlmeta:oclConstraint "nestedCalculation = nestedUsage->selectByKind(CalculationUsage)" ;
    umlmeta:oclConstraint "nestedAttribute = nestedUsage->selectByKind(AttributeUsage)" ;
    umlmeta:oclConstraint "directedUsage = directedFeature->selectByKind(Usage)" ;
    umlmeta:oclConstraint "nestedPart = nestedUsage->selectByKind(PartUsage)" ;
    umlmeta:oclConstraint "nestedMetadata = nestedUsage->selectByKind(MetadataUsage)" ;
    umlmeta:oclConstraint "nestedAllocation = nestedUsage->selectByKind(AllocationUsage)" ;
    umlmeta:oclConstraint "nestedUsage = ownedFeature->selectByKind(Usage)" ;
    umlmeta:oclConstraint "nestedRendering = nestedUsage->selectByKind(RenderingUsage)" ;
    umlmeta:oclConstraint "nestedConnection = nestedUsage->selectByKind(ConnectorAsUsage)" ;
    umlmeta:oclConstraint "variantMembership = ownedMembership->selectByKind(VariantMembership)" ;
    umlmeta:oclConstraint "nestedReference = nestedUsage->selectByKind(ReferenceUsage)" ;
    umlmeta:oclConstraint "nestedUseCase = nestedUsage->selectByKind(UseCaseUsage)" ;
    umlmeta:oclConstraint "mayTimeVary = owningType <> null and owningType.specializesFromLibrary('Occurrences::Occurrence') and not ( isPortion or specializesFromLibrary('Links::SelfLink') or specializesFromLibrary('Occurrences::HappensLink') or isComposite and specializesFromLibrary('Actions::Action') )" ;
    umlmeta:oclConstraint "nestedRequirement = nestedUsage->selectByKind(RequirementUsage)" ;
    umlmeta:oclConstraint "nestedPort = nestedUsage->selectByKind(PortUsage)" ;
    umlmeta:oclConstraint "direction <> null or isEnd or featuringType->isEmpty() implies isReference" ;
    umlmeta:oclConstraint "nestedTransition = nestedUsage->selectByKind(TransitionUsage)" ;
    umlmeta:oclConstraint "nestedInterface = nestedUsage->selectByKind(ReferenceUsage)" ;
    umlmeta:oclConstraint "nestedAnalysisCase = nestedUsage->selectByKind(AnalysisCaseUsage)" ;
    umlmeta:oclConstraint "nestedCase = nestedUsage->selectByKind(CaseUsage)" ;
    umlmeta:oclConstraint "isReference = not isComposite" ;
    umlmeta:oclConstraint "variant = variantMembership.ownedVariantUsage" ;
    umlmeta:oclConstraint "owningVariationDefinition <> null implies specializes(owningVariationDefinition)" ;
    umlmeta:oclConstraint "owningVariationUsage <> null implies featuringType->asSet() = owningVariationUsage.featuringType->asSet()" .

sysml2:OccurrenceUsage a owl:Class ;
    rdfs:label "OccurrenceUsage"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Occurrences" ;
    skos:definition "An OccurrenceUsage is a Usage whose types are all Classes . Nominally, if a type is an OccurrenceDefinition , an OccurrenceUsage is a Usage of that OccurrenceDefinition within a system. However, other types of Kernel Classes are also allowed, to permit use of Classes from the Kernel Model Libraries."@en ;
    rdfs:subClassOf sysml2:Usage ;
    umlmeta:oclConstraint "occurrenceDefinition-> selectByKind(OccurrenceDefinition)-> select(isIndividual).size() <= 1" ;
    umlmeta:oclConstraint "portionKind = PortionKind::snapshot implies specializesFromLibrary('Occurrences::Occurrence::snapshots')" ;
    umlmeta:oclConstraint "isIndividual implies individualDefinition <> null" ;
    umlmeta:oclConstraint "specializesFromLibrary('Occurrences::occurrences')" ;
    umlmeta:oclConstraint "individualDefinition = let individualDefinitions : OrderedSet(OccurrenceDefinition) = occurrenceDefinition-> selectByKind(OccurrenceDefinition)-> select(isIndividual) in if individualDefinitions->isEmpty() then null else individualDefinitions->first() endif" ;
    umlmeta:oclConstraint "portionKind <> null implies isPortion" ;
    umlmeta:oclConstraint "isComposite and owningType <> null and (owningType.oclIsKindOf(Class) or owningType.oclIsKindOf(OccurrenceUsage) or owningType.oclIsKindOf(Feature) and owningType.oclAsType(Feature).type-> exists(oclIsKind(Class))) implies specializesFromLibrary('Occurrences::Occurrence::suboccurrences')" ;
    umlmeta:oclConstraint "portionKind = PortionKind::timeslice implies specializesFromLibrary('Occurrences::Occurrence::timeSlices')" ;
    umlmeta:oclConstraint "portionKind <> null implies owningType <> null and (owningType.oclIsKindOf(OccurrenceDefinition) or owningType.oclIsKindOf(OccurrenceUsage))" .

sysml2:ActionUsage a owl:Class ;
    rdfs:label "ActionUsage"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Actions" ;
    skos:definition "An ActionUsage is a Usage that is also a Step , and, so, is typed by a Behavior . Nominally, if the type is an ActionDefinition , an ActionUsage is a Usage of that ActionDefinition within a system. However, other kinds of kernel Behaviors are also allowed, to permit use of Behaviors from the Kernel Model Libraries."@en ;
    rdfs:subClassOf sysml2:OccurrenceUsage ;
    rdfs:subClassOf sysml2:Step ;
    umlmeta:oclConstraint "owningFeatureMembership <> null and owningFeatureMembership.oclIsKindOf(StateSubactionMembership) implies let kind : StateSubactionKind = owningFeatureMembership.oclAsType(StateSubactionMembership).kind in if kind = StateSubactionKind::entry then redefinesFromLibrary('States::StateAction::entryAction') else if kind = StateSubactionKind::do then redefinesFromLibrary('States::StateAction::doAction') else redefinesFromLibrary('States::StateAction::exitAction') endif endif" ;
    umlmeta:oclConstraint "specializesFromLibrary('Actions::actions')" ;
    umlmeta:oclConstraint "isSubactionUsage() implies specializesFromLibrary('Actions::Action::subactions')" ;
    umlmeta:oclConstraint "isComposite and owningType <> null and (owningType.oclIsKindOf(PartDefinition) or owningType.oclIsKindOf(PartUsage)) implies specializesFromLibrary('Parts::Part::ownedActions')" .

sysml2:AcceptActionUsage a owl:Class ;
    rdfs:label "AcceptActionUsage"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Actions" ;
    skos:definition "An AcceptActionUsage is an ActionUsage that specifies the acceptance of an incomingTransfer from the Occurrence given by the result of its receiverArgument Expression. (If no receiverArgument is provided, the default is the this context of the AcceptActionUsage.) The payload of the accepted Transfer is output on its payloadParameter . Which Transfers may be accepted is determined by conformance to the typing and (potentially) binding of the payloadParameter ."@en ;
    rdfs:subClassOf sysml2:ActionUsage ;
    umlmeta:oclConstraint "payloadArgument = argument(1)" ;
    umlmeta:oclConstraint "payloadArgument <> null and payloadArgument.oclIsKindOf(TriggerInvocationExpression) implies let invocation : Expression = payloadArgument.oclAsType(Expression) in parameter->size() >= 2 and invocation.parameter->size() >= 2 and ownedFeature->selectByKind(BindingConnector)->exists(b | b.relatedFeatures->includes(parameter->at(2)) and b.relatedFeatures->includes(invocation.parameter->at(2)))" ;
    umlmeta:oclConstraint "payloadParameter = if parameter->isEmpty() then null else parameter->first() endif" ;
    umlmeta:oclConstraint "isTriggerAction() implies specializesFromLibrary('Actions::TransitionAction::accepter')" ;
    umlmeta:oclConstraint "inputParameters()->size() >= 2" ;
    umlmeta:oclConstraint "receiverArgument = argument(2)" ;
    umlmeta:oclConstraint "isSubactionUsage() and not isTriggerAction() implies specializesFromLibrary('Actions::Action::acceptSubactions')" ;
    umlmeta:oclConstraint "not isTriggerAction() implies specializesFromLibrary('Actions::acceptActions')" .

sysml2:Classifier a owl:Class ;
    rdfs:label "Classifier"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Classifiers" ;
    skos:definition "A Classifier is a Type that classifies: Things (in the universe) regardless of how Features relate them. (These are interpreted semantically as sequences of exactly one thing.) How the above things are related by Features. (These are interpreted semantically as sequences of multiple things, such that the last thing in the sequence is also classified by the Classifier . Note that this means that a Classifier modeled as specializing a Feature cannot classify anything.)"@en ;
    rdfs:subClassOf sysml2:Type ;
    umlmeta:oclConstraint "ownedSubclassification = ownedSpecialization->selectByKind(Subclassification)" ;
    umlmeta:oclConstraint "multiplicity <> null implies multiplicity.featuringType->isEmpty()" .

sysml2:Definition a owl:Class ;
    rdfs:label "Definition"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "DefinitionAndUsage" ;
    skos:definition "A Definition is a Classifier of Usages . The actual kinds of Definition that may appear in a model are given by the subclasses of Definition (possibly as extended with user-defined SemanticMetadata ). Normally, a Definition has owned Usages that model features of the thing being defined. A Definition may also have other Definitions nested in it, but this has no semantic significance, other than the nested scoping resulting from the Definition being considered as a Namespace for any nested Definitions . However, if a Definition has isVariation = true , then it represents a variation point Definition . In this case, all of its members</c...[truncated]"@en ;
    rdfs:subClassOf sysml2:Classifier ;
    umlmeta:oclConstraint "ownedOccurrence = ownedUsage->selectByKind(OccurrenceUsage)" ;
    umlmeta:oclConstraint "usage = feature->selectByKind(Usage)" ;
    umlmeta:oclConstraint "ownedUsage = ownedFeature->selectByKind(Usage)" ;
    umlmeta:oclConstraint "ownedPart = ownedUsage->selectByKind(PartUsage)" ;
    umlmeta:oclConstraint "directedUsage = directedFeature->selectByKind(Usage)" ;
    umlmeta:oclConstraint "ownedVerificationCase = ownedUsage->selectByKind(VerificationCaseUsage)" ;
    umlmeta:oclConstraint "ownedViewpoint = ownedUsage->selectByKind(ViewpointUsage)" ;
    umlmeta:oclConstraint "ownedAnalysisCase = ownedUsage->selectByKind(AnalysisCaseUsage)" ;
    umlmeta:oclConstraint "ownedFlow = ownedUsage->selectByKind(FlowConnectionUsage)" ;
    umlmeta:oclConstraint "ownedAction = ownedUsage->selectByKind(ActionUsage)" ;
    umlmeta:oclConstraint "ownedMetadata = ownedUsage->selectByKind(MetadataUsage)" ;
    umlmeta:oclConstraint "isVariation implies not ownedSpecialization.specific->exists( oclIsKindOf(Definition) and oclAsType(Definition).isVariation)" ;
    umlmeta:oclConstraint "variantMembership = ownedMembership->selectByKind(VariantMembership)" ;
    umlmeta:oclConstraint "ownedCalculation = ownedUsage->selectByKind(CalculationUsage)" ;
    umlmeta:oclConstraint "ownedUseCase = ownedUsage->selectByKind(UseCaseUsage)" ;
    umlmeta:oclConstraint "ownedRequirement = ownedUsage->selectByKind(RequirementUsage)" ;
    umlmeta:oclConstraint "ownedItem = ownedUsage->selectByKind(ItemUsage)" ;
    umlmeta:oclConstraint "ownedConcern = ownedUsage->selectByKind(ConcernUsage)" ;
    umlmeta:oclConstraint "ownedConstraint = ownedUsage->selectByKind(ConstraintUsage)" ;
    umlmeta:oclConstraint "ownedReference = ownedUsage->selectByKind(ReferenceUsage)" ;
    umlmeta:oclConstraint "ownedCase = ownedUsage->selectByKind(CaseUsage)" ;
    umlmeta:oclConstraint "ownedEnumeration = ownedUsage->selectByKind(EnumerationUsage)" ;
    umlmeta:oclConstraint "ownedState = ownedUsage->selectByKind(StateUsage)" ;
    umlmeta:oclConstraint "ownedRendering = ownedUsage->selectByKind(RenderingUsage)" ;
    umlmeta:oclConstraint "ownedAttribute = ownedUsage->selectByKind(AttributeUsage)" ;
    umlmeta:oclConstraint "ownedPort = ownedUsage->selectByKind(PortUsage)" ;
    umlmeta:oclConstraint "ownedTransition = ownedUsage->selectByKind(TransitionUsage)" ;
    umlmeta:oclConstraint "variant = variantMembership.ownedVariantUsage" ;
    umlmeta:oclConstraint "ownedAllocation = ownedUsage->selectByKind(AllocationUsage)" ;
    umlmeta:oclConstraint "ownedView = ownedUsage->selectByKind(ViewUsage)" ;
    umlmeta:oclConstraint "isVariation implies isAbstract" ;
    umlmeta:oclConstraint "isVariation implies ownedFeatureMembership->isEmpty()" ;
    umlmeta:oclConstraint "ownedConnection = ownedUsage->selectByKind(ConnectorAsUsage)" ;
    umlmeta:oclConstraint "ownedInterface = ownedUsage->selectByKind(ReferenceUsage)" .

sysml2:Class a owl:Class ;
    rdfs:label "Class"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Classes" ;
    skos:definition "A Class is a Classifier of things (in the universe) that can be distinguished without regard to how they are related to other things (via Features ). This means multiple things classified by the same Class can be distinguished, even when they are related other things in exactly the same way."@en ;
    rdfs:subClassOf sysml2:Classifier ;
    umlmeta:oclConstraint "specializesFromLibrary('Occurrences::Occurrence')" ;
    umlmeta:oclConstraint "ownedSpecialization.general-> forAll(not oclIsKindOf(DataType)) and not oclIsKindOf(Association) implies ownedSpecialization.general-> forAll(not oclIsKindOf(Association))" .

sysml2:OccurrenceDefinition a owl:Class ;
    rdfs:label "OccurrenceDefinition"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Occurrences" ;
    skos:definition "An OccurrenceDefinition is a Definition of a Class of individuals that have an independent life over time and potentially an extent over space. This includes both structural things and behaviors that act on such structures. If isIndividual is true, then the OccurrenceDefinition is constrained to have (at most) a single instance that is the entire life of a single individual."@en ;
    rdfs:subClassOf sysml2:Definition ;
    rdfs:subClassOf sysml2:Class ;
    umlmeta:oclConstraint "isIndividual implies specializesFromLibrary('Occurrences::Life')" ;
    umlmeta:oclConstraint "isIndividual implies multiplicity <> null and multiplicity.specializesFromLibrary('Base::zeroOrOne')" .

sysml2:Behavior a owl:Class ;
    rdfs:label "Behavior"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Behaviors" ;
    skos:definition "A Behavior coordinates occurrences of other Behaviors , as well as changes in objects. Behaviors can be decomposed into Steps and be characterized by parameters ."@en ;
    rdfs:subClassOf sysml2:Class ;
    umlmeta:oclConstraint "specializesFromLibrary('Performances::Performance')" ;
    umlmeta:oclConstraint "ownedSpecialization.general->forAll(not oclIsKindOf(Structure))" ;
    umlmeta:oclConstraint "step = feature->selectByKind(Step)" .

sysml2:ActionDefinition a owl:Class ;
    rdfs:label "ActionDefinition"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Actions" ;
    skos:definition "An ActionDefinition is a Definition that is also a Behavior that defines an Action performed by a system or part of a system."@en ;
    rdfs:subClassOf sysml2:OccurrenceDefinition ;
    rdfs:subClassOf sysml2:Behavior ;
    umlmeta:oclConstraint "specializesFromLibrary('Actions::Action')" ;
    umlmeta:oclConstraint "action = usage->selectByKind(ActionUsage)" .

sysml2:Relationship a owl:Class ;
    rdfs:label "Relationship"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Elements" ;
    umlmeta:abstract true ;
    skos:definition "A Relationship is an Element that relates other Element . Some of its relatedElements may be owned, in which case those ownedRelatedElements will be deleted from a model if their owningRelationship is. A Relationship may also be owned by another Element , in which case the ownedRelatedElements of the Relationship are also considered to be transitively owned by the owningRelatedElement of the Relationship . The relatedElements of a Relationship are divided into source and target Elements . The Relationship is considered to be directed from the source to the target Elements . An undirected Relationship m...[truncated]"@en ;
    rdfs:subClassOf sysml2:Element ;
    umlmeta:oclConstraint "relatedElement = source->union(target)" .

sysml2:Membership a owl:Class ;
    rdfs:label "Membership"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Namespaces" ;
    skos:definition "A Membership is a Relationship between a Namespace and an Element that indicates the Element is a member of (i.e., is contained in) the Namespace. Any memberNames specify how the memberElement is identified in the Namespace and the visibility specifies whether or not the memberElement is publicly visible from outside the Namespace . If a Membership is an OwningMembership , then it owns its memberElement , which becomes an ownedMember of the membershipOwningNamespace . Otherwise, the memberNames of a Membership are effectively aliases within the membershipOwningNamespace for an Element with a separate OwningM...[truncated]"@en ;
    rdfs:subClassOf sysml2:Relationship ;
    umlmeta:oclConstraint "memberElementId = memberElement.elementId" .

sysml2:OwningMembership a owl:Class ;
    rdfs:label "OwningMembership"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Namespaces" ;
    skos:definition "An OwningMembership is a Membership that owns its memberElement as a ownedRelatedElement . The ownedMemberElement becomes an ownedMember of the membershipOwningNamespace ."@en ;
    rdfs:subClassOf sysml2:Membership ;
    umlmeta:oclConstraint "ownedMemberName = ownedMemberElement.name" ;
    umlmeta:oclConstraint "ownedMemberShortName = ownedMemberElement.shortName" .

sysml2:FeatureMembership a owl:Class ;
    rdfs:label "FeatureMembership"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Types" ;
    skos:definition "A FeatureMembership is an OwningMembership between an ownedMemberFeature and an owningType . If the ownedMemberFeature has isVariable = false , then the FeatureMembership implies that the owningType is also a featuringType of the ownedMemberFeature . If the ownedMemberFeature has isVariable = true , then the FeatureMembership implies that the ownedMemberFeature is featured by the snapshots of the owningType , which must specialize the Kernel Semantic Library base class Occurrence ."@en ;
    rdfs:subClassOf sysml2:OwningMembership ;
    umlmeta:oclConstraint "ownedMemberName = ownedMemberElement.name" ;
    umlmeta:oclConstraint "ownedMemberShortName = ownedMemberElement.shortName" .

sysml2:ParameterMembership a owl:Class ;
    rdfs:label "ParameterMembership"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Behaviors" ;
    skos:definition "A ParameterMembership is a FeatureMembership that identifies its memberFeature as a parameter, which is always owned, and must have a direction . A ParameterMembership must be owned by a Behavior , a Step , or the result parameter of a ConstructorExpression ."@en ;
    rdfs:subClassOf sysml2:FeatureMembership ;
    umlmeta:oclConstraint "ownedMemberParameter.direction = parameterDirection()" ;
    umlmeta:oclConstraint "owningType.oclIsKindOf(Behavior) or owningType.oclIsKindOf(Step) or owningType.owningMembership.oclIsKindOf(ReturnParameterMembership) and owningType.owningNamespace.oclIsKindOf(ConstructorExpression)" .

sysml2:ActorMembership a owl:Class ;
    rdfs:label "ActorMembership"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Requirements" ;
    skos:definition "An ActorMembership is a ParameterMembership that identifies a PartUsage as an actor parameter , which specifies a role played by an external entity in interaction with the owningType of the ActorMembership ."@en ;
    rdfs:subClassOf sysml2:ParameterMembership ;
    umlmeta:oclConstraint "owningType.oclIsKindOf(RequirementUsage) or owningType.oclIsKindOf(RequirementDefinition) or owningType.oclIsKindOf(CaseDefinition) or owningType.oclIsKindOf(CaseUsage)" .

sysml2:Structure a owl:Class ;
    rdfs:label "Structure"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Structures" ;
    skos:definition "A Structure is a Class of objects in the modeled universe that are primarily structural in nature. While such an object is not itself behavioral, it may be involved in and acted on by Behaviors , and it may be the performer of some of them."@en ;
    rdfs:subClassOf sysml2:Class ;
    umlmeta:oclConstraint "specializesFromLibrary('Objects::Object')" ;
    umlmeta:oclConstraint "ownedSpecialization.general->forAll(not oclIsKindOf(Behavior))" .

sysml2:Association a owl:Class ;
    rdfs:label "Association"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Associations" ;
    skos:definition "An Association is a Relationship and a Classifier to enable classification of links between things (in the universe). The co-domains ( types ) of the associationEnd Features are the relatedTypes , as co-domain and participants (linked things) of an Association identify each other."@en ;
    rdfs:subClassOf sysml2:Classifier ;
    rdfs:subClassOf sysml2:Relationship ;
    umlmeta:oclConstraint "oclIsKindOf(Structure) = oclIsKindOf(AssociationStructure)" ;
    umlmeta:oclConstraint "associationEnds->size() > 2 implies not specializesFromLibrary('Links::BinaryLink')" ;
    umlmeta:oclConstraint "not isAbstract implies relatedType->size() >= 2" ;
    umlmeta:oclConstraint "targetType = if relatedType->size() subSequence(2, relatedType->size())-> asOrderedSet() endif" ;
    umlmeta:oclConstraint "specializesFromLibrary('Links::Link')" ;
    umlmeta:oclConstraint "relatedType = associationEnd.type" ;
    umlmeta:oclConstraint "ownedEndFeature->forAll(type->size() = 1)" ;
    umlmeta:oclConstraint "sourceType = if relatedType->isEmpty() then null else relatedType->first() endif" ;
    umlmeta:oclConstraint "associationEnd->size() = 2 implies specializesFromLibrary('Links::BinaryLink')" .

sysml2:AssociationStructure a owl:Class ;
    rdfs:label "AssociationStructure"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Associations" ;
    skos:definition "An AssociationStructure is an Association that is also a Structure , classifying link objects that are both links and objects. As objects, link objects can be created and destroyed, and their non-end Features can change over time. However, the values of the end Features of a link object are fixed and cannot change over its lifetime."@en ;
    rdfs:subClassOf sysml2:Structure ;
    rdfs:subClassOf sysml2:Association ;
    umlmeta:oclConstraint "specializesFromLibrary('Objects::LinkObject')" ;
    umlmeta:oclConstraint "endFeature->size() = 2 implies specializesFromLibrary('Objects::BinaryLinkObject')" .

sysml2:ItemDefinition a owl:Class ;
    rdfs:label "ItemDefinition"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Items" ;
    skos:definition "An ItemDefinition is an OccurrenceDefinition of the Structure of things that may themselves be systems or parts of systems, but may also be things that are acted on by a system or parts of a system, but which do not necessarily perform actions themselves. This includes items that can be exchanged between parts of a system, such as water or electrical signals."@en ;
    rdfs:subClassOf sysml2:Structure ;
    rdfs:subClassOf sysml2:OccurrenceDefinition ;
    umlmeta:oclConstraint "specializesFromLibrary('Items::Item')" .

sysml2:PartDefinition a owl:Class ;
    rdfs:label "PartDefinition"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Parts" ;
    skos:definition "A PartDefinition is an ItemDefinition of a Class of systems or parts of systems. Note that all parts may be considered items for certain purposes, but not all items are parts that can perform actions within a system."@en ;
    rdfs:subClassOf sysml2:ItemDefinition ;
    umlmeta:oclConstraint "specializesFromLibrary('Parts::Part')" .

sysml2:ConnectionDefinition a owl:Class ;
    rdfs:label "ConnectionDefinition"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Connections" ;
    skos:definition "A ConnectionDefinition is a PartDefinition that is also an AssociationStructure . The end Features of a ConnectionDefinition must be Usages ."@en ;
    rdfs:subClassOf sysml2:PartDefinition ;
    rdfs:subClassOf sysml2:AssociationStructure ;
    umlmeta:oclConstraint "specializesFromLibrary('Connections::Connection')" ;
    umlmeta:oclConstraint "isSufficient" ;
    umlmeta:oclConstraint "ownedEndFeature->size() = 2 implies specializesFromLibrary('Connections::BinaryConnections')" .

sysml2:AllocationDefinition a owl:Class ;
    rdfs:label "AllocationDefinition"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Allocations" ;
    skos:definition "An AllocationDefinition is a ConnectionDefinition that specifies that some or all of the responsibility to realize the intent of the source is allocated to the target instances. Such allocations define mappings across the various structures and hierarchies of a system model, perhaps as a precursor to more rigorous specifications and implementations. An AllocationDefinition can itself be refined using nested allocations that give a finer-grained decomposition of the containing allocation mapping."@en ;
    rdfs:subClassOf sysml2:ConnectionDefinition ;
    umlmeta:oclConstraint "allocation = usage->selectAsKind(AllocationUsage)" ;
    umlmeta:oclConstraint "specializesFromLibrary('Allocations::Allocation')" .

sysml2:ItemUsage a owl:Class ;
    rdfs:label "ItemUsage"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Items" ;
    skos:definition "An ItemUsage is a ItemUsage whose definition is a Structure . Nominally, if the definition is an ItemDefinition , an ItemUsage is a ItemUsage of that ItemDefinition within a system. However, other kinds of Kernel Structures are also allowed, to permit use of Structures from the Kernel Model Libraries."@en ;
    rdfs:subClassOf sysml2:OccurrenceUsage ;
    umlmeta:oclConstraint "itemDefinition = occurrenceDefinition->selectByKind(Structure)" ;
    umlmeta:oclConstraint "specializesFromLibrary('Items::items')" ;
    umlmeta:oclConstraint "isComposite and owningType <> null and (owningType.oclIsKindOf(ItemDefinition) or owningType.oclIsKindOf(ItemUsage)) implies specializesFromLibrary('Items::Item::subitem')" .

sysml2:PartUsage a owl:Class ;
    rdfs:label "PartUsage"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Parts" ;
    skos:definition "A PartUsage is a usage of a PartDefinition to represent a system or a part of a system. At least one of the itemDefinitions of the PartUsage must be a PartDefinition . A PartUsage must subset, directly or indirectly, the base PartUsage parts from the Systems Model Library."@en ;
    rdfs:subClassOf sysml2:ItemUsage ;
    umlmeta:oclConstraint "owningFeatureMembership <> null and owningFeatureMembership.oclIsKindOf(ActorMembership) implies if owningType.oclIsKindOf(RequirementDefinition) or owningType.oclIsKindOf(RequirementUsage) then specializesFromLibrary('Requirements::RequirementCheck::actors') else specializesFromLibrary('Cases::Case::actors')" ;
    umlmeta:oclConstraint "specializesFromLibrary('Parts::parts')" ;
    umlmeta:oclConstraint "owningFeatureMembership <> null and owningFeatureMembership.oclIsKindOf(StakeholderMembership) implies specializesFromLibrary('Requirements::RequirementCheck::stakeholders')" ;
    umlmeta:oclConstraint "partDefinition->notEmpty()" ;
    umlmeta:oclConstraint "itemDefinition->selectByKind(PartDefinition)" ;
    umlmeta:oclConstraint "isComposite and owningType <> null and (owningType.oclIsKindOf(ItemDefinition) or owningType.oclIsKindOf(ItemUsage)) implies specializesFromLibrary('Items::Item::subparts')" .

sysml2:Connector a owl:Class ;
    rdfs:label "Connector"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Connectors" ;
    skos:definition "A Connector is a usage of Associations , with links restricted according to instances of the Type in which they are used (domain of the Connector ). The associations of the Connector restrict what kinds of things might be linked. The Connector further restricts these links to be between values of Features on instances of its domain."@en ;
    rdfs:subClassOf sysml2:Feature ;
    rdfs:subClassOf sysml2:Relationship ;
    umlmeta:oclConstraint "connectorEnd->size() = 2 implies specializesFromLibrary('Links::binaryLinks')" ;
    umlmeta:oclConstraint "sourceFeature = if relatedFeature->isEmpty() then null else relatedFeature->first() endif" ;
    umlmeta:oclConstraint "relatedFeature->forAll(f | if featuringType->isEmpty() then f.isFeaturedWithin(null) else featuringType->forAll(t | f.isFeaturedWithin(t)) endif)" ;
    umlmeta:oclConstraint "targetFeature = if relatedFeature->size() subSequence(2, relatedFeature->size())-> asOrderedSet() endif" ;
    umlmeta:oclConstraint "association->exists(oclIsKindOf(AssociationStructure)) implies specializesFromLibrary('Objects::linkObjects')" ;
    umlmeta:oclConstraint "connectorEnds->size() > 2 implies not specializesFromLibrary('Links::BinaryLink')" ;
    umlmeta:oclConstraint "relatedFeature = connectorEnd.ownedReferenceSubsetting-> select(s | s <> null).subsettedFeature" ;
    umlmeta:oclConstraint "specializesFromLibrary('Links::links')" ;
    umlmeta:oclConstraint "not isAbstract implies relatedFeature->size() >= 2" ;
    umlmeta:oclConstraint "let commonFeaturingTypes : OrderedSet(Type) = relatedFeature->closure(featuringType)->select(t | relatedFeature->forAll(f | f.isFeaturedWithin(t)) ) in let nearestCommonFeaturingTypes : OrderedSet(Type) = commonFeaturingTypes->reject(t1 | commonFeaturingTypes->exists(t2 | t2 <> t1 and t2->closure(featuringType)->contains(t1) )) in if nearestCommonFeaturingTypes->isEmpty() then null else nearestCommonFeaturingTypes->first() endif" ;
    umlmeta:oclConstraint "connectorEnds->size() = 2 and association->exists(oclIsKindOf(AssociationStructure)) implies specializesFromLibrary('Objects::binaryLinkObjects')" .

sysml2:ConnectorAsUsage a owl:Class ;
    rdfs:label "ConnectorAsUsage"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Connections" ;
    umlmeta:abstract true ;
    skos:definition "A ConnectorAsUsage is both a Connector and a Usage . ConnectorAsUsage cannot itself be instantiated in a SysML model, but it is a base class for the concrete classes BindingConnectorAsUsage , SuccessionAsUsage , ConnectionUsage and FlowConnectionUsage ."@en ;
    rdfs:subClassOf sysml2:Usage ;
    rdfs:subClassOf sysml2:Connector ;
    umlmeta:oclConstraint "nestedView = nestedUsage->selectByKind(ViewUsage)" ;
    umlmeta:oclConstraint "isVariation implies isAbstract" ;
    umlmeta:oclConstraint "usage = feature->selectByKind(Usage)" ;
    umlmeta:oclConstraint "ownedNested = nestedUsage->selectByKind(EnumerationUsage)" ;
    umlmeta:oclConstraint "nestedConstraint = nestedUsage->selectByKind(ConstraintUsage)" ;
    umlmeta:oclConstraint "nestedOccurrence = nestedUsage->selectByKind(OccurrenceUsage)" ;
    umlmeta:oclConstraint "nestedViewpoint = nestedUsage->selectByKind(ViewpointUsage)" ;
    umlmeta:oclConstraint "nestedAction = nestedUsage->selectByKind(ActionUsage)" ;
    umlmeta:oclConstraint "nestedFlow = nestedUsage->selectByKind(FlowConnectionUsage)" ;
    umlmeta:oclConstraint "owningVariationUsage <> null implies specializes(owningVariationUsage)" ;
    umlmeta:oclConstraint "isVariation implies ownedFeatureMembership->isEmpty()" ;
    umlmeta:oclConstraint "nestedItem = nestedUsage->selectByKind(ItemUsage)" ;
    umlmeta:oclConstraint "isVariation implies not ownedSpecialization.specific->exists( oclIsKindOf(Definition) and oclAsType(Definition).isVariation or oclIsKindOf(Usage) and oclAsType(Usage).isVariation)" ;
    umlmeta:oclConstraint "nestedState = nestedUsage->selectByKind(StateUsage)" ;
    umlmeta:oclConstraint "nestedConcern = nestedUsage->selectByKind(ConcernUsage)" ;
    umlmeta:oclConstraint "nestedVerificationCase = nestedUsage->selectByKind(VerificationCaseUsage)" ;
    umlmeta:oclConstraint "nestedCalculation = nestedUsage->selectByKind(CalculationUsage)" ;
    umlmeta:oclConstraint "nestedAttribute = nestedUsage->selectByKind(AttributeUsage)" ;
    umlmeta:oclConstraint "directedUsage = directedFeature->selectByKind(Usage)" ;
    umlmeta:oclConstraint "nestedPart = nestedUsage->selectByKind(PartUsage)" ;
    umlmeta:oclConstraint "nestedMetadata = nestedUsage->selectByKind(MetadataUsage)" ;
    umlmeta:oclConstraint "nestedAllocation = nestedUsage->selectByKind(AllocationUsage)" ;
    umlmeta:oclConstraint "nestedUsage = ownedFeature->selectByKind(Usage)" ;
    umlmeta:oclConstraint "nestedRendering = nestedUsage->selectByKind(RenderingUsage)" ;
    umlmeta:oclConstraint "nestedConnection = nestedUsage->selectByKind(ConnectorAsUsage)" ;
    umlmeta:oclConstraint "variantMembership = ownedMembership->selectByKind(VariantMembership)" ;
    umlmeta:oclConstraint "nestedReference = nestedUsage->selectByKind(ReferenceUsage)" ;
    umlmeta:oclConstraint "nestedUseCase = nestedUsage->selectByKind(UseCaseUsage)" ;
    umlmeta:oclConstraint "mayTimeVary = owningType <> null and owningType.specializesFromLibrary('Occurrences::Occurrence') and not ( isPortion or specializesFromLibrary('Links::SelfLink') or specializesFromLibrary('Occurrences::HappensLink') or isComposite and specializesFromLibrary('Actions::Action') )" ;
    umlmeta:oclConstraint "nestedRequirement = nestedUsage->selectByKind(RequirementUsage)" ;
    umlmeta:oclConstraint "nestedPort = nestedUsage->selectByKind(PortUsage)" ;
    umlmeta:oclConstraint "direction <> null or isEnd or featuringType->isEmpty() implies isReference" ;
    umlmeta:oclConstraint "nestedTransition = nestedUsage->selectByKind(TransitionUsage)" ;
    umlmeta:oclConstraint "nestedInterface = nestedUsage->selectByKind(ReferenceUsage)" ;
    umlmeta:oclConstraint "nestedAnalysisCase = nestedUsage->selectByKind(AnalysisCaseUsage)" ;
    umlmeta:oclConstraint "nestedCase = nestedUsage->selectByKind(CaseUsage)" ;
    umlmeta:oclConstraint "isReference = not isComposite" ;
    umlmeta:oclConstraint "variant = variantMembership.ownedVariantUsage" ;
    umlmeta:oclConstraint "owningVariationDefinition <> null implies specializes(owningVariationDefinition)" ;
    umlmeta:oclConstraint "owningVariationUsage <> null implies featuringType->asSet() = owningVariationUsage.featuringType->asSet()" .

sysml2:ConnectionUsage a owl:Class ;
    rdfs:label "ConnectionUsage"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Connections" ;
    skos:definition "A ConnectionUsage is a ConnectorAsUsage that is also a PartUsage . Nominally, if its type is a ConnectionDefinition , then a ConnectionUsage is a Usage of that ConnectionDefinition , representing a connection between parts of a system. However, other kinds of kernel AssociationStructures are also allowed, to permit use of AssociationStructures from the Kernel Model Libraries."@en ;
    rdfs:subClassOf sysml2:PartUsage ;
    rdfs:subClassOf sysml2:ConnectorAsUsage ;
    umlmeta:oclConstraint "specializesFromLibrary('Connections::connections')" ;
    umlmeta:oclConstraint "ownedEndFeature->size() = 2 implies specializesFromLibrary('Connections::binaryConnections')" .

sysml2:AllocationUsage a owl:Class ;
    rdfs:label "AllocationUsage"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Allocations" ;
    skos:definition "An AllocationUsage is a usage of an AllocationDefinition asserting the allocation of the source feature to the target feature."@en ;
    rdfs:subClassOf sysml2:ConnectionUsage ;
    umlmeta:oclConstraint "specializesFromLibrary('Allocations::allocations')" .

sysml2:Function a owl:Class ;
    rdfs:label "Function"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Functions" ;
    skos:definition "A Function is a Behavior that has an out parameter that is identified as its result . A Function represents the performance of a calculation that produces the values of its result parameter . This calculation may be decomposed into Expressions that are steps of the Function ."@en ;
    rdfs:subClassOf sysml2:Behavior ;
    umlmeta:oclConstraint "featureMembership-> selectByKind(ReturnParameterMembership)-> size() = 1" ;
    umlmeta:oclConstraint "ownedMembership.selectByKind(ResultExpressionMembership)-> forAll(mem | ownedFeature.selectByKind(BindingConnector)-> exists(binding | binding.relatedFeature->includes(result) and binding.relatedFeature->includes(mem.ownedResultExpression.result)))" ;
    umlmeta:oclConstraint "result = let resultParams : Sequence(Feature) = featureMemberships-> selectByKind(ReturnParameterMembership). ownedMemberParameter in if resultParams->notEmpty() then resultParams->first() else null endif" ;
    umlmeta:oclConstraint "membership->selectByKind(ResultExpressionMembership)->size() <= 1" ;
    umlmeta:oclConstraint "specializesFromLibrary('Performances::Evaluation')" .

sysml2:CalculationDefinition a owl:Class ;
    rdfs:label "CalculationDefinition"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Calculations" ;
    skos:definition "A CalculationDefinition is an ActionDefinition that also defines a Function producing a result ."@en ;
    rdfs:subClassOf sysml2:ActionDefinition ;
    rdfs:subClassOf sysml2:Function ;
    umlmeta:oclConstraint "specializesFromLibrary('Calculations::Calculation')" ;
    umlmeta:oclConstraint "calculation = action->selectByKind(CalculationUsage)" .

sysml2:CaseDefinition a owl:Class ;
    rdfs:label "CaseDefinition"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Cases" ;
    skos:definition "A CaseDefinition is a CalculationDefinition for a process, often involving collecting evidence or data, relative to a subject, possibly involving the collaboration of one or more other actors, producing a result that meets an objective."@en ;
    rdfs:subClassOf sysml2:CalculationDefinition ;
    umlmeta:oclConstraint "specializesFromLibrary('Cases::Case')" ;
    umlmeta:oclConstraint "input->notEmpty() and input->first() = subjectParameter" ;
    umlmeta:oclConstraint "featureMembership-> selectByKind(ObjectiveMembership)-> size() <= 1" ;
    umlmeta:oclConstraint "actorParameter = featureMembership-> selectByKind(ActorMembership). ownedActorParameter" ;
    umlmeta:oclConstraint "featureMembership->selectByKind(SubjectMembership)->size() <= 1" ;
    umlmeta:oclConstraint "objectiveRequirement = let objectives: OrderedSet(RequirementUsage) = featureMembership-> selectByKind(ObjectiveMembership). ownedRequirement in if objectives->isEmpty() then null else objectives->first().ownedObjectiveRequirement endif" ;
    umlmeta:oclConstraint "subjectParameter = let subjectMems : OrderedSet(SubjectMembership) = featureMembership->selectByKind(SubjectMembership) in if subjectMems->isEmpty() then null else subjectMems->first().ownedSubjectParameter endif" .

sysml2:AnalysisCaseDefinition a owl:Class ;
    rdfs:label "AnalysisCaseDefinition"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "AnalysisCases" ;
    skos:definition "An AnalysisCaseDefinition is a CaseDefinition for the case of carrying out an analysis."@en ;
    rdfs:subClassOf sysml2:CaseDefinition ;
    umlmeta:oclConstraint "resultExpression = let results : OrderedSet(ResultExpressionMembership) = featureMembersip-> selectByKind(ResultExpressionMembership) in if results->isEmpty() then null else results->first().ownedResultExpression endif" ;
    umlmeta:oclConstraint "specializesFromLibrary('AnalysisCases::AnalysisCase')" .

sysml2:Expression a owl:Class ;
    rdfs:label "Expression"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Functions" ;
    skos:definition "An Expression is a Step that is typed by a Function . An Expression that also has a Function as its featuringType is a computational step within that Function . An Expression always has a single result parameter, which redefines the result parameter of its defining function . This allows Expressions to be interconnected in tree structures, in which inputs to each Expression in the tree are determined as the results of other Expression in the tree."@en ;
    rdfs:subClassOf sysml2:Step ;
    umlmeta:oclConstraint "featureMembership-> selectByKind(ReturnParameterMembership)-> size() = 1" ;
    umlmeta:oclConstraint "isModelLevelEvaluable = modelLevelEvaluable(Set(Element){})" ;
    umlmeta:oclConstraint "result = let resultParams : Sequence(Feature) = featureMemberships-> selectByKind(ReturnParameterMembership). ownedMemberParameter in if resultParams->notEmpty() then resultParams->first() else null endif" ;
    umlmeta:oclConstraint "ownedMembership.selectByKind(ResultExpressionMembership)-> forAll(mem | ownedFeature.selectByKind(BindingConnector)-> exists(binding | binding.relatedFeature->includes(result) and binding.relatedFeature->includes(mem.ownedResultExpression.result)))" ;
    umlmeta:oclConstraint "specializesFromLibrary('Performances::evaluations')" ;
    umlmeta:oclConstraint "owningMembership <> null and owningMembership.oclIsKindOf(FeatureValue) implies let featureWithValue : Feature = owningMembership.oclAsType(FeatureValue).featureWithValue in featuringType = featureWithValue.featuringType" ;
    umlmeta:oclConstraint "membership->selectByKind(ResultExpressionMembership)->size() <= 1" .

sysml2:CalculationUsage a owl:Class ;
    rdfs:label "CalculationUsage"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Calculations" ;
    skos:definition "A CalculationUsage is an ActionUsage that is also an Expression , and, so, is typed by a Function . Nominally, if the type is a CalculationDefinition , a CalculationUsage is a Usage of that CalculationDefinition within a system. However, other kinds of kernel Functions are also allowed, to permit use of Functions from the Kernel Model Libraries."@en ;
    rdfs:subClassOf sysml2:ActionUsage ;
    rdfs:subClassOf sysml2:Expression ;
    umlmeta:oclConstraint "specializesFromLibrary('Calculations::calculations')" ;
    umlmeta:oclConstraint "owningType <> null and (owningType.oclIsKindOf(CalculationDefinition) or owningType.oclIsKindOf(CalculationUsage)) implies specializesFromLibrary('Calculations::Calculation::subcalculations')" .

sysml2:CaseUsage a owl:Class ;
    rdfs:label "CaseUsage"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Cases" ;
    skos:definition "A CaseUsage is a Usage of a CaseDefinition ."@en ;
    rdfs:subClassOf sysml2:CalculationUsage ;
    umlmeta:oclConstraint "input->notEmpty() and input->first() = subjectParameter" ;
    umlmeta:oclConstraint "subjectParameter = let subjects : OrderedSet(SubjectMembership) = featureMembership->selectByKind(SubjectMembership) in if subjects->isEmpty() then null else subjects->first().ownedSubjectParameter endif" ;
    umlmeta:oclConstraint "specializesFromLibrary('Cases::cases')" ;
    umlmeta:oclConstraint "actorParameter = featureMembership-> selectByKind(ActorMembership). ownedActorParameter" ;
    umlmeta:oclConstraint "objectiveRequirement = let objectives: OrderedSet(RequirementUsage) = featureMembership-> selectByKind(ObjectiveMembership). ownedRequirement in if objectives->isEmpty() then null else objectives->first().ownedObjectiveRequirement endif" ;
    umlmeta:oclConstraint "featureMembership-> selectByKind(ObjectiveMembership)-> size() <= 1" ;
    umlmeta:oclConstraint "featureMembership-> selectByKind(SubjectMembership)-> size() <= 1" ;
    umlmeta:oclConstraint "isComposite and owningType <> null and (owningType.oclIsKindOf(CaseDefinition) or owningType.oclIsKindOf(CaseUsage)) implies specializesFromLibrary('Cases::Case::subcases')" .

sysml2:AnalysisCaseUsage a owl:Class ;
    rdfs:label "AnalysisCaseUsage"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "AnalysisCases" ;
    skos:definition "An AnalysisCaseUsage is a Usage of an AnalysisCaseDefinition ."@en ;
    rdfs:subClassOf sysml2:CaseUsage ;
    umlmeta:oclConstraint "specializesFromLibrary('AnalysisCases::analysisCases')" ;
    umlmeta:oclConstraint "resultExpression = let results : OrderedSet(ResultExpressionMembership) = featureMembersip-> selectByKind(ResultExpressionMembership) in if results->isEmpty() then null else results->first().ownedResultExpression endif" ;
    umlmeta:oclConstraint "isComposite and owningType <> null and (owningType.oclIsKindOf(AnalysisCaseDefinition) or owningType.oclIsKindOf(AnalysisCaseUsage)) implies specializesFromLibrary('AnalysisCases::AnalysisCase::subAnalysisCases')" .

sysml2:AnnotatingElement a owl:Class ;
    rdfs:label "AnnotatingElement"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Annotations" ;
    skos:definition "An AnnotatingElement is an Element that provides additional description of or metadata on some other Element . An AnnotatingElement is either attached to its annotatedElements by Annotation Relationships , or it implicitly annotates its owningNamespace ."@en ;
    rdfs:subClassOf sysml2:Element ;
    umlmeta:oclConstraint "annotation = if owningAnnotatingRelationship = null then ownedAnnotatingRelationship else owningAnnotatingRelationship->prepend(owningAnnotatingRelationship) endif" ;
    umlmeta:oclConstraint "annotatedElement = if annotation->notEmpty() then annotation.annotatedElement else Sequence{owningNamespace} endif" ;
    umlmeta:oclConstraint "ownedAnnotatingRelationship = ownedRelationship-> selectByKind(Annotation)-> select(a | a.annotatedElement <> self)" .

sysml2:Annotation a owl:Class ;
    rdfs:label "Annotation"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Annotations" ;
    skos:definition "An Annotation is a Relationship between an AnnotatingElement and the Element that is annotated by that AnnotatingElement ."@en ;
    rdfs:subClassOf sysml2:Relationship ;
    umlmeta:oclConstraint "ownedAnnotatingElement = let ownedAnnotatingElements : Sequence(AnnotatingElement) = ownedRelatedElement->selectByKind(AnnotatingElement) in if ownedAnnotatingElements->isEmpty() then null else ownedAnnotatingElements->first() endif" ;
    umlmeta:oclConstraint "ownedAnnotatingElement <> null xor owningAnnotatingElement <> null" ;
    umlmeta:oclConstraint "(owningAnnotatedElement <> null) = (ownedAnnotatingElement <> null)" ;
    umlmeta:oclConstraint "annotatingElement = if ownedAnnotatingElement <> null then ownedAnnotatingElement else owningAnnotatingElement endif" .

sysml2:BooleanExpression a owl:Class ;
    rdfs:label "BooleanExpression"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Functions" ;
    skos:definition "A BooleanExpression is a Boolean -valued Expression whose type is a Predicate . It represents a logical condition resulting from the evaluation of the Predicate ."@en ;
    rdfs:subClassOf sysml2:Expression ;
    umlmeta:oclConstraint "specializesFromLibrary('Performances::booleanEvaluations')" .

sysml2:Invariant a owl:Class ;
    rdfs:label "Invariant"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Functions" ;
    skos:definition "An Invariant is a BooleanExpression that is asserted to have a specific Boolean result value. If isNegated = false , then the result is asserted to be true. If isNegated = true , then the result is asserted to be false."@en ;
    rdfs:subClassOf sysml2:BooleanExpression ;
    umlmeta:oclConstraint "if isNegated then specializesFromLibrary('Performances::falseEvaluations') else specializesFromLibrary('Performances::trueEvaluations') endif" .

sysml2:ConstraintUsage a owl:Class ;
    rdfs:label "ConstraintUsage"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Constraints" ;
    skos:definition "A ConstraintUsage is an OccurrenceUsage that is also a BooleanExpression , and, so, is typed by a Predicate . Nominally, if the type is a ConstraintDefinition , a ConstraintUsage is a Usage of that ConstraintDefinition . However, other kinds of kernel Predicates are also allowed, to permit use of Predicates from the Kernel Model Libraries."@en ;
    rdfs:subClassOf sysml2:BooleanExpression ;
    rdfs:subClassOf sysml2:OccurrenceUsage ;
    umlmeta:oclConstraint "owningType <> null and (owningType.oclIsKindOf(ItemDefinition) or owningType.oclIsKindOf(ItemUsage)) implies specializesFromLibrary('Items::Item::checkedConstraints')" ;
    umlmeta:oclConstraint "specializesFromLibrary('Constraints::constraintChecks')" ;
    umlmeta:oclConstraint "owningFeatureMembership <> null and owningFeatureMembership.oclIsKindOf(RequirementConstraintMembership) implies if owningFeatureMembership.oclAsType(RequirementConstraintMembership).kind = RequirementConstraintKind::assumption then specializesFromLibrary('Requirements::RequirementCheck::assumptions') else specializesFromLibrary('Requirements::RequirementCheck::constraints') endif" .

sysml2:AssertConstraintUsage a owl:Class ;
    rdfs:label "AssertConstraintUsage"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Constraints" ;
    skos:definition "An AssertConstraintUsage is a ConstraintUsage that is also an Invariant and, so, is asserted to be true (by default). Unless it is the AssertConstraintUsage itself, the asserted ConstraintUsage is related to the AssertConstraintUsage by a ReferenceSubsetting Relationship ."@en ;
    rdfs:subClassOf sysml2:Invariant ;
    rdfs:subClassOf sysml2:ConstraintUsage ;
    umlmeta:oclConstraint "assertedConstraint = if referencedFeatureTarget() = null then self else if referencedFeatureTarget().oclIsKindOf(ConstraintUsage) then referencedFeatureTarget().oclAsType(ConstraintUsage) else null endif endif" ;
    umlmeta:oclConstraint "if isNegated then specializesFromLibrary('Constraints::negatedConstraintChecks') else specializesFromLibrary('Constraints::assertedConstraintChecks') endif" ;
    umlmeta:oclConstraint "referencedFeaureTarget() <> null implies referencedFeatureTarget().oclIsKindOf(ConstraintUsage)" .

sysml2:AssignmentActionUsage a owl:Class ;
    rdfs:label "AssignmentActionUsage"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Actions" ;
    skos:definition "An AssignmentActionUsage is an ActionUsage that is defined, directly or indirectly, by the ActionDefinition AssignmentAction from the Systems Model Library. It specifies that the value of the referent Feature , relative to the target given by the result of the targetArgument Expression , should be set to the result of the valueExpression ."@en ;
    rdfs:subClassOf sysml2:ActionUsage ;
    umlmeta:oclConstraint "let targetParameter : Feature = inputParameter(1) in targetParameter <> null and targetParameter.ownedFeature->notEmpty() and targetParameter->first().ownedFeature->notEmpty() and targetParameter->first().ownedFeature->first(). redefines('AssigmentAction::target::startingAt::accessedFeature')" ;
    umlmeta:oclConstraint "let targetParameter : Feature = inputParameter(1) in targetParameter <> null and targetParameter.ownedFeature->notEmpty() and targetParameter.ownedFeature->first(). redefines('AssignmentAction::target::startingAt')" ;
    umlmeta:oclConstraint "valueExpression = argument(2)" ;
    umlmeta:oclConstraint "let targetParameter : Feature = inputParameter(1) in targetParameter <> null and targetParameter.ownedFeature->notEmpty() and targetParameter->first().ownedFeature->notEmpty() and targetParameter->first().ownedFeature->first().redefines(referent)" ;
    umlmeta:oclConstraint "ownedMembership->exists( not oclIsKindOf(OwningMembership) and memberElement.oclIsKindOf(Feature))" ;
    umlmeta:oclConstraint "referent <> null implies referent.featureTarget.mayTimeVary" ;
    umlmeta:oclConstraint "targetArgument = argument(1)" ;
    umlmeta:oclConstraint "isSubactionUsage() implies specializesFromLibrary('Actions::Action::assignments')" ;
    umlmeta:oclConstraint "specializesFromLibrary('Actions::assignmentActions')" ;
    umlmeta:oclConstraint "referent = let unownedFeatures : Sequence(Feature) = ownedMembership-> reject(oclIsKindOf(FeatureMembership)).memberElement-> selectByKind(Feature) in if unownedFeatures->isEmpty() then null else unownedFeatures->first().oclAsType(Feature) endif" .

sysml2:DataType a owl:Class ;
    rdfs:label "DataType"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "DataTypes" ;
    skos:definition "A DataType is a Classifier of things (in the universe) that can only be distinguished by how they are related to other things (via Features). This means multiple things classified by the same DataType Cannot be distinguished when they are related to other things in exactly the same way, even when they are intended to be about different things. Can be distinguished when they are related to other things in different ways, even when they are intended to be about the same thing."@en ;
    rdfs:subClassOf sysml2:Classifier ;
    umlmeta:oclConstraint "ownedSpecialization.general-> forAll(not oclIsKindOf(Class) and not oclIsKindOf(Association))" ;
    umlmeta:oclConstraint "specializesFromLibrary('Base::DataValue')" .

sysml2:AttributeDefinition a owl:Class ;
    rdfs:label "AttributeDefinition"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Attributes" ;
    skos:definition "An AttributeDefinition is a Definition and a DataType of information about a quality or characteristic of a system or part of a system that has no independent identity other than its value. All features of an AttributeDefinition must be referential (non-composite). As a DataType , an AttributeDefinition must specialize, directly or indirectly, the base DataType Base::DataValue from the Kernel Semantic Library."@en ;
    rdfs:subClassOf sysml2:DataType ;
    rdfs:subClassOf sysml2:Definition ;
    umlmeta:oclConstraint "feature->forAll(not isComposite)" .

sysml2:AttributeUsage a owl:Class ;
    rdfs:label "AttributeUsage"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Attributes" ;
    skos:definition "An AttributeUsage is a Usage whose type is a DataType . Nominally, if the type is an AttributeDefinition , an AttributeUsage is a usage of a AttributeDefinition to represent the value of some system quality or characteristic. However, other kinds of kernel DataTypes are also allowed, to permit use of DataTypes from the Kernel Model Libraries. An AttributeUsage itself as well as all its nested features must be referential (non-composite). An AttributeUsage must specialize, directly or indirectly, the base Feature Base::dataValues from the Kernel Semantic Library."@en ;
    rdfs:subClassOf sysml2:Usage ;
    umlmeta:oclConstraint "isReference" ;
    umlmeta:oclConstraint "specializesFromLibrary('Base::dataValues')" ;
    umlmeta:oclConstraint "feature->forAll(not isComposite)" .

sysml2:BindingConnector a owl:Class ;
    rdfs:label "BindingConnector"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Connectors" ;
    skos:definition "A BindingConnector is a binary Connector that requires its relatedFeatures to identify the same things (have the same values)."@en ;
    rdfs:subClassOf sysml2:Connector ;
    umlmeta:oclConstraint "relatedFeature->size() = 2" ;
    umlmeta:oclConstraint "specializesFromLibrary('Links::selfLinks')" .

sysml2:BindingConnectorAsUsage a owl:Class ;
    rdfs:label "BindingConnectorAsUsage"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Connections" ;
    skos:definition "A BindingConnectorAsUsage is both a BindingConnector and a ConnectorAsUsage ."@en ;
    rdfs:subClassOf sysml2:BindingConnector ;
    rdfs:subClassOf sysml2:ConnectorAsUsage ;
    umlmeta:oclConstraint "relatedFeature->size() = 2" ;
    umlmeta:oclConstraint "specializesFromLibrary('Links::selfLinks')" .

sysml2:InstantiationExpression a owl:Class ;
    rdfs:label "InstantiationExpression"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Expressions" ;
    umlmeta:abstract true ;
    skos:definition "An InstantiationExpression is an Expression that instantiates its instantiatedType , binding some or all of the features of that Type to the results of its arguments . InstantiationExpression is abstract, with concrete subclasses InvocationExpression and ConstructorExpression ."@en ;
    rdfs:subClassOf sysml2:Expression ;
    umlmeta:oclConstraint "instantiatedType = instantiatedType()" ;
    umlmeta:oclConstraint "result.owningType = self" ;
    umlmeta:oclConstraint "instantiatedType() <> null" .

sysml2:InvocationExpression a owl:Class ;
    rdfs:label "InvocationExpression"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Expressions" ;
    skos:definition "An InvocationExpression is an InstantiationExpression whose instantiatedType must be a Behavior or a Feature typed by a single Behavior (such as a Step ). Each of the input parameters of the instantiatedType are bound to the result of an argument Expression . If the instantiatedType is a Function or a Feature typed by a Function , then the result of the InvocationExpression is the result of the invoked Function . Otherwise, the result is an instance of the instantiatedType (essentially like a behavioral ConstructorExpression )."@en ;
    rdfs:subClassOf sysml2:InstantiationExpression ;
    umlmeta:oclConstraint "let parameters : OrderedSet(Feature) = instantiatedType.input in input->forAll(inp | inp.ownedRedefinition.redefinedFeature-> intersection(parameters)->size() = 1)" ;
    umlmeta:oclConstraint "not instantiatedType.oclIsKindOf(Function) and not (instantiatedType.oclIsKindOf(Feature) and instantiatedType.oclAsType(Feature).type->exists(oclIsKindOf(Function))) implies result.specializes(instantiatedType)" ;
    umlmeta:oclConstraint "let features : OrderedSet(Feature) = instantiatedType.feature in input->forAll(inp1 | input->forAll(inp2 | inp1 <> inp2 implies inp1.ownedRedefinition.redefinedFeature-> intersection(inp2.ownedRedefinition.redefinedFeature)-> intersection(features)->isEmpty()))" ;
    umlmeta:oclConstraint "specializes(instantiatedType)" ;
    umlmeta:oclConstraint "instantiatedType.input->collect(inp | ownedFeatures->select(redefines(inp)).valuation-> select(v | v <> null).value )" ;
    umlmeta:oclConstraint "not instantiatedType.oclIsKindOf(Function) and not (instantiatedType.oclIsKindOf(Feature) and instantiatedType.oclAsType(Feature).type->exists(oclIsKindOf(Function))) implies ownedFeature.selectByKind(BindingConnector)->exists( relatedFeature->includes(self) and relatedFeature->includes(result))" ;
    umlmeta:oclConstraint "ownedFeature->forAll(f | f <> result implies f.direction = FeatureDirectionKind::_'in')" ;
    umlmeta:oclConstraint "TBD" ;
    umlmeta:oclConstraint "instantiatedType.oclIsKindOf(Behavior) or instantiatedType.oclIsKindOf(Feature) and instantiatedType.type->exists(oclIsKindOf(Behavior)) and instantiatedType.type->size(1)" .

sysml2:OperatorExpression a owl:Class ;
    rdfs:label "OperatorExpression"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Expressions" ;
    skos:definition "An OperatorExpression is an InvocationExpression whose function is determined by resolving its operator in the context of one of the standard packages from the Kernel Function Library."@en ;
    rdfs:subClassOf sysml2:InvocationExpression ;
    umlmeta:oclConstraint "let parameters : OrderedSet(Feature) = instantiatedType.input in input->forAll(inp | inp.ownedRedefinition.redefinedFeature-> intersection(parameters)->size() = 1)" ;
    umlmeta:oclConstraint "not instantiatedType.oclIsKindOf(Function) and not (instantiatedType.oclIsKindOf(Feature) and instantiatedType.oclAsType(Feature).type->exists(oclIsKindOf(Function))) implies result.specializes(instantiatedType)" ;
    umlmeta:oclConstraint "let features : OrderedSet(Feature) = instantiatedType.feature in input->forAll(inp1 | input->forAll(inp2 | inp1 <> inp2 implies inp1.ownedRedefinition.redefinedFeature-> intersection(inp2.ownedRedefinition.redefinedFeature)-> intersection(features)->isEmpty()))" ;
    umlmeta:oclConstraint "specializes(instantiatedType)" ;
    umlmeta:oclConstraint "instantiatedType.input->collect(inp | ownedFeatures->select(redefines(inp)).valuation-> select(v | v <> null).value )" ;
    umlmeta:oclConstraint "not instantiatedType.oclIsKindOf(Function) and not (instantiatedType.oclIsKindOf(Feature) and instantiatedType.oclAsType(Feature).type->exists(oclIsKindOf(Function))) implies ownedFeature.selectByKind(BindingConnector)->exists( relatedFeature->includes(self) and relatedFeature->includes(result))" ;
    umlmeta:oclConstraint "ownedFeature->forAll(f | f <> result implies f.direction = FeatureDirectionKind::_'in')" ;
    umlmeta:oclConstraint "TBD" ;
    umlmeta:oclConstraint "instantiatedType.oclIsKindOf(Behavior) or instantiatedType.oclIsKindOf(Feature) and instantiatedType.type->exists(oclIsKindOf(Behavior)) and instantiatedType.type->size(1)" .

sysml2:CollectExpression a owl:Class ;
    rdfs:label "CollectExpression"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Expressions" ;
    skos:definition "A CollectExpression is an OperatorExpression whose operator is \"collect\" , which resolves to the Function ControlFunctions::collect from the Kernel Functions Library."@en ;
    rdfs:subClassOf sysml2:OperatorExpression ;
    umlmeta:oclConstraint "operator = 'collect'" .

sysml2:Comment a owl:Class ;
    rdfs:label "Comment"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Annotations" ;
    skos:definition "A Comment is an AnnotatingElement whose body in some way describes its annotatedElements ."@en ;
    rdfs:subClassOf sysml2:AnnotatingElement ;
    umlmeta:oclConstraint "annotation = if owningAnnotatingRelationship = null then ownedAnnotatingRelationship else owningAnnotatingRelationship->prepend(owningAnnotatingRelationship) endif" ;
    umlmeta:oclConstraint "annotatedElement = if annotation->notEmpty() then annotation.annotatedElement else Sequence{owningNamespace} endif" ;
    umlmeta:oclConstraint "ownedAnnotatingRelationship = ownedRelationship-> selectByKind(Annotation)-> select(a | a.annotatedElement <> self)" .

sysml2:Predicate a owl:Class ;
    rdfs:label "Predicate"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Functions" ;
    skos:definition "A Predicate is a Function whose result parameter has type Boolean and multiplicity 1..1 ."@en ;
    rdfs:subClassOf sysml2:Function ;
    umlmeta:oclConstraint "specializesFromLibrary('Performances::BooleanEvaluation')" .

sysml2:ConstraintDefinition a owl:Class ;
    rdfs:label "ConstraintDefinition"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Constraints" ;
    skos:definition "A ConstraintDefinition is an OccurrenceDefinition that is also a Predicate that defines a constraint that may be asserted to hold on a system or part of a system."@en ;
    rdfs:subClassOf sysml2:Predicate ;
    rdfs:subClassOf sysml2:OccurrenceDefinition ;
    umlmeta:oclConstraint "specializesFromLibrary('Constraints::ConstraintCheck')" .

sysml2:RequirementDefinition a owl:Class ;
    rdfs:label "RequirementDefinition"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Requirements" ;
    skos:definition "A RequirementDefinition is a ConstraintDefinition that defines a requirement used in the context of a specification as a constraint that a valid solution must satisfy. The specification is relative to a specified subject, possibly in collaboration with one or more external actors."@en ;
    rdfs:subClassOf sysml2:ConstraintDefinition ;
    umlmeta:oclConstraint "subjectParameter = let subjects : OrderedSet(SubjectMembership) = featureMembership->selectByKind(SubjectMembership) in if subjects->isEmpty() then null else subjects->first().ownedSubjectParameter endif" ;
    umlmeta:oclConstraint "featureMembership-> selectByKind(SubjectMembership)-> size() <= 1" ;
    umlmeta:oclConstraint "input->notEmpty() and input->first() = subjectParameter" ;
    umlmeta:oclConstraint "text = documentation.body" ;
    umlmeta:oclConstraint "actorParameter = featureMembership-> selectByKind(ActorMembership). ownedActorParameter" ;
    umlmeta:oclConstraint "requiredConstraint = ownedFeatureMembership-> selectByKind(RequirementConstraintMembership)-> select(kind = RequirementConstraintKind::requirement). ownedConstraint" ;
    umlmeta:oclConstraint "assumedConstraint = ownedFeatureMembership-> selectByKind(RequirementConstraintMembership)-> select(kind = RequirementConstraintKind::assumption). ownedConstraint" ;
    umlmeta:oclConstraint "specializesFromLibrary('Requirements::RequirementCheck')" ;
    umlmeta:oclConstraint "framedConcern = featureMembership-> selectByKind(FramedConcernMembership). ownedConcern" ;
    umlmeta:oclConstraint "stakeholderParameter = featureMembership-> selectByKind(StakholderMembership). ownedStakeholderParameter" .

sysml2:ConcernDefinition a owl:Class ;
    rdfs:label "ConcernDefinition"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Requirements" ;
    skos:definition "A ConcernDefinition is a RequirementDefinition that one or more stakeholders may be interested in having addressed. These stakeholders are identified by the ownedStakeholders of the ConcernDefinition ."@en ;
    rdfs:subClassOf sysml2:RequirementDefinition ;
    umlmeta:oclConstraint "specializesFromLibrary('Requirements::ConcernCheck')" .

sysml2:RequirementUsage a owl:Class ;
    rdfs:label "RequirementUsage"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Requirements" ;
    skos:definition "A RequirementUsage is a Usage of a RequirementDefinition ."@en ;
    rdfs:subClassOf sysml2:ConstraintUsage ;
    umlmeta:oclConstraint "isComposite and owningType <> null and (owningType.oclIsKindOf(RequirementDefinition) or owningType.oclIsKindOf(RequirementUsage)) implies specializesFromLibrary('Requirements::RequirementCheck::subrequirements')" ;
    umlmeta:oclConstraint "owningfeatureMembership <> null and owningfeatureMembership.oclIsKindOf(ObjectiveMembership) implies owningType.ownedSpecialization.general->forAll(gen | (gen.oclIsKindOf(CaseDefinition) implies redefines(gen.oclAsType(CaseDefinition).objectiveRequirement)) and (gen.oclIsKindOf(CaseUsage) implies redefines(gen.oclAsType(CaseUsage).objectiveRequirement))" ;
    umlmeta:oclConstraint "requiredConstraint = ownedFeatureMembership-> selectByKind(RequirementConstraintMembership)-> select(kind = RequirementConstraintKind::requirement). ownedConstraint" ;
    umlmeta:oclConstraint "actorParameter = featureMembership-> selectByKind(ActorMembership). ownedActorParameter" ;
    umlmeta:oclConstraint "stakeholderParameter = featureMembership-> selectByKind(AStakholderMembership). ownedStakeholderParameter" ;
    umlmeta:oclConstraint "input->notEmpty() and input->first() = subjectParameter" ;
    umlmeta:oclConstraint "framedConcern = featureMembership-> selectByKind(FramedConcernMembership). ownedConcern" ;
    umlmeta:oclConstraint "subjectParameter = let subjects : OrderedSet(SubjectMembership) = featureMembership->selectByKind(SubjectMembership) in if subjects->isEmpty() then null else subjects->first().ownedSubjectParameter endif" ;
    umlmeta:oclConstraint "text = documentation.body" ;
    umlmeta:oclConstraint "specializesFromLibrary('Requirements::requirementChecks')" ;
    umlmeta:oclConstraint "owningFeatureMembership <> null and owningFeatureMembership.oclIsKindOf(RequirementVerificationMembership) implies specializesFromLibrary('VerificationCases::VerificationCase::obj::requirementVerifications')" ;
    umlmeta:oclConstraint "assumedConstraint = ownedFeatureMembership-> selectByKind(RequirementConstraintMembership)-> select(kind = RequirementConstraintKind::assumption). ownedConstraint" ;
    umlmeta:oclConstraint "featureMembership-> selectByKind(SubjectMembership)-> size() <= 1" .

sysml2:ConcernUsage a owl:Class ;
    rdfs:label "ConcernUsage"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Requirements" ;
    skos:definition "A ConcernUsage is a Usage of a ConcernDefinition . The ownedStakeholder features of the ConcernUsage shall all subset the ConcernCheck::concernedStakeholders feature. If the ConcernUsage is an ownedFeature of a StakeholderDefinition or StakeholderUsage, then the ConcernUsage shall have an ownedStakeholder feature that is bound to the self feature of its owner."@en ;
    rdfs:subClassOf sysml2:RequirementUsage ;
    umlmeta:oclConstraint "specializesFromLibrary('Requirements::concernChecks')" ;
    umlmeta:oclConstraint "owningFeatureMembership <> null and owningFeatureMembership.oclIsKindOf(FramedConcernMembership) implies specializesFromLibrary('Requirements::RequirementCheck::concerns')" .

sysml2:PortDefinition a owl:Class ;
    rdfs:label "PortDefinition"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Ports" ;
    skos:definition "A PortDefinition defines a point at which external entities can connect to and interact with a system or part of a system. Any ownedUsages of a PortDefinition , other than PortUsages , must not be composite."@en ;
    rdfs:subClassOf sysml2:Structure ;
    rdfs:subClassOf sysml2:OccurrenceDefinition ;
    umlmeta:oclConstraint "ownedUsage-> reject(oclIsKindOf(PortUsage))-> forAll(not isComposite)" ;
    umlmeta:oclConstraint "not oclIsKindOf(ConjugatedPortDefinition) implies ownedMember-> selectByKind(ConjugatedPortDefinition)-> size() = 1" ;
    umlmeta:oclConstraint "conjugatedPortDefinition = let conjugatedPortDefinitions : OrderedSet(ConjugatedPortDefinition) = ownedMember->selectByKind(ConjugatedPortDefinition) in if conjugatedPortDefinitions->isEmpty() then null else conjugatedPortDefinitions->first() endif" ;
    umlmeta:oclConstraint "specializesFromLibrary('Ports::Port')" .

sysml2:ConjugatedPortDefinition a owl:Class ;
    rdfs:label "ConjugatedPortDefinition"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Ports" ;
    skos:definition "A ConjugatedPortDefinition is a PortDefinition that is a PortDefinition of its original PortDefinition . That is, a ConjugatedPortDefinition inherits all the features of the original PortDefinition , but input flows of the original PortDefinition become outputs on the ConjugatedPortDefinition and output flows of the original PortDefinition become inputs on the ConjugatedPortDefinition . Every PortDefinition (that is not itself a ConjugatedPortDefinition ) has exactly one corresponding ConjugatedPortDefinition , whose effective name is the name of the originalPortDefinition , with the character ~ prepended."@en ;
    rdfs:subClassOf sysml2:PortDefinition ;
    umlmeta:oclConstraint "conjugatedPortDefinition = null" ;
    umlmeta:oclConstraint "ownedPortConjugator.originalPortDefinition = originalPortDefinition" .

sysml2:Specialization a owl:Class ;
    rdfs:label "Specialization"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Types" ;
    skos:definition "Specialization is a Relationship between two Types that requires all instances of the specific type to also be instances of the general Type (i.e., the set of instances of the specific Type is a subset of those of the general Type, which might be the same set)."@en ;
    rdfs:subClassOf sysml2:Relationship ;
    umlmeta:oclConstraint "not specific.isConjugated" .

sysml2:FeatureTyping a owl:Class ;
    rdfs:label "FeatureTyping"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Features" ;
    skos:definition "FeatureTyping is Specialization in which the specific Type is a Feature . This means the set of instances of the (specific) typedFeature is a subset of the set of instances of the (general) type . In the simplest case, the type is a Classifier , whereupon the typedFeature has values that are instances of the Classifier ."@en ;
    rdfs:subClassOf sysml2:Specialization ;
    umlmeta:oclConstraint "not specific.isConjugated" .

sysml2:ConjugatedPortTyping a owl:Class ;
    rdfs:label "ConjugatedPortTyping"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Ports" ;
    skos:definition "A ConjugatedPortTyping is a FeatureTyping whose type is a ConjugatedPortDefinition . (This relationship is intended to be an abstract-syntax marker for a special surface notation for conjugated typing of ports.)"@en ;
    rdfs:subClassOf sysml2:FeatureTyping ;
    umlmeta:oclConstraint "portDefinition = conjugatedPortDefinition.originalPortDefinition" .

sysml2:Conjugation a owl:Class ;
    rdfs:label "Conjugation"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Types" ;
    skos:definition "Conjugation is a Relationship between two types in which the conjugatedType inherits all the Features of the originalType , but with all input and output Features reversed. That is, any Features with a direction in relative to the originalType are considered to have an effective direction of out relative to the conjugatedType and, similarly, Features with direction out in the originalType are considered to have an effective direction of in in the conjugatedType . Features with direction inout , or with no direction , in the originalType , are inherited without chan...[truncated]"@en ;
    rdfs:subClassOf sysml2:Relationship ;
    umlmeta:oclConstraint "relatedElement = source->union(target)" .

sysml2:ConstructorExpression a owl:Class ;
    rdfs:label "ConstructorExpression"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Expressions" ;
    skos:definition "A ConstructorExpression is an InstantiationExpression whose result specializes its instantiatedType , binding some or all of the features of the instantiatedType to the results of its argument Expressions ."@en ;
    rdfs:subClassOf sysml2:InstantiationExpression ;
    umlmeta:oclConstraint "specializes('Performances::constructorEvaluations')" ;
    umlmeta:oclConstraint "TBD" ;
    umlmeta:oclConstraint "instantiatedType.feature->collect(f | result.ownedFeatures->select(redefines(f)).valuation-> select(v | v <> null).value )" ;
    umlmeta:oclConstraint "result.specializes(instantiatedType)" ;
    umlmeta:oclConstraint "let features : OrderedSet(Feature) = instantiatedType.feature-> select(visibility = VisibilityKind::public) in result.ownedFeature->forAll(f1 | result.ownedFeature->forAll(f2 | f1 <> f2 implies f1.ownedRedefinition.redefinedFeature-> intersection(f2.ownedRedefinition.redefinedFeature)-> intersection(features)->isEmpty()))" ;
    umlmeta:oclConstraint "ownedFeatures->excluding(result)->isEmpty()" ;
    umlmeta:oclConstraint "let features : OrderedSet(Feature) = instantiatedType.feature-> select(owningMembership.visibility = VisibilityKind::public) in result.ownedFeature->forAll(f | f.ownedRedefinition.redefinedFeature-> intersection(features)->size() = 1)" .

sysml2:ControlNode a owl:Class ;
    rdfs:label "ControlNode"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Actions" ;
    umlmeta:abstract true ;
    skos:definition "A ControlNode is an ActionUsage that does not have any inherent behavior but provides constraints on incoming and outgoing Successions that are used to control other Actions . A ControlNode must be a composite owned usage of an ActionDefinition or ActionUsage ."@en ;
    rdfs:subClassOf sysml2:ActionUsage ;
    umlmeta:oclConstraint "owningType <> null and (owningType.oclIsKindOf(ActionDefinition) or owningType.oclIsKindOf(ActionUsage))" ;
    umlmeta:oclConstraint "specializesFromLibrary('Action::Action::controls')" ;
    umlmeta:oclConstraint "targetConnector->selectByKind(Succession)-> collect(connectorEnd->at(2).multiplicity)-> forAll(targetMult | multiplicityHasBounds(targetMult, 1, 1))" ;
    umlmeta:oclConstraint "sourceConnector->selectByKind(Succession)-> collect(connectorEnd->at(1).multiplicity)-> forAll(sourceMult | multiplicityHasBounds(sourceMult, 1, 1))" ;
    umlmeta:oclConstraint "isComposite" .

sysml2:Subsetting a owl:Class ;
    rdfs:label "Subsetting"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Features" ;
    skos:definition "Subsetting is Specialization in which the specific and general Types are Features . This means all values of the subsettingFeature (on instances of its domain, i.e., the intersection of its featuringTypes ) are values of the subsettedFeature on instances of its domain. To support this the domain of the subsettingFeature must be the same or specialize (at least indirectly) the domain of the subsettedFeature (via Specialization ), and the co-domain (intersection of the types ) of the subsettingFeature must specialize the co-domain of the subsettedFeature ."@en ;
    rdfs:subClassOf sysml2:Specialization ;
    umlmeta:oclConstraint "subsettedFeature.isConstant and subsettingFeature.isVariable implies subsettingFeature.isConstant" ;
    umlmeta:oclConstraint "subsettedFeature.isUnique implies subsettingFeature.isUnique" ;
    umlmeta:oclConstraint "subsettingFeature.canAccess(subsettedFeature)" .

sysml2:CrossSubsetting a owl:Class ;
    rdfs:label "CrossSubsetting"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Features" ;
    skos:definition "CrossSubsetting is a kind of Subsetting for end Features , as identified by crossingFeature , to subset a chained Feature , identified by crossedFeature. It navigates to instances of the end Feature ’s type from instances of other end Feature types on the same owningType (at least two end Features are required for any of them to have a CrossSubsetting ). The crossedFeature of a CrossSubsetting must have a feature chain of exactly two Features . The second Feature in the chain is the crossFeature of the crossingFeature (end Feature ), which has the same type as the crossingFeature . When the owningType of the crossingFeature<...[truncated]"@en ;
    rdfs:subClassOf sysml2:Subsetting ;
    umlmeta:oclConstraint "crossingFeature.isEnd and crossingFeature.owningType <> null implies let endFeatures: Sequence(Feature) = crossingFeature.owningType.endFeature in let chainingFeatures: Sequence(Feature) = crossedFeature.chainingFeature in chainingFeatures->size() = 2 and endFeatures->size() = 2 implies chainingFeatures->at(1) = endFeatures->excluding(crossingFeature)->at(1)" ;
    umlmeta:oclConstraint "crossingFeature.isEnd and crossingFeature.owningType<>null and crossingFeature.owningType.endFeature ->size() > 1" .

sysml2:DecisionNode a owl:Class ;
    rdfs:label "DecisionNode"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Actions" ;
    skos:definition "A DecisionNode is a ControlNode that makes a selection from its outgoing Successions ."@en ;
    rdfs:subClassOf sysml2:ControlNode ;
    umlmeta:oclConstraint "targetConnector->selectByKind(Succession)->size() <= 1" ;
    umlmeta:oclConstraint "sourceConnector->selectAsKind(Succession)-> collect(connectorEnd->at(2))-> forAll(targetMult | multiplicityHasBounds(targetMult, 0, 1))" ;
    umlmeta:oclConstraint "specializesFromLibrary('Actions::Action::decisions')" ;
    umlmeta:oclConstraint "sourceConnector->selectByKind(Succession)-> forAll(subsetsChain(self, resolveGlobal('ControlPerformances::MergePerformance::outgoingHBLink')))" .

sysml2:Dependency a owl:Class ;
    rdfs:label "Dependency"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Dependencies" ;
    skos:definition "A Dependency is a Relationship that indicates that one or more client Elements require one more supplier Elements for their complete specification. In general, this means that a change to one of the supplier Elements may necessitate a change to, or re-specification of, the client Elements . Note that a Dependency is entirely a model-level Relationship , without instance-level semantics."@en ;
    rdfs:subClassOf sysml2:Relationship ;
    umlmeta:oclConstraint "relatedElement = source->union(target)" .

sysml2:Differencing a owl:Class ;
    rdfs:label "Differencing"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Types" ;
    skos:definition "Differencing is a Relationship that makes its differencingType one of the differencingTypes of its typeDifferenced ."@en ;
    rdfs:subClassOf sysml2:Relationship ;
    umlmeta:oclConstraint "relatedElement = source->union(target)" .

sysml2:Disjoining a owl:Class ;
    rdfs:label "Disjoining"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Types" ;
    skos:definition "A Disjoining is a Relationship between Types asserted to have interpretations that are not shared (disjoint) between them, identified as typeDisjoined and disjoiningType . For example, a Classifier for mammals is disjoint from a Classifier for minerals, and a Feature for people&#39;s parents is disjoint from a Feature for their children."@en ;
    rdfs:subClassOf sysml2:Relationship ;
    umlmeta:oclConstraint "relatedElement = source->union(target)" .

sysml2:Documentation a owl:Class ;
    rdfs:label "Documentation"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Annotations" ;
    skos:definition "Documentation is a Comment that specifically documents a documentedElement , which must be its owner ."@en ;
    rdfs:subClassOf sysml2:Comment ;
    umlmeta:oclConstraint "annotation = if owningAnnotatingRelationship = null then ownedAnnotatingRelationship else owningAnnotatingRelationship->prepend(owningAnnotatingRelationship) endif" ;
    umlmeta:oclConstraint "annotatedElement = if annotation->notEmpty() then annotation.annotatedElement else Sequence{owningNamespace} endif" ;
    umlmeta:oclConstraint "ownedAnnotatingRelationship = ownedRelationship-> selectByKind(Annotation)-> select(a | a.annotatedElement <> self)" .

sysml2:ElementFilterMembership a owl:Class ;
    rdfs:label "ElementFilterMembership"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Packages" ;
    skos:definition "ElementFilterMembership is a Membership between a Namespace and a model-level evaluable Boolean -valued Expression , asserting that imported members of the Namespace should be filtered using the condition Expression . A general Namespace does not define any specific filtering behavior, but such behavior may be defined for various specialized kinds of Namespaces ."@en ;
    rdfs:subClassOf sysml2:OwningMembership ;
    umlmeta:oclConstraint "condition.isModelLevelEvaluable" ;
    umlmeta:oclConstraint "condition.result.specializesFromLibrary('ScalarValues::Boolean')" .

sysml2:EndFeatureMembership a owl:Class ;
    rdfs:label "EndFeatureMembership"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Features" ;
    skos:definition "EndFeatureMembership is a FeatureMembership that requires its memberFeature be owned and have isEnd = true ."@en ;
    rdfs:subClassOf sysml2:FeatureMembership ;
    umlmeta:oclConstraint "ownedMemberFeature.isEnd" .

sysml2:EnumerationDefinition a owl:Class ;
    rdfs:label "EnumerationDefinition"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Enumerations" ;
    skos:definition "An EnumerationDefinition is an AttributeDefinition all of whose instances are given by an explicit list of enumeratedValues . This is realized by requiring that the EnumerationDefinition have isVariation = true , with the enumeratedValues being its variants ."@en ;
    rdfs:subClassOf sysml2:AttributeDefinition ;
    umlmeta:oclConstraint "isVariation" .

sysml2:EnumerationUsage a owl:Class ;
    rdfs:label "EnumerationUsage"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Enumerations" ;
    skos:definition "An EnumerationUsage is an AttributeUsage whose attributeDefinition is an EnumerationDefinition ."@en ;
    rdfs:subClassOf sysml2:AttributeUsage ;
    umlmeta:oclConstraint "isReference" ;
    umlmeta:oclConstraint "specializesFromLibrary('Base::dataValues')" ;
    umlmeta:oclConstraint "feature->forAll(not isComposite)" .

sysml2:EventOccurrenceUsage a owl:Class ;
    rdfs:label "EventOccurrenceUsage"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Occurrences" ;
    skos:definition "An EventOccurrenceUsage is an OccurrenceUsage that represents another OccurrenceUsage occurring as a suboccurrence of the containing occurrence of the EventOccurrenceUsage . Unless it is the EventOccurrenceUsage itself, the referenced OccurrenceUsage is related to the EventOccurrenceUsage by a ReferenceSubsetting Relationship . If the EventOccurrenceUsage is owned by an OccurrenceDefinition or OccurrenceUsage , then it also subsets the timeEnclosedOccurrences property of the Class Occurrence from the Kernel Semantic Library model Occurrences ."@en ;
    rdfs:subClassOf sysml2:OccurrenceUsage ;
    umlmeta:oclConstraint "referencedFeatureTarget() <> null implies referencedFeatureTarget().oclIsKindOf(OccurrenceUsage)" ;
    umlmeta:oclConstraint "eventOccurrence = if referencedFeatureTarget() = null then self else if referencedFeatureTarget().oclIsKindOf(OccurrenceUsage) then referencedFeatureTarget().oclAsType(OccurrenceUsage) else null endif endif" ;
    umlmeta:oclConstraint "owningType <> null and (owningType.oclIsKindOf(OccurrenceDefinition) or owningType.oclIsKindOf(OccurrenceUsage)) implies specializesFromLibrary('Occurrences::Occurrence::timeEnclosedOccurrences')" ;
    umlmeta:oclConstraint "isReference" .

sysml2:PerformActionUsage a owl:Class ;
    rdfs:label "PerformActionUsage"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Actions" ;
    skos:definition "A PerformActionUsage is an ActionUsage that represents the performance of an ActionUsage . Unless it is the PerformActionUsage itself, the ActionUsage to be performed is related to the PerformActionUsage by a ReferenceSubsetting relationship. A PerformActionUsage is also an EventOccurrenceUsage , with its performedAction as the eventOccurrence ."@en ;
    rdfs:subClassOf sysml2:EventOccurrenceUsage ;
    rdfs:subClassOf sysml2:ActionUsage ;
    umlmeta:oclConstraint "referencedFeatureTarget() <> null implies referencedFeatureTarget().oclIsKindOf(ActionUsage)" ;
    umlmeta:oclConstraint "owningType <> null and (owningType.oclIsKindOf(PartDefinition) or owningType.oclIsKindOf(PartUsage)) implies specializesFromLibrary('Parts::Part::performedActions')" .

sysml2:StateUsage a owl:Class ;
    rdfs:label "StateUsage"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "States" ;
    skos:definition "A StateUsage is an ActionUsage that is nominally the Usage of a StateDefinition . However, other kinds of kernel Behaviors are also allowed as types , to permit use of Behaviors A StateUsage may be related to up to three of its ownedFeatures by StateSubactionMembership Relationships , all of different kinds , corresponding to the entry, do and exit actions of the StateUsage ."@en ;
    rdfs:subClassOf sysml2:ActionUsage ;
    umlmeta:oclConstraint "isParallel implies nestedAction.incomingTransition->isEmpty() and nestedAction.outgoingTransition->isEmpty()" ;
    umlmeta:oclConstraint "isSubstateUsage(false) implies specializesFromLibrary('States::StateAction::exclusiveStates')" ;
    umlmeta:oclConstraint "doAction = let doMemberships : Sequence(StateSubactionMembership) = ownedMembership-> selectByKind(StateSubactionMembership)-> select(kind = StateSubactionKind::do) in if doMemberships->isEmpty() then null else doMemberships->at(1) endif" ;
    umlmeta:oclConstraint "ownedMembership-> selectByKind(StateSubactionMembership)-> isUnique(kind)" ;
    umlmeta:oclConstraint "entryAction = let entryMemberships : Sequence(StateSubactionMembership) = ownedMembership-> selectByKind(StateSubactionMembership)-> select(kind = StateSubactionKind::entry) in if entryMemberships->isEmpty() then null else entryMemberships->at(1) endif" ;
    umlmeta:oclConstraint "isComposite and owningType <> null and (owningType.oclIsKindOf(PartDefinition) or owningType.oclIsKindOf(PartUsage)) implies specializesFromLibrary('Parts::Part::ownedStates')" ;
    umlmeta:oclConstraint "isSubstateUsage(true) implies specializesFromLibrary('States::StateAction::substates')" ;
    umlmeta:oclConstraint "specializesFromLibrary('States::stateActions')" ;
    umlmeta:oclConstraint "exitAction = let exitMemberships : Sequence(StateSubactionMembership) = ownedMembership-> selectByKind(StateSubactionMembership)-> select(kind = StateSubactionKind::exit) in if exitMemberships->isEmpty() then null else exitMemberships->at(1) endif" .

sysml2:ExhibitStateUsage a owl:Class ;
    rdfs:label "ExhibitStateUsage"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "States" ;
    skos:definition "An ExhibitStateUsage is a StateUsage that represents the exhibiting of a StateUsage . Unless it is the StateUsage itself, the StateUsage to be exhibited is related to the ExhibitStateUsage by a ReferenceSubsetting Relationship . An ExhibitStateUsage is also a PerformActionUsage , with its exhibitedState as the performedAction ."@en ;
    rdfs:subClassOf sysml2:PerformActionUsage ;
    rdfs:subClassOf sysml2:StateUsage ;
    umlmeta:oclConstraint "owningType <> null and (owningType.oclIsKindOf(PartDefinition) or owningType.oclIsKindOf(PartUsage)) implies specializesFromLibrary('Parts::Part::exhibitedStates')" ;
    umlmeta:oclConstraint "referencedFeatureTarget() <> null implies referencedFeatureTarget().oclIsKindOf(StateUsage)" .

sysml2:Import a owl:Class ;
    rdfs:label "Import"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Namespaces" ;
    umlmeta:abstract true ;
    skos:definition "An Import is an Relationship between its importOwningNamespace and either a Membership (for a MembershipImport ) or another Namespace (for a NamespaceImport ), which determines a set of Memberships that become importedMemberships of the importOwningNamespace . If isImportAll = false (the default), then only public Memberships are considered &quot;visible&quot;. If isImportAll = true , then all Memberships are considered &quot;visible&quot;, regardless of their declared visibility . If isRecursive = true , then visible Memberships are also recursively imported from owned sub- Namespaces ."@en ;
    rdfs:subClassOf sysml2:Relationship ;
    umlmeta:oclConstraint "importOwningNamespace.owner = null implies visibility = VisibilityKind::private" .

sysml2:Expose a owl:Class ;
    rdfs:label "Expose"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Views" ;
    umlmeta:abstract true ;
    skos:definition "An Expose is an Import of Memberships into a ViewUsage that provide the Elements to be included in a view. Visibility is always ignored for an Expose (i.e., isImportAll = true )."@en ;
    rdfs:subClassOf sysml2:Import ;
    umlmeta:oclConstraint "visibility = VisibilityKind::protected" ;
    umlmeta:oclConstraint "isImportAll" ;
    umlmeta:oclConstraint "importOwningNamespace.oclIsType(ViewUsage)" .

sysml2:FeatureChainExpression a owl:Class ;
    rdfs:label "FeatureChainExpression"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Expressions" ;
    skos:definition "A FeatureChainExpression is an OperatorExpression whose operator is \".\" , which resolves to the Function ControlFunctions::'.' from the Kernel Functions Library. It evaluates to the result of chaining the result Feature of its single argument Expression with its targetFeature ."@en ;
    rdfs:subClassOf sysml2:OperatorExpression ;
    umlmeta:oclConstraint "let inputParameters : Sequence(Feature) = ownedFeatures->select(direction = _'in') in let sourceTargetFeature : Feature = owningExpression.sourceTargetFeature() in sourceTargetFeature <> null and result.subsetsChain(inputParameters->first(), sourceTargetFeature) and result.owningType = self" ;
    umlmeta:oclConstraint "operator = '.'" ;
    umlmeta:oclConstraint "argument->notEmpty() implies targetFeature.isFeaturedWithin(argument->first().result)" ;
    umlmeta:oclConstraint "targetFeature = let nonParameterMemberships : Sequence(Membership) = ownedMembership-> reject(oclIsKindOf(ParameterMembership)) in if nonParameterMemberships->isEmpty() or not nonParameterMemberships->first().memberElement.oclIsKindOf(Feature) then null else nonParameterMemberships->first().memberElement.oclAsType(Feature) endif" ;
    umlmeta:oclConstraint "let sourceParameter : Feature = sourceTargetFeature() in sourceTargetFeature <> null and sourceTargetFeature.redefinesFromLibrary('ControlFunctions::\\'.\\'::source::target')" ;
    umlmeta:oclConstraint "let sourceParameter : Feature = sourceTargetFeature() in sourceTargetFeature <> null and sourceTargetFeature.redefines(targetFeature)" .

sysml2:FeatureChaining a owl:Class ;
    rdfs:label "FeatureChaining"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Features" ;
    skos:definition "FeatureChaining is a Relationship that makes its target Feature one of the chainingFeatures of its owning Feature ."@en ;
    rdfs:subClassOf sysml2:Relationship ;
    umlmeta:oclConstraint "relatedElement = source->union(target)" .

sysml2:FeatureInverting a owl:Class ;
    rdfs:label "FeatureInverting"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Features" ;
    skos:definition "A FeatureInverting is a Relationship between Features asserting that their interpretations (sequences) are the reverse of each other, identified as featureInverted and invertingFeature . For example, a Feature identifying each person&#39;s parents is the inverse of a Feature identifying each person&#39;s children. A person identified as a parent of another will identify that other as one of their children."@en ;
    rdfs:subClassOf sysml2:Relationship ;
    umlmeta:oclConstraint "relatedElement = source->union(target)" .

sysml2:FeatureReferenceExpression a owl:Class ;
    rdfs:label "FeatureReferenceExpression"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Expressions" ;
    skos:definition "A FeatureReferenceExpression is an Expression whose result is bound to a referent Feature ."@en ;
    rdfs:subClassOf sysml2:Expression ;
    umlmeta:oclConstraint "let membership : Membership = ownedMembership->reject(m | m.oclIsKindOf(ParameterMembership)) in membership->notEmpty() and membership->at(1).memberElement.oclIsKindOf(Feature)" ;
    umlmeta:oclConstraint "ownedMember->selectByKind(BindingConnector)->exists(b | b.relatedFeatures->includes(targetFeature) and b.relatedFeatures->includes(result))" ;
    umlmeta:oclConstraint "result.owningType() = self and result.specializes(referent)" ;
    umlmeta:oclConstraint "referent = let nonParameterMemberships : Sequence(Membership) = ownedMembership-> reject(oclIsKindOf(ParameterMembership)) in if nonParameterMemberships->isEmpty() or not nonParameterMemberships->first().memberElement.oclIsKindOf(Feature) then null else nonParameterMemberships->first().memberElement.oclAsType(Feature) endif" ;
    umlmeta:oclConstraint "result.owningType = self" .

sysml2:FeatureValue a owl:Class ;
    rdfs:label "FeatureValue"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "FeatureValues" ;
    skos:definition "A FeatureValue is a Membership that identifies a particular member Expression that provides the value of the Feature that owns the FeatureValue . The value is specified as either a bound value or an initial value, and as either a concrete or default value. A Feature can have at most one FeatureValue . The result of the value Expression is bound to the featureWithValue using a BindingConnector . If isInitial = false , then the featuringType of the BindingConnector is the same as the featuringType of the featureWithValue . If isInitial = true , then the featuringType of the BindingConnector is restricted to its startShot . If <c...[truncated]"@en ;
    rdfs:subClassOf sysml2:OwningMembership ;
    umlmeta:oclConstraint "isInitial implies featureWithValue.isVariable" ;
    umlmeta:oclConstraint "featureWithValue.redefinition.redefinedFeature-> closure(redefinition.redefinedFeature).valuation-> forAll(isDefault)" ;
    umlmeta:oclConstraint "not isDefault implies featureWithValue.ownedMember-> selectByKind(BindingConnector)->exists(b | b.relatedFeature->includes(featureWithValue) and b.relatedFeature->exists(f | f.chainingFeature = Sequence{value, value.result}) and if not isInitial then b.featuringType = featureWithValue.featuringType else b.featuringType->exists(t | t.oclIsKindOf(Feature) and t.oclAsType(Feature).chainingFeature = Sequence{ resolveGlobal('Base::things::that'). memberElement, resolveGlobal('Occurrences::Occurrence::startShot'). memberElement } ) endif)" .

sysml2:Flow a owl:Class ;
    rdfs:label "Flow"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Interactions" ;
    skos:definition "An Flow is a Step that represents the transfer of values from one Feature to another. Flows can take non-zero time to complete."@en ;
    rdfs:subClassOf sysml2:Connector ;
    rdfs:subClassOf sysml2:Step ;
    umlmeta:oclConstraint "flowEnd = connectorEnd->selectByKind(FlowEnd)" ;
    umlmeta:oclConstraint "ownedFeature->selectByKind(PayloadFeature)->size() <= 1" ;
    umlmeta:oclConstraint "targetInputFeature = if connectorEnd->size() at(2).ownedFeature->isEmpty() then null else connectorEnd->at(2).ownedFeature->first() endif" ;
    umlmeta:oclConstraint "payloadType = if payloadFeature = null then Sequence{} else payloadFeature.type endif" ;
    umlmeta:oclConstraint "payloadFeature = let payloadFeatures : Sequence(PayloadFeature) = ownedFeature->selectByKind(PayloadFeature) in if payloadFeatures->isEmpty() then null else payloadFeatures->first() endif" ;
    umlmeta:oclConstraint "specializesFromLibrary('Transfers::transfers')" ;
    umlmeta:oclConstraint "ownedEndFeatures->notEmpty() implies specializesFromLibrary('Transfers::flowTransfers')" ;
    umlmeta:oclConstraint "sourceOutputFeature = if connectorEnd->isEmpty() or connectorEnd.ownedFeature->isEmpty() then null else connectorEnd.ownedFeature->first() endif" .

sysml2:Interaction a owl:Class ;
    rdfs:label "Interaction"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Interactions" ;
    skos:definition "An Interaction is a Behavior that is also an Association , providing a context for multiple objects that have behaviors that impact one another."@en ;
    rdfs:subClassOf sysml2:Behavior ;
    rdfs:subClassOf sysml2:Association ;
    umlmeta:oclConstraint "specializesFromLibrary('Performances::Performance')" ;
    umlmeta:oclConstraint "ownedSpecialization.general->forAll(not oclIsKindOf(Structure))" ;
    umlmeta:oclConstraint "step = feature->selectByKind(Step)" .

sysml2:FlowDefinition a owl:Class ;
    rdfs:label "FlowDefinition"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Flows" ;
    skos:definition "A FlowDefinition is an ActionDefinition that is also an Interaction (which is both a KerML Behavior and Association ), representing flows between Usages ."@en ;
    rdfs:subClassOf sysml2:ActionDefinition ;
    rdfs:subClassOf sysml2:Interaction ;
    umlmeta:oclConstraint "specializesFromLibrary('Flows::MessageAction')" ;
    umlmeta:oclConstraint "flowEnd->size() = 2 implies specializesFromLibrary('Flows::Message')" ;
    umlmeta:oclConstraint "flowEnd->size() <= 2" .

sysml2:FlowEnd a owl:Class ;
    rdfs:label "FlowEnd"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Interactions" ;
    skos:definition "A FlowEnd is a Feature that is one of the connectorEnds giving the source or target of a Flow . For Flows typed by FlowTransfer or its specializations, FlowEnds must have exactly one ownedFeature , which redefines Transfer::source::sourceOutput or Transfer::target::targetInput and redefines the corresponding feature of the relatedElement for its end."@en ;
    rdfs:subClassOf sysml2:Feature ;
    umlmeta:oclConstraint "isEnd" ;
    umlmeta:oclConstraint "ownedFeature->size() = 1" ;
    umlmeta:oclConstraint "owningType <> null and owningType.oclIsKindOf(Flow)" .

sysml2:FlowUsage a owl:Class ;
    rdfs:label "FlowUsage"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Flows" ;
    skos:definition "A FlowUsage is an ActionUsage that is also a ConnectorAsUsage and a KerML Flow ."@en ;
    rdfs:subClassOf sysml2:ActionUsage ;
    rdfs:subClassOf sysml2:ConnectorAsUsage ;
    rdfs:subClassOf sysml2:Flow ;
    umlmeta:oclConstraint "specializesFromLibrary('Flows::messages')" ;
    umlmeta:oclConstraint "ownedEndFeatures->notEmpty() implies specializesFromLibrary('Flows::flows')" .

sysml2:LoopActionUsage a owl:Class ;
    rdfs:label "LoopActionUsage"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Actions" ;
    umlmeta:abstract true ;
    skos:definition "A LoopActionUsage is an ActionUsage that specifies that its bodyAction should be performed repeatedly. Its subclasses WhileLoopActionUsage and ForLoopActionUsage provide different ways to determine how many times the bodyAction should be performed."@en ;
    rdfs:subClassOf sysml2:ActionUsage ;
    umlmeta:oclConstraint "bodyAction = let parameter : Feature = inputParameter(2) in if parameter <> null and parameter.oclIsKindOf(Action) then parameter.oclAsType(Action) else null endif" .

sysml2:ForLoopActionUsage a owl:Class ;
    rdfs:label "ForLoopActionUsage"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Actions" ;
    skos:definition "A ForLoopActionUsage is a LoopActionUsage that specifies that its bodyAction ActionUsage should be performed once for each value, in order, from the sequence of values obtained as the result of the seqArgument Expression , with the loopVariable set to the value for each iteration."@en ;
    rdfs:subClassOf sysml2:LoopActionUsage ;
    umlmeta:oclConstraint "isSubactionUsage() implies specializesFromLibrary('Actions::Action::forLoops')" ;
    umlmeta:oclConstraint "loopVariable <> null and loopVariable.redefinesFromLibrary('Actions::ForLoopAction::var')" ;
    umlmeta:oclConstraint "ownedFeature->notEmpty() and ownedFeature->at(1).oclIsKindOf(ReferenceUsage)" ;
    umlmeta:oclConstraint "loopVariable = if ownedFeature->isEmpty() or not ownedFeature->first().oclIsKindOf(ReferenceUsage) then null else ownedFeature->first().oclAsType(ReferenceUsage) endif" ;
    umlmeta:oclConstraint "inputParameters()->size() = 2" ;
    umlmeta:oclConstraint "seqArgument = argument(1)" ;
    umlmeta:oclConstraint "specializesFromLibrary('Actions::forLoopActions')" .

sysml2:ForkNode a owl:Class ;
    rdfs:label "ForkNode"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Actions" ;
    skos:definition "A ForkNode is a ControlNode that must be followed by successor Actions as given by all its outgoing Successions ."@en ;
    rdfs:subClassOf sysml2:ControlNode ;
    umlmeta:oclConstraint "targetConnector->selectByKind(Succession)->size() <= 1" ;
    umlmeta:oclConstraint "specializesFromLibrary('Actions::Action::forks')" .

sysml2:RequirementConstraintMembership a owl:Class ;
    rdfs:label "RequirementConstraintMembership"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Requirements" ;
    skos:definition "A RequirementConstraintMembership is a FeatureMembership for an assumed or required ConstraintUsage of a RequirementDefinition or RequirementUsage ."@en ;
    rdfs:subClassOf sysml2:FeatureMembership ;
    umlmeta:oclConstraint "ownedConstraint.isComposite" ;
    umlmeta:oclConstraint "referencedConstraint = let referencedFeature : Feature = ownedConstraint.referencedFeatureTarget() in if referencedFeature = null then ownedConstraint else if referencedFeature.oclIsKindOf(ConstraintUsage) then refrencedFeature.oclAsType(ConstraintUsage) else null endif endif" ;
    umlmeta:oclConstraint "owningType.oclIsKindOf(RequirementDefinition) or owningType.oclIsKindOf(RequirementUsage)" .

sysml2:FramedConcernMembership a owl:Class ;
    rdfs:label "FramedConcernMembership"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Requirements" ;
    skos:definition "A FramedConcernMembership is a RequirementConstraintMembership for a framed ConcernUsage of a RequirementDefinition or RequirementUsage ."@en ;
    rdfs:subClassOf sysml2:RequirementConstraintMembership ;
    umlmeta:oclConstraint "kind = RequirementConstraintKind::requirement" .

sysml2:IfActionUsage a owl:Class ;
    rdfs:label "IfActionUsage"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Actions" ;
    skos:definition "An IfActionUsage is an ActionUsage that specifies that the thenAction ActionUsage should be performed if the result of the ifArgument Expression is true. It may also optionally specify an elseAction ActionUsage that is performed if the result of the ifArgument is false."@en ;
    rdfs:subClassOf sysml2:ActionUsage ;
    umlmeta:oclConstraint "thenAction = let parameter : Feature = inputParameter(2) in if parameter <> null and parameter.oclIsKindOf(ActionUsage) then parameter.oclAsType(ActionUsage) else null endif" ;
    umlmeta:oclConstraint "if elseAction = null then specializesFromLibrary('Actions::ifThenActions') else specializesFromLibrary('Actions::ifThenElseActions') endif" ;
    umlmeta:oclConstraint "inputParameters()->size() >= 2" ;
    umlmeta:oclConstraint "elseAction = let parameter : Feature = inputParameter(3) in if parameter <> null and parameter.oclIsKindOf(ActionUsage) then parameter.oclAsType(ActionUsage) else null endif" ;
    umlmeta:oclConstraint "ifArgument = let parameter : Feature = inputParameter(1) in if parameter <> null and parameter.oclIsKindOf(Expression) then parameter.oclAsType(Expression) else null endif" ;
    umlmeta:oclConstraint "isSubactionUsage() implies specializesFromLibrary('Actions::Action::ifSubactions')" .

sysml2:UseCaseUsage a owl:Class ;
    rdfs:label "UseCaseUsage"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "UseCases" ;
    skos:definition "A UseCaseUsage is a Usage of a UseCaseDefinition ."@en ;
    rdfs:subClassOf sysml2:CaseUsage ;
    umlmeta:oclConstraint "isComposite and owningType <> null and (owningType.oclIsKindOf(UseCaseDefinition) or owningType.oclIsKindOf(UseCaseUsage)) implies specializesFromLibrary('UseCases::UseCase::subUseCases')" ;
    umlmeta:oclConstraint "includedUseCase = ownedUseCase-> selectByKind(IncludeUseCaseUsage). useCaseIncluded" ;
    umlmeta:oclConstraint "specializesFromLibrary('UseCases::useCases')" .

sysml2:IncludeUseCaseUsage a owl:Class ;
    rdfs:label "IncludeUseCaseUsage"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "UseCases" ;
    skos:definition "An IncludeUseCaseUsage is a UseCaseUsage that represents the inclusion of a UseCaseUsage by a UseCaseDefinition or UseCaseUsage . Unless it is the IncludeUseCaseUsage itself, the UseCaseUsage to be included is related to the includedUseCase by a ReferenceSubsetting Relationship . An IncludeUseCaseUsage is also a PerformActionUsage, with its useCaseIncluded as the performedAction ."@en ;
    rdfs:subClassOf sysml2:UseCaseUsage ;
    rdfs:subClassOf sysml2:PerformActionUsage ;
    umlmeta:oclConstraint "owningType <> null and (owningType.oclIsKindOf(UseCaseDefinition) or owningType.oclIsKindOf(UseCaseUsage) implies specializesFromLibrary('UseCases::UseCase::includedUseCases')" ;
    umlmeta:oclConstraint "referencedFeatureTarget() <> null implies referencedFeatureTarget().oclIsKindOf(UseCaseUsage)" .

sysml2:IndexExpression a owl:Class ;
    rdfs:label "IndexExpression"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Expressions" ;
    skos:definition "An IndexExpression is an OperatorExpression whose operator is \"#\" , which resolves to the Function BasicFunctions::'#' from the Kernel Functions Library."@en ;
    rdfs:subClassOf sysml2:OperatorExpression ;
    umlmeta:oclConstraint "arguments->notEmpty() and not arguments->first().result.specializesFromLibrary('Collections::Array') implies result.specializes(arguments->first().result)" ;
    umlmeta:oclConstraint "operator = '#'" .

sysml2:InterfaceDefinition a owl:Class ;
    rdfs:label "InterfaceDefinition"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Interfaces" ;
    skos:definition "An InterfaceDefinition is a ConnectionDefinition all of whose ends are PortUsages , defining an interface between elements that interact through such ports."@en ;
    rdfs:subClassOf sysml2:ConnectionDefinition ;
    umlmeta:oclConstraint "specializesFromLibrary('Interfaces::Interface')" ;
    umlmeta:oclConstraint "ownedEndFeature->size() = 2 implies specializesFromLibrary('Interfaces::BinaryInterface')" .

sysml2:InterfaceUsage a owl:Class ;
    rdfs:label "InterfaceUsage"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Interfaces" ;
    skos:definition "An InterfaceUsage is a Usage of an InterfaceDefinition to represent an interface connecting parts of a system through specific ports."@en ;
    rdfs:subClassOf sysml2:ConnectionUsage ;
    umlmeta:oclConstraint "ownedEndFeature->size() = 2 implies specializesFromLibrary('Interfaces::binaryInterfaces')" ;
    umlmeta:oclConstraint "specializesFromLibrary('Interfaces::interfaces')" .

sysml2:Intersecting a owl:Class ;
    rdfs:label "Intersecting"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Types" ;
    skos:definition "Intersecting is a Relationship that makes its intersectingType one of the intersectingTypes of its typeIntersected ."@en ;
    rdfs:subClassOf sysml2:Relationship ;
    umlmeta:oclConstraint "relatedElement = source->union(target)" .

sysml2:JoinNode a owl:Class ;
    rdfs:label "JoinNode"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Actions" ;
    skos:definition "A JoinNode is a ControlNode that waits for the completion of all the predecessor Actions given by incoming Successions ."@en ;
    rdfs:subClassOf sysml2:ControlNode ;
    umlmeta:oclConstraint "sourceConnector->selectByKind(Succession)->size() <= 1" ;
    umlmeta:oclConstraint "specializesFromLibrary('Actions::Action::join')" .

sysml2:Package a owl:Class ;
    rdfs:label "Package"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Packages" ;
    skos:definition "A Package is a Namespace used to group Elements , without any instance-level semantics. It may have one or more model-level evaluable filterCondition Expressions used to filter its importedMemberships . Any imported member must meet all of the filterConditions ."@en ;
    rdfs:subClassOf sysml2:Namespace ;
    umlmeta:oclConstraint "filterCondition = ownedMembership-> selectByKind(ElementFilterMembership).condition" .

sysml2:LibraryPackage a owl:Class ;
    rdfs:label "LibraryPackage"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Packages" ;
    skos:definition "A LibraryPackage is a Package that is the container for a model library. A LibraryPackage is itself a library Element as are all Elements that are directly or indirectly contained in it."@en ;
    rdfs:subClassOf sysml2:Package ;
    umlmeta:oclConstraint "filterCondition = ownedMembership-> selectByKind(ElementFilterMembership).condition" .

sysml2:LiteralExpression a owl:Class ;
    rdfs:label "LiteralExpression"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Expressions" ;
    skos:definition "A LiteralExpression is an Expression that provides a basic DataValue as a result."@en ;
    rdfs:subClassOf sysml2:Expression ;
    umlmeta:oclConstraint "isModelLevelEvaluable = true" ;
    umlmeta:oclConstraint "specializesFromLibrary('Performances::literalEvaluations')" .

sysml2:LiteralBoolean a owl:Class ;
    rdfs:label "LiteralBoolean"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Expressions" ;
    skos:definition "LiteralBoolean is a LiteralExpression that provides a Boolean value as a result. Its result parameter must have type Boolean ."@en ;
    rdfs:subClassOf sysml2:LiteralExpression ;
    umlmeta:oclConstraint "specializesFromLibrary('Performances::literalBooleanEvaluations')" .

sysml2:LiteralInfinity a owl:Class ;
    rdfs:label "LiteralInfinity"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Expressions" ;
    skos:definition "A LiteralInfinity is a LiteralExpression that provides the positive infinity value ( * ). It's result must have the type Positive ."@en ;
    rdfs:subClassOf sysml2:LiteralExpression ;
    umlmeta:oclConstraint "specializesFromLibrary('Performances::literalIntegerEvaluations')" .

sysml2:LiteralInteger a owl:Class ;
    rdfs:label "LiteralInteger"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Expressions" ;
    skos:definition "A LiteralInteger is a LiteralExpression that provides an Integer value as a result. Its result parameter must have the type Integer ."@en ;
    rdfs:subClassOf sysml2:LiteralExpression ;
    umlmeta:oclConstraint "specializesFromLibrary('Performances::literalIntegerEvaluations')" .

sysml2:LiteralRational a owl:Class ;
    rdfs:label "LiteralRational"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Expressions" ;
    skos:definition "A LiteralRational is a LiteralExpression that provides a Rational value as a result. Its result parameter must have the type Rational ."@en ;
    rdfs:subClassOf sysml2:LiteralExpression ;
    umlmeta:oclConstraint "specializesFromLibrary('Performances::literalRationalEvaluations')" .

sysml2:LiteralString a owl:Class ;
    rdfs:label "LiteralString"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Expressions" ;
    skos:definition "A LiteralString is a LiteralExpression that provides a String value as a result. Its result parameter must have the type String ."@en ;
    rdfs:subClassOf sysml2:LiteralExpression ;
    umlmeta:oclConstraint "specializesFromLibrary('Performances::literalStringEvaluations')" .

sysml2:MembershipImport a owl:Class ;
    rdfs:label "MembershipImport"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Namespaces" ;
    skos:definition "A MembershipImport is an Import that imports its importedMembership into the importOwningNamespace . If isRecursive = true and the memberElement of the importedMembership is a Namespace , then the equivalent of a recursive NamespaceImport is also performed on that Namespace ."@en ;
    rdfs:subClassOf sysml2:Import ;
    umlmeta:oclConstraint "importedElement = importedMembership.memberElement" .

sysml2:MembershipExpose a owl:Class ;
    rdfs:label "MembershipExpose"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Views" ;
    skos:definition "A MembershipExpose is an Expose that exposes a specific importedMembership and, if isRecursive = true , additional Memberships recursively."@en ;
    rdfs:subClassOf sysml2:MembershipImport ;
    rdfs:subClassOf sysml2:Expose ;
    umlmeta:oclConstraint "importedElement = importedMembership.memberElement" .

sysml2:MergeNode a owl:Class ;
    rdfs:label "MergeNode"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Actions" ;
    skos:definition "A MergeNode is a ControlNode that asserts the merging of its incoming Successions . A MergeNode may have at most one outgoing Successions ."@en ;
    rdfs:subClassOf sysml2:ControlNode ;
    umlmeta:oclConstraint "sourceConnector->selectAsKind(Succession)->size() <= 1" ;
    umlmeta:oclConstraint "targetConnector->selectByKind(Succession)-> collect(connectorEnd->at(1))-> forAll(sourceMult | multiplicityHasBounds(sourceMult, 0, 1))" ;
    umlmeta:oclConstraint "targetConnector->selectByKind(Succession)-> forAll(subsetsChain(self, resolveGlobal('ControlPerformances::MergePerformance::incomingHBLink')))" ;
    umlmeta:oclConstraint "specializesFromLibrary('Actions::Action::merges')" .

sysml2:Metaclass a owl:Class ;
    rdfs:label "Metaclass"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Metadata" ;
    skos:definition "A Metaclass is a Structure used to type MetadataFeatures ."@en ;
    rdfs:subClassOf sysml2:Structure ;
    umlmeta:oclConstraint "specializesFromLibrary('Metaobjects::Metaobject')" .

sysml2:MetadataAccessExpression a owl:Class ;
    rdfs:label "MetadataAccessExpression"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Expressions" ;
    skos:definition "A MetadataAccessExpression is an Expression whose result is a sequence of instances of Metaclasses representing all the MetadataFeature annotations of the referencedElement . In addition, the sequence includes an instance of the reflective Metaclass corresponding to the MOF class of the referencedElement , with values for all the abstract syntax properties of the referencedElement ."@en ;
    rdfs:subClassOf sysml2:Expression ;
    umlmeta:oclConstraint "ownedMembership->exists(not oclIsKindOf(FeatureMembership))" ;
    umlmeta:oclConstraint "referencedElement = let elements : Sequence(Element) = ownedMembership-> reject(oclIsKindOf(FeatureMembership)).memberElement in if elements->isEmpty() then null else elements->first() endif" ;
    umlmeta:oclConstraint "specializesFromLibrary('Performances::metadataAccessEvaluations')" .

sysml2:MetadataDefinition a owl:Class ;
    rdfs:label "MetadataDefinition"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Metadata" ;
    skos:definition "A MetadataDefinition is an ItemDefinition that is also a Metaclass ."@en ;
    rdfs:subClassOf sysml2:ItemDefinition ;
    rdfs:subClassOf sysml2:Metaclass ;
    umlmeta:oclConstraint "specializesFromLibrary('Metadata::MetadataItem')" .

sysml2:MetadataFeature a owl:Class ;
    rdfs:label "MetadataFeature"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Metadata" ;
    skos:definition "A MetadataFeature is a Feature that is an AnnotatingElement used to annotate another Element with metadata. It is typed by a Metaclass . All its ownedFeatures must redefine features of its metaclass and any feature bindings must be model-level evaluable."@en ;
    rdfs:subClassOf sysml2:Feature ;
    rdfs:subClassOf sysml2:AnnotatingElement ;
    umlmeta:oclConstraint "metaclass = let metaclassTypes : Sequence(Type) = type->selectByKind(Metaclass) in if metaclassTypes->isEmpty() then null else metaClassTypes->first() endif" ;
    umlmeta:oclConstraint "type->selectByKind(Metaclass).size() = 1" ;
    umlmeta:oclConstraint "specializesFromLibrary('Metaobjects::metaobjects')" ;
    umlmeta:oclConstraint "not metaclass.isAbstract" ;
    umlmeta:oclConstraint "isSemantic() implies let annotatedTypes : Sequence(Type) = annotatedElement->selectAsKind(Type) in let baseTypes : Sequence(MetadataFeature) = evaluateFeature(resolveGlobal( 'Metaobjects::SemanticMetadata::baseType'). memberElement. oclAsType(Feature))-> selectAsKind(MetadataFeature) in annotatedTypes->notEmpty() and baseTypes()->notEmpty() and baseTypes()->first().isSyntactic() implies let annotatedType : Type = annotatedTypes->first() in let baseType : Element = baseTypes->first().syntaxElement() in if annotatedType.oclIsKindOf(Classifier) and baseType.oclIsKindOf(Feature) then baseType.oclAsType(Feature).type-> forAll(t | annotatedType.specializes(t)) else if baseType.oclIsKindOf(Type) then annotatedType.specializes(baseType.oclAsType(Type)) else true endif" ;
    umlmeta:oclConstraint "ownedFeature->closure(ownedFeature)->forAll(f | f.declaredName = null and f.declaredShortName = null and f.valuation <> null implies f.valuation.value.isModelLevelEvaluable and f.redefinition.redefinedFeature->size() = 1)" ;
    umlmeta:oclConstraint "let baseAnnotatedElementFeature : Feature = resolveGlobal('Metaobjects::Metaobject::annotatedElement').memberElement. oclAsType(Feature) in let annotatedElementFeatures : OrderedSet(Feature) = feature-> select(specializes(baseAnnotatedElementFeature))-> excluding(baseAnnotatedElementFeature) in annotatedElementFeatures->notEmpty() implies let annotatedElementTypes : Set(Feature) = annotatedElementFeatures.typing.type->asSet() in let metaclasses : Set(Metaclass) = annotatedElement.oclType().qualifiedName->collect(qn | resolveGlobal(qn).memberElement.oclAsType(Metaclass)) in metaclasses->forAll(m | annotatedElementTypes->exists(t | m.specializes(t)))" .

sysml2:MetadataUsage a owl:Class ;
    rdfs:label "MetadataUsage"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Metadata" ;
    skos:definition "A MetadataUsage is a Usage and a MetadataFeature , used to annotate other Elements in a system model with metadata. As a MetadataFeature , its type must be a Metaclass , which will nominally be a MetadataDefinition . However, any kernel Metaclass is also allowed, to permit use of Metaclasses from the Kernel Model Libraries."@en ;
    rdfs:subClassOf sysml2:ItemUsage ;
    rdfs:subClassOf sysml2:MetadataFeature ;
    umlmeta:oclConstraint "specializesFromLibrary('Metadata::metadataItems')" .

sysml2:Multiplicity a owl:Class ;
    rdfs:label "Multiplicity"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Types" ;
    skos:definition "A Multiplicity is a Feature whose co-domain is a set of natural numbers giving the allowed cardinalities of each typeWithMultiplicity . The cardinality of a Type is defined as follows, depending on whether the Type is a Classifier or Feature . Classifier – The number of basic instances of the Classifier , that is, those instances representing things, which are not instances of any subtypes of the Classifier that are Features . Features – The number of instances with the same featuring instances. In the case of a Feature with a Classifier as its featuringType , this is the number of values of Feature for each basic instance of the Classifier . Note that...[truncated]"@en ;
    rdfs:subClassOf sysml2:Feature ;
    umlmeta:oclConstraint "if owningType <> null and owningType.oclIsKindOf(Feature) then featuringType = owningType.oclAsType(Feature).featuringType else featuringType->isEmpty() endif" ;
    umlmeta:oclConstraint "specializesFromLibrary('Base::naturals')" .

sysml2:MultiplicityRange a owl:Class ;
    rdfs:label "MultiplicityRange"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Multiplicities" ;
    skos:definition "A MultiplicityRange is a Multiplicity whose value is defined to be the (inclusive) range of natural numbers given by the result of a lowerBound Expression and the result of an upperBound Expression . The result of these Expressions shall be of type Natural . If the result of the upperBound Expression is the unbounded value * , then the specified range includes all natural numbers greater than or equal to the lowerBound value. If no lowerBound Expression , then the default is that the lower bound has the same value as the upper bound, except if the upperBound evaluates to * , in which case the default for the lower bound is 0."@en ;
    rdfs:subClassOf sysml2:Multiplicity ;
    umlmeta:oclConstraint "bound->forAll(b | b.featuringType = self.featuringType)" ;
    umlmeta:oclConstraint "bound = if upperBound = null then Sequence{} else if lowerBound = null then Sequence{upperBound} else Sequence{lowerBound, upperBound} endif endif" ;
    umlmeta:oclConstraint "bound->forAll(b | b.result.specializesFromLibrary('ScalarValues::Integer') and let value : UnlimitedNatural = valueOf(b) in value <> null implies value >= 0 )" ;
    umlmeta:oclConstraint "if lowerBound = null then ownedMember->notEmpty() and ownedMember->at(1) = upperBound else ownedMember->size() > 1 and ownedMember->at(1) = lowerBound and ownedMember->at(2) = upperBound endif" ;
    umlmeta:oclConstraint "upperBound = let ownedExpressions : Sequence(Expression) = ownedMember->selectByKind(Expression) in if ownedExpressions->isEmpty() then null else if ownedExpressions->size() = 1 then ownedExpressions->at(1) else ownedExpressions->at(2) endif endif" ;
    umlmeta:oclConstraint "lowerBound = let ownedExpressions : Sequence(Expression) = ownedMember->selectByKind(Expression) in if ownedExpressions->size() first() endif" .

sysml2:NamespaceImport a owl:Class ;
    rdfs:label "NamespaceImport"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Namespaces" ;
    skos:definition "A NamespaceImport is an Import that imports Memberships from its importedNamespace into the importOwningNamespace . If isRecursive = false , then only the visible Memberships of the importedNamespace are imported. If isRecursive = true , then, in addition, Memberships are recursively imported from any ownedMembers of the importedNamespace that are Namespaces ."@en ;
    rdfs:subClassOf sysml2:Import ;
    umlmeta:oclConstraint "importedElement = importedNamespace" .

sysml2:NamespaceExpose a owl:Class ;
    rdfs:label "NamespaceExpose"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Views" ;
    skos:definition "A NamespaceExpose is an Expose Relationship that exposes the Memberships of a specific importedNamespace and, if isRecursive = true , additional Memberships recursively."@en ;
    rdfs:subClassOf sysml2:Expose ;
    rdfs:subClassOf sysml2:NamespaceImport ;
    umlmeta:oclConstraint "visibility = VisibilityKind::protected" ;
    umlmeta:oclConstraint "isImportAll" ;
    umlmeta:oclConstraint "importOwningNamespace.oclIsType(ViewUsage)" .

sysml2:NullExpression a owl:Class ;
    rdfs:label "NullExpression"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Expressions" ;
    skos:definition "A NullExpression is an Expression that results in a null value."@en ;
    rdfs:subClassOf sysml2:Expression ;
    umlmeta:oclConstraint "specializesFromLibrary('Performances::nullEvaluations')" .

sysml2:ObjectiveMembership a owl:Class ;
    rdfs:label "ObjectiveMembership"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Cases" ;
    skos:definition "An ObjectiveMembership is a FeatureMembership that indicates that its ownedObjectiveRequirement is the objective RequirementUsage for its owningType , which must be a CaseDefinition or CaseUsage ."@en ;
    rdfs:subClassOf sysml2:FeatureMembership ;
    umlmeta:oclConstraint "owningType.oclIsType(CaseDefinition) or owningType.oclIsType(CaseUsage)" ;
    umlmeta:oclConstraint "ownedObjectiveRequirement.isComposite" .

sysml2:PayloadFeature a owl:Class ;
    rdfs:label "PayloadFeature"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Interactions" ;
    skos:definition "A PayloadFeature is the ownedFeature of a Flow that identifies the things carried by the kinds of transfers that are instances of the Flow ."@en ;
    rdfs:subClassOf sysml2:Feature ;
    umlmeta:oclConstraint "redefinesFromLibrary('Transfers::Transfer::payload')" .

sysml2:PortConjugation a owl:Class ;
    rdfs:label "PortConjugation"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Ports" ;
    skos:definition "A PortConjugation is a Conjugation Relationship between a PortDefinition and its corresponding ConjugatedPortDefinition . As a result of this Relationship , the ConjugatedPortDefinition inherits all the features of the original PortDefinition , but input flows of the original PortDefinition become outputs on the ConjugatedPortDefinition and output flows of the original PortDefinition become inputs on the ConjugatedPortDefinition ."@en ;
    rdfs:subClassOf sysml2:Conjugation ;
    umlmeta:oclConstraint "relatedElement = source->union(target)" .

sysml2:PortUsage a owl:Class ;
    rdfs:label "PortUsage"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Ports" ;
    skos:definition "A PortUsage is a usage of a PortDefinition . A PortUsage itself as well as all its nestedUsages must be referential (non-composite)."@en ;
    rdfs:subClassOf sysml2:OccurrenceUsage ;
    umlmeta:oclConstraint "nestedUsage-> reject(oclIsKindOf(PortUsage))-> forAll(not isComposite)" ;
    umlmeta:oclConstraint "isComposite and owningType <> null and (owningType.oclIsKindOf(PortDefinition) or owningType.oclIsKindOf(PortUsage)) implies specializesFromLibrary('Ports::Port::subports')" ;
    umlmeta:oclConstraint "owningType = null or not owningType.oclIsKindOf(PortDefinition) and not owningType.oclIsKindOf(PortUsage) implies isReference" ;
    umlmeta:oclConstraint "specializesFromLibrary('Ports::ports')" ;
    umlmeta:oclConstraint "owningType <> null and (owningType.oclIsKindOf(PartDefinition) or owningType.oclIsKindOf(PartUsage)) implies specializesFromLibrary('Parts::Part::ownedPorts')" .

sysml2:Redefinition a owl:Class ;
    rdfs:label "Redefinition"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Features" ;
    skos:definition "Redefinition is a kind of Subsetting that requires the redefinedFeature and the redefiningFeature to have the same values (on each instance of the domain of the redefiningFeature ). This means any restrictions on the redefiningFeature , such as type or multiplicity , also apply to the redefinedFeature (on each instance of the domain of the redefiningFeature ), and vice versa. The redefinedFeature might have values for instances of the domain of the redefiningFeature , but only as instances of the domain of the redefinedFeature that happen to also be instances of the domain of the redefiningFeature . This is supported by the constraints inherited from Subsetting on the domains of the redefining...[truncated]"@en ;
    rdfs:subClassOf sysml2:Subsetting ;
    umlmeta:oclConstraint "redefinedFeature.isEnd implies redefiningFeature.isEnd" ;
    umlmeta:oclConstraint "let anythingType: Type = redefiningFeature.resolveGlobal('Base::Anything').modelElement.oclAsType(Type) in -- Including \"Anything\" accounts for implicit featuringType of Features -- with no explicit featuringType. let redefiningFeaturingTypes: Set(Type) = if redefiningFeature.isVariable then Set{redefiningFeature.owningType} else redefiningFeature.featuringTypes->asSet()->including(anythingType) endif in let redefinedFeaturingTypes: Set(Type) = if redefinedFeature.isVariable then Set{redefinedFeature.owningType} else redefinedFeature.featuringTypes->asSet()->including(anythingType) endif in redefiningFeaturingTypes <> redefinedFeaturingType" ;
    umlmeta:oclConstraint "let featuringTypes : Sequence(Type) = if redefiningFeature.isVariable then Sequence{redefiningFeature.owningType} else redefiningFeature.featuringType endif in featuringTypes->forAll(t | let direction : FeatureDirectionKind = t.directionOf(redefinedFeature) in ((direction = FeatureDirectionKind::_'in' or direction = FeatureDirectionKind::out) implies redefiningFeature.direction = direction) and (direction = FeatureDirectionKind::inout implies redefiningFeature.direction <> null))" .

sysml2:ReferenceSubsetting a owl:Class ;
    rdfs:label "ReferenceSubsetting"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Features" ;
    skos:definition "ReferenceSubsetting is a kind of Subsetting in which the referencedFeature is syntactically distinguished from other Features subsetted by the referencingFeature . ReferenceSubsetting has the same semantics as Subsetting , but the referencedFeature may have a special purpose relative to the referencingFeature . For instance, ReferenceSubsetting is used to identify the relatedFeatures of a Connector . ReferenceSubsetting is always an ownedRelationship of its referencingFeature . A Feature can have at most one ownedReferenceSubsetting ."@en ;
    rdfs:subClassOf sysml2:Subsetting ;
    umlmeta:oclConstraint "subsettedFeature.isConstant and subsettingFeature.isVariable implies subsettingFeature.isConstant" ;
    umlmeta:oclConstraint "subsettedFeature.isUnique implies subsettingFeature.isUnique" ;
    umlmeta:oclConstraint "subsettingFeature.canAccess(subsettedFeature)" .

sysml2:ReferenceUsage a owl:Class ;
    rdfs:label "ReferenceUsage"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "DefinitionAndUsage" ;
    skos:definition "A ReferenceUsage is a Usage that specifies a non-compositional ( isComposite = false ) reference to something. The definition of a ReferenceUsage can be any kind of Classifier , with the default being the top-level Classifier Base::Anything from the Kernel Semantic Library. This allows the specification of a generic reference without distinguishing if the thing referenced is an attribute value, item, action, etc."@en ;
    rdfs:subClassOf sysml2:Usage ;
    umlmeta:oclConstraint "isReference" .

sysml2:RenderingDefinition a owl:Class ;
    rdfs:label "RenderingDefinition"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Views" ;
    skos:definition "A RenderingDefinition is a PartDefinition that defines a specific rendering of the content of a model view (e.g., symbols, style, layout, etc.)."@en ;
    rdfs:subClassOf sysml2:PartDefinition ;
    umlmeta:oclConstraint "rendering = usages->selectByKind(RenderingUsage)" ;
    umlmeta:oclConstraint "specializesFromLibrary('Views::Rendering')" .

sysml2:RenderingUsage a owl:Class ;
    rdfs:label "RenderingUsage"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Views" ;
    skos:definition "A RenderingUsage is the usage of a RenderingDefinition to specify the rendering of a specific model view to produce a physical view artifact."@en ;
    rdfs:subClassOf sysml2:PartUsage ;
    umlmeta:oclConstraint "specializesFromLibrary('Views::renderings')" ;
    umlmeta:oclConstraint "owningType <> null and (owningType.oclIsKindOf(RenderingDefinition) or owningType.oclIsKindOf(RenderingUsage)) implies specializesFromLibrary('Views::Rendering::subrenderings')" ;
    umlmeta:oclConstraint "owningFeatureMembership <> null and owningFeatureMembership.oclIsKindOf(ViewRenderingMembership) implies redefinesFromLibrary('Views::View::viewRendering')" .

sysml2:RequirementVerificationMembership a owl:Class ;
    rdfs:label "RequirementVerificationMembership"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "VerificationCases" ;
    skos:definition "A RequirementVerificationMembership is a RequirementConstraintMembership used in the objective of a VerificationCase to identify a RequirementUsage that is verified by the VerificationCase ."@en ;
    rdfs:subClassOf sysml2:RequirementConstraintMembership ;
    umlmeta:oclConstraint "owningType.oclIsKindOf(RequirementUsage) and owningType.owningFeatureMembership <> null and owningType.owningFeatureMembership.oclIsKindOf(ObjectiveMembership)" ;
    umlmeta:oclConstraint "kind = RequirementConstraintKind::requirement" .

sysml2:ResultExpressionMembership a owl:Class ;
    rdfs:label "ResultExpressionMembership"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Functions" ;
    skos:definition "A ResultExpressionMembership is a FeatureMembership that indicates that the ownedResultExpression provides the result values for the Function or Expression that owns it. The owning Function or Expression must contain a BindingConnector between the result parameter of the ownedResultExpression and the result parameter of the owning Function or Expression ."@en ;
    rdfs:subClassOf sysml2:FeatureMembership ;
    umlmeta:oclConstraint "owningType.oclIsKindOf(Function) or owningType.oclIsKindOf(Expression)" .

sysml2:ReturnParameterMembership a owl:Class ;
    rdfs:label "ReturnParameterMembership"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Functions" ;
    skos:definition "A ReturnParameterMembership is a ParameterMembership that indicates that the ownedMemberParameter is the result parameter of a Function or Expression . The direction of the ownedMemberParameter must be out ."@en ;
    rdfs:subClassOf sysml2:ParameterMembership ;
    umlmeta:oclConstraint "owningType.oclIsKindOf(Function) or owningType.oclIsKindOf(Expression)" .

sysml2:SatisfyRequirementUsage a owl:Class ;
    rdfs:label "SatisfyRequirementUsage"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Requirements" ;
    skos:definition "A SatisfyRequirementUsage is an AssertConstraintUsage that asserts, by default, that a satisfied RequirementUsage is true for a specific satisfyingFeature , or, if isNegated = true , that the RequirementUsage is false. The satisfied RequirementUsage is related to the SatisfyRequirementUsage by a ReferenceSubsetting Relationship ."@en ;
    rdfs:subClassOf sysml2:RequirementUsage ;
    rdfs:subClassOf sysml2:AssertConstraintUsage ;
    umlmeta:oclConstraint "ownedMember->selectByKind(BindingConnector)-> select(b | b.relatedElement->includes(subjectParameter) and b.relatedElement->exists(r | r <> subjectParameter))-> size() = 1" ;
    umlmeta:oclConstraint "if isNegated then specializesFromLibrary('Requirements::notSatisfiedRequirementChecks') else specializesFromLibrary('Requirements::satisfiedRequirementChecks') endif" ;
    umlmeta:oclConstraint "satisfyingFeature = let bindings: BindingConnector = ownedMember-> selectByKind(BindingConnector)-> select(b | b.relatedElement->includes(subjectParameter)) in if bindings->isEmpty() or bindings->first().relatedElement->exits(r | r <> subjectParameter) then null else bindings->first().relatedElement->any(r | r <> subjectParameter) endif" ;
    umlmeta:oclConstraint "referencedFeatureTarget() <> null implies referencedFeatureTarget().oclIsKindOf(RequirementUsage)" .

sysml2:SelectExpression a owl:Class ;
    rdfs:label "SelectExpression"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Expressions" ;
    skos:definition "A SelectExpression is an OperatorExpression whose operator is \"select\" , which resolves to the Function ControlFunctions::select from the Kernel Functions Library."@en ;
    rdfs:subClassOf sysml2:OperatorExpression ;
    umlmeta:oclConstraint "operator = 'select'" ;
    umlmeta:oclConstraint "arguments->notEmpty() implies result.specializes(arguments->first().result)" .

sysml2:SendActionUsage a owl:Class ;
    rdfs:label "SendActionUsage"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Actions" ;
    skos:definition "A SendActionUsage is an ActionUsage that specifies the sending of a payload given by the result of its payloadArgument Expression via a MessageTransfer whose source is given by the result of the senderArgument Expression and whose target is given by the result of the receiverArgument Expression . If no senderArgument is provided, the default is the this context for the action. If no receiverArgument is given, then the receiver is to be determined by, e.g., outgoing Connections from the sender."@en ;
    rdfs:subClassOf sysml2:ActionUsage ;
    umlmeta:oclConstraint "senderArgument = argument(2)" ;
    umlmeta:oclConstraint "isSubactionUsage() implies specializesFromLibrary('Actions::Action::acceptSubactions')" ;
    umlmeta:oclConstraint "receiverArgument = argument(3)" ;
    umlmeta:oclConstraint "inputParameters()->size() >= 3" ;
    umlmeta:oclConstraint "payloadArgument = argument(1)" ;
    umlmeta:oclConstraint "specializesFromLibrary('Actions::sendActions')" .

sysml2:StakeholderMembership a owl:Class ;
    rdfs:label "StakeholderMembership"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Requirements" ;
    skos:definition "A StakeholderMembership is a ParameterMembership that identifies a PartUsage as a stakeholderParameter of a RequirementDefinition or RequirementUsage , which specifies a role played by an entity with concerns framed by the owningType ."@en ;
    rdfs:subClassOf sysml2:ParameterMembership ;
    umlmeta:oclConstraint "owningType.oclIsKindOf(RequirementUsage) or owningType.oclIsKindOf(RequirementDefinition)" .

sysml2:StateDefinition a owl:Class ;
    rdfs:label "StateDefinition"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "States" ;
    skos:definition "A StateDefinition is the Definition of the Behavior of a system or part of a system in a certain state condition. A StateDefinition may be related to up to three of its ownedFeatures by StateBehaviorMembership Relationships , all of different kinds , corresponding to the entry, do and exit actions of the StateDefinition ."@en ;
    rdfs:subClassOf sysml2:ActionDefinition ;
    umlmeta:oclConstraint "state = action->selectByKind(StateUsage)" ;
    umlmeta:oclConstraint "doAction = let doMemberships : Sequence(StateSubactionMembership) = ownedMembership-> selectByKind(StateSubactionMembership)-> select(kind = StateSubactionKind::do) in if doMemberships->isEmpty() then null else doMemberships->at(1) endif" ;
    umlmeta:oclConstraint "entryAction = let entryMemberships : Sequence(StateSubactionMembership) = ownedMembership-> selectByKind(StateSubactionMembership)-> select(kind = StateSubactionKind::entry) in if entryMemberships->isEmpty() then null else entryMemberships->at(1) endif" ;
    umlmeta:oclConstraint "specializesFromLibrary('States::StateAction')" ;
    umlmeta:oclConstraint "isParallel implies ownedAction.incomingTransition->isEmpty() and ownedAction.outgoingTransition->isEmpty()" ;
    umlmeta:oclConstraint "ownedMembership-> selectByKind(StateSubactionMembership)-> isUnique(kind)" ;
    umlmeta:oclConstraint "exitAction = let exitMemberships : Sequence(StateSubactionMembership) = ownedMembership-> selectByKind(StateSubactionMembership)-> select(kind = StateSubactionKind::exit) in if exitMemberships->isEmpty() then null else exitMemberships->at(1) endif" .

sysml2:StateSubactionMembership a owl:Class ;
    rdfs:label "StateSubactionMembership"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "States" ;
    skos:definition "A StateSubactionMembership is a FeatureMembership for an entry, do or exit ActionUsage of a StateDefinition or StateUsage ."@en ;
    rdfs:subClassOf sysml2:FeatureMembership ;
    umlmeta:oclConstraint "owningType.oclIsKindOf(StateDefinition) or owningType.oclIsKindOf(StateUsage)" .

sysml2:Subclassification a owl:Class ;
    rdfs:label "Subclassification"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Classifiers" ;
    skos:definition "Subclassification is Specialization in which both the specific and general Types are Classifier . This means all instances of the specific Classifier are also instances of the general Classifier ."@en ;
    rdfs:subClassOf sysml2:Specialization ;
    umlmeta:oclConstraint "not specific.isConjugated" .

sysml2:SubjectMembership a owl:Class ;
    rdfs:label "SubjectMembership"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Requirements" ;
    skos:definition "A SubjectMembership is a ParameterMembership that indicates that its ownedSubjectParameter is the subject of its owningType . The owningType of a SubjectMembership must be a RequirementDefinition , RequirementUsage , CaseDefinition , or CaseUsage ."@en ;
    rdfs:subClassOf sysml2:ParameterMembership ;
    umlmeta:oclConstraint "owningType.oclIsType(RequirementDefinition) or owningType.oclIsType(RequiremenCaseRequirementDefinition) or owningType.oclIsType(CaseDefinition) or owningType.oclIsType(CaseUsage)" .

sysml2:Succession a owl:Class ;
    rdfs:label "Succession"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Connectors" ;
    skos:definition "A Succession is a binary Connector that requires its relatedFeatures to happen separately in time."@en ;
    rdfs:subClassOf sysml2:Connector ;
    umlmeta:oclConstraint "specializesFromLibrary('Occurrences::happensBeforeLinks')" .

sysml2:SuccessionAsUsage a owl:Class ;
    rdfs:label "SuccessionAsUsage"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Connections" ;
    skos:definition "A SuccessionAsUsage is both a ConnectorAsUsage and a Succession ."@en ;
    rdfs:subClassOf sysml2:ConnectorAsUsage ;
    rdfs:subClassOf sysml2:Succession ;
    umlmeta:oclConstraint "nestedView = nestedUsage->selectByKind(ViewUsage)" ;
    umlmeta:oclConstraint "isVariation implies isAbstract" ;
    umlmeta:oclConstraint "usage = feature->selectByKind(Usage)" ;
    umlmeta:oclConstraint "ownedNested = nestedUsage->selectByKind(EnumerationUsage)" ;
    umlmeta:oclConstraint "nestedConstraint = nestedUsage->selectByKind(ConstraintUsage)" ;
    umlmeta:oclConstraint "nestedOccurrence = nestedUsage->selectByKind(OccurrenceUsage)" ;
    umlmeta:oclConstraint "nestedViewpoint = nestedUsage->selectByKind(ViewpointUsage)" ;
    umlmeta:oclConstraint "nestedAction = nestedUsage->selectByKind(ActionUsage)" ;
    umlmeta:oclConstraint "nestedFlow = nestedUsage->selectByKind(FlowConnectionUsage)" ;
    umlmeta:oclConstraint "owningVariationUsage <> null implies specializes(owningVariationUsage)" ;
    umlmeta:oclConstraint "isVariation implies ownedFeatureMembership->isEmpty()" ;
    umlmeta:oclConstraint "nestedItem = nestedUsage->selectByKind(ItemUsage)" ;
    umlmeta:oclConstraint "isVariation implies not ownedSpecialization.specific->exists( oclIsKindOf(Definition) and oclAsType(Definition).isVariation or oclIsKindOf(Usage) and oclAsType(Usage).isVariation)" ;
    umlmeta:oclConstraint "nestedState = nestedUsage->selectByKind(StateUsage)" ;
    umlmeta:oclConstraint "nestedConcern = nestedUsage->selectByKind(ConcernUsage)" ;
    umlmeta:oclConstraint "nestedVerificationCase = nestedUsage->selectByKind(VerificationCaseUsage)" ;
    umlmeta:oclConstraint "nestedCalculation = nestedUsage->selectByKind(CalculationUsage)" ;
    umlmeta:oclConstraint "nestedAttribute = nestedUsage->selectByKind(AttributeUsage)" ;
    umlmeta:oclConstraint "directedUsage = directedFeature->selectByKind(Usage)" ;
    umlmeta:oclConstraint "nestedPart = nestedUsage->selectByKind(PartUsage)" ;
    umlmeta:oclConstraint "nestedMetadata = nestedUsage->selectByKind(MetadataUsage)" ;
    umlmeta:oclConstraint "nestedAllocation = nestedUsage->selectByKind(AllocationUsage)" ;
    umlmeta:oclConstraint "nestedUsage = ownedFeature->selectByKind(Usage)" ;
    umlmeta:oclConstraint "nestedRendering = nestedUsage->selectByKind(RenderingUsage)" ;
    umlmeta:oclConstraint "nestedConnection = nestedUsage->selectByKind(ConnectorAsUsage)" ;
    umlmeta:oclConstraint "variantMembership = ownedMembership->selectByKind(VariantMembership)" ;
    umlmeta:oclConstraint "nestedReference = nestedUsage->selectByKind(ReferenceUsage)" ;
    umlmeta:oclConstraint "nestedUseCase = nestedUsage->selectByKind(UseCaseUsage)" ;
    umlmeta:oclConstraint "mayTimeVary = owningType <> null and owningType.specializesFromLibrary('Occurrences::Occurrence') and not ( isPortion or specializesFromLibrary('Links::SelfLink') or specializesFromLibrary('Occurrences::HappensLink') or isComposite and specializesFromLibrary('Actions::Action') )" ;
    umlmeta:oclConstraint "nestedRequirement = nestedUsage->selectByKind(RequirementUsage)" ;
    umlmeta:oclConstraint "nestedPort = nestedUsage->selectByKind(PortUsage)" ;
    umlmeta:oclConstraint "direction <> null or isEnd or featuringType->isEmpty() implies isReference" ;
    umlmeta:oclConstraint "nestedTransition = nestedUsage->selectByKind(TransitionUsage)" ;
    umlmeta:oclConstraint "nestedInterface = nestedUsage->selectByKind(ReferenceUsage)" ;
    umlmeta:oclConstraint "nestedAnalysisCase = nestedUsage->selectByKind(AnalysisCaseUsage)" ;
    umlmeta:oclConstraint "nestedCase = nestedUsage->selectByKind(CaseUsage)" ;
    umlmeta:oclConstraint "isReference = not isComposite" ;
    umlmeta:oclConstraint "variant = variantMembership.ownedVariantUsage" ;
    umlmeta:oclConstraint "owningVariationDefinition <> null implies specializes(owningVariationDefinition)" ;
    umlmeta:oclConstraint "owningVariationUsage <> null implies featuringType->asSet() = owningVariationUsage.featuringType->asSet()" .

sysml2:SuccessionFlow a owl:Class ;
    rdfs:label "SuccessionFlow"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Interactions" ;
    skos:definition "A SuccessionFlow is a Flow that also provides temporal ordering. It classifies Transfers that cannot start until the source Occurrence has completed and that must complete before the target Occurrence can start."@en ;
    rdfs:subClassOf sysml2:Succession ;
    rdfs:subClassOf sysml2:Flow ;
    umlmeta:oclConstraint "specializesFromLibrary('Transfers::flowTransfersBefore')" .

sysml2:SuccessionFlowUsage a owl:Class ;
    rdfs:label "SuccessionFlowUsage"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Flows" ;
    skos:definition "A SuccessionFlowUsage is a FlowUsage that is also a KerML SuccessionFlow ."@en ;
    rdfs:subClassOf sysml2:FlowUsage ;
    rdfs:subClassOf sysml2:SuccessionFlow ;
    umlmeta:oclConstraint "specializesFromLibrary('Flows::successionFlows')" .

sysml2:TerminateActionUsage a owl:Class ;
    rdfs:label "TerminateActionUsage"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Actions" ;
    skos:definition "A TerminateActionUsage is an ActionUsage that directly or indirectly specializes the ActionDefinition TerminateAction from the Systems Model Library, which causes a given terminatedOccurrence to end during its performance. By default, the terminatedOccurrence is the featuring instance ( that ) of the performance of the TerminateActionUsage , generally the performance of its immediately containing ActionDefinition or ActionUsage ."@en ;
    rdfs:subClassOf sysml2:ActionUsage ;
    umlmeta:oclConstraint "specializesFromLibrary('Actions::terminateActions')" ;
    umlmeta:oclConstraint "terminatedOccurrenceArgument = argument(1)" ;
    umlmeta:oclConstraint "isSubactionUsage() implies specializesFromLibrary('Actions::Action::terminateSubactions')" .

sysml2:TextualRepresentation a owl:Class ;
    rdfs:label "TextualRepresentation"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Annotations" ;
    skos:definition "A TextualRepresentation is an AnnotatingElement whose body represents the representedElement in a given language . The representedElement must be the owner of the TextualRepresentation . The named language can be a natural language, in which case the body is an informal representation, or an artificial language, in which case the body is expected to be a formal, machine-parsable representation. If the named language of a TextualRepresentation is machine-parsable, then the body text should be legal input text as defined for that language . The interpretation of the named language string shall be case insensitive. The following language names are defined to correspond to the giv...[truncated]"@en ;
    rdfs:subClassOf sysml2:AnnotatingElement ;
    umlmeta:oclConstraint "annotation = if owningAnnotatingRelationship = null then ownedAnnotatingRelationship else owningAnnotatingRelationship->prepend(owningAnnotatingRelationship) endif" ;
    umlmeta:oclConstraint "annotatedElement = if annotation->notEmpty() then annotation.annotatedElement else Sequence{owningNamespace} endif" ;
    umlmeta:oclConstraint "ownedAnnotatingRelationship = ownedRelationship-> selectByKind(Annotation)-> select(a | a.annotatedElement <> self)" .

sysml2:TransitionFeatureMembership a owl:Class ;
    rdfs:label "TransitionFeatureMembership"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "States" ;
    skos:definition "A TransitionFeatureMembership is a FeatureMembership for a trigger, guard or effect of a TransitionUsage , whose transitionFeature is a AcceptActionUsage , Boolean -valued Expression or ActionUsage , depending on its kind ."@en ;
    rdfs:subClassOf sysml2:FeatureMembership ;
    umlmeta:oclConstraint "kind = TransitionFeatureKind::guard implies transitionFeature.oclIsKindOf(Expression) and let guard : Expression = transitionFeature.oclIsKindOf(Expression) in guard.result.specializesFromLibrary('ScalarValues::Boolean') and guard.result.multiplicity <> null and guard.result.multiplicity.hasBounds(1,1)" ;
    umlmeta:oclConstraint "owningType.oclIsKindOf(TransitionUsage)" ;
    umlmeta:oclConstraint "kind = TransitionFeatureKind::effect implies transitionFeature.oclIsKindOf(ActionUsage)" ;
    umlmeta:oclConstraint "kind = TransitionFeatureKind::trigger implies transitionFeature.oclIsKindOf(AcceptActionUsage)" .

sysml2:TransitionUsage a owl:Class ;
    rdfs:label "TransitionUsage"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "States" ;
    skos:definition "A TransitionUsage is an ActionUsage representing a triggered transition between ActionUsages or StateUsages . When triggered by a triggerAction , when its guardExpression is true, the TransitionUsage asserts that its source is exited, then its effectAction (if any) is performed, and then its target is entered. A TransitionUsage can be related to some of its ownedFeatures using TransitionFeatureMembership Relationships , corresponding to the triggerAction , guardExpression and effectAction of the TransitionUsage ."@en ;
    rdfs:subClassOf sysml2:ActionUsage ;
    umlmeta:oclConstraint "target = if succession.targetFeature->isEmpty() then null else let targetFeature : Feature = succession.targetFeature->first().featureTarget in if not targetFeature.oclIsKindOf(ActionUsage) then null else targetFeature.oclAsType(ActionUsage) endif endif" ;
    umlmeta:oclConstraint "specializesFromLibrary('Actions::transitionActions')" ;
    umlmeta:oclConstraint "let successions : Sequence(Successions) = ownedMember->selectByKind(Succession) in successions->notEmpty() and successions->at(1).targetFeature.featureTarget-> forAll(oclIsKindOf(ActionUsage))" ;
    umlmeta:oclConstraint "guardExpression = ownedFeatureMembership-> selectByKind(TransitionFeatureMembership)-> select(kind = TransitionFeatureKind::trigger).transitionFeature-> selectByKind(Expression)" ;
    umlmeta:oclConstraint "source = let sourceFeature : Feature = sourceFeature() in if sourceFeature = null then null else sourceFeature.featureTarget.oclAsType(ActionUsage)" ;
    umlmeta:oclConstraint "source <> null and not source.oclIsKindOf(StateUsage) implies triggerAction->isEmpty()" ;
    umlmeta:oclConstraint "triggerAction = ownedFeatureMembership-> selectByKind(TransitionFeatureMembership)-> select(kind = TransitionFeatureKind::trigger).transitionFeatures-> selectByKind(AcceptActionUsage)" ;
    umlmeta:oclConstraint "ownedMember->selectByKind(BindingConnector)->exists(b | b.relatedFeatures->includes(succession) and b.relatedFeatures->includes(resolveGlobal( 'TransitionPerformances::TransitionPerformance::transitionLink')))" ;
    umlmeta:oclConstraint "ownedMember->selectByKind(BindingConnector)->exists(b | b.relatedFeatures->includes(source) and b.relatedFeatures->includes(inputParameter(1)))" ;
    umlmeta:oclConstraint "triggerAction->notEmpty() implies let payloadParameter : Feature = inputParameter(2) in payloadParameter <> null and payloadParameter.subsetsChain(triggerAction->at(1), triggerPayloadParameter())" ;
    umlmeta:oclConstraint "triggerAction->forAll(specializesFromLibrary('Actions::TransitionAction::accepter') and guardExpression->forAll(specializesFromLibrary('Actions::TransitionAction::guard') and effectAction->forAll(specializesFromLibrary('Actions::TransitionAction::effect'))" ;
    umlmeta:oclConstraint "succession.sourceFeature = source" ;
    umlmeta:oclConstraint "isComposite and owningType <> null and (owningType.oclIsKindOf(StateDefinition) or owningType.oclIsKindOf(StateUsage)) and source <> null and source.oclIsKindOf(StateUsage) implies specializesFromLibrary('States::StateAction::stateTransitions')" ;
    umlmeta:oclConstraint "succession = ownedMember->selectByKind(Succession)->at(1)" ;
    umlmeta:oclConstraint "if triggerAction->isEmpty() then inputParameters()->size() >= 1 else inputParameters()->size() >= 2 endif" ;
    umlmeta:oclConstraint "triggerAction = ownedFeatureMembership-> selectByKind(TransitionFeatureMembership)-> select(kind = TransitionFeatureKind::trigger).transitionFeature-> selectByKind(AcceptActionUsage)" ;
    umlmeta:oclConstraint "isComposite and owningType <> null and (owningType.oclIsKindOf(ActionDefinition) or owningType.oclIsKindOf(ActionUsage)) and source <> null and not source.oclIsKindOf(StateUsage) implies specializesFromLibrary('Actions::Action::decisionTransitions')" .

sysml2:TriggerInvocationExpression a owl:Class ;
    rdfs:label "TriggerInvocationExpression"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Actions" ;
    skos:definition "A TriggerInvocationExpression is an InvocationExpression that invokes one of the trigger Functions from the Kernel Semantic Library Triggers package, as indicated by its kind ."@en ;
    rdfs:subClassOf sysml2:InvocationExpression ;
    umlmeta:oclConstraint "kind = TriggerKind::after implies argument->notEmpty() and argument->at(1).result.specializesFromLibrary('Quantities::ScalarQuantityValue') and let mRef : Element = resolveGlobal('Quantities::TensorQuantityValue::mRef').ownedMemberElement in argument->at(1).result.feature-> select(ownedRedefinition.redefinedFeature-> closure(ownedRedefinition.redefinedFeature)-> includes(mRef))-> exists(specializesFromLibrary('ISQBase::DurationUnit'))" ;
    umlmeta:oclConstraint "kind = TriggerKind::at implies argument->notEmpty() and argument->at(1).result.specializesFromLibrary('Time::TimeInstantValue')" ;
    umlmeta:oclConstraint "kind = TriggerKind::when implies argument->notEmpty() and argument->at(1).oclIsKindOf(FeatureReferenceExpression) and let referent : Feature = argument->at(1).oclAsType(FeatureReferenceExpression).referent in referent.oclIsKindOf(Expression) and referent.oclAsType(Expression).result.specializesFromLibrary('ScalarValues::Boolean')" .

sysml2:TypeFeaturing a owl:Class ;
    rdfs:label "TypeFeaturing"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Features" ;
    skos:definition "A TypeFeaturing is a Featuring Relationship in which the featureOfType is the source and the featuringType is the target ."@en ;
    rdfs:subClassOf sysml2:Relationship ;
    umlmeta:oclConstraint "relatedElement = source->union(target)" .

sysml2:Unioning a owl:Class ;
    rdfs:label "Unioning"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Types" ;
    skos:definition "Unioning is a Relationship that makes its unioningType one of the unioningTypes of its typeUnioned ."@en ;
    rdfs:subClassOf sysml2:Relationship ;
    umlmeta:oclConstraint "relatedElement = source->union(target)" .

sysml2:UseCaseDefinition a owl:Class ;
    rdfs:label "UseCaseDefinition"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "UseCases" ;
    skos:definition "A UseCaseDefinition is a CaseDefinition that specifies a set of actions performed by its subject, in interaction with one or more actors external to the subject. The objective is to yield an observable result that is of value to one or more of the actors."@en ;
    rdfs:subClassOf sysml2:CaseDefinition ;
    umlmeta:oclConstraint "includedUseCase = ownedUseCase-> selectByKind(IncludeUseCaseUsage). useCaseIncluded" ;
    umlmeta:oclConstraint "specializesFromLibrary('UseCases::UseCase')" .

sysml2:VariantMembership a owl:Class ;
    rdfs:label "VariantMembership"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "DefinitionAndUsage" ;
    skos:definition "A VariantMembership is a Membership between a variation point Definition or Usage and a Usage that represents a variant in the context of that variation. The membershipOwningNamespace for the VariantMembership must be either a Definition or a Usage with isVariation = true ."@en ;
    rdfs:subClassOf sysml2:OwningMembership ;
    umlmeta:oclConstraint "membershipOwningNamespace.oclIsKindOf(Definition) and membershipOwningNamespace.oclAsType(Definition).isVariation or membershipOwningNamespace.oclIsKindOf(Usage) and membershipOwningNamespace.oclAsType(Usage).isVariation" .

sysml2:VerificationCaseDefinition a owl:Class ;
    rdfs:label "VerificationCaseDefinition"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "VerificationCases" ;
    skos:definition "A VerificationCaseDefinition is a CaseDefinition for the purpose of verification of the subject of the case against its requirements."@en ;
    rdfs:subClassOf sysml2:CaseDefinition ;
    umlmeta:oclConstraint "verifiedRequirement = if objectiveRequirement = null then OrderedSet{} else objectiveRequirement.featureMembership-> selectByKind(RequirementVerificationMembership). verifiedRequirement->asOrderedSet() endif" ;
    umlmeta:oclConstraint "specializesFromLibrary('VerificationCases::VerificationCase')" .

sysml2:VerificationCaseUsage a owl:Class ;
    rdfs:label "VerificationCaseUsage"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "VerificationCases" ;
    skos:definition "A VerificationCaseUsage is a Usage of a VerificationCaseDefinition ."@en ;
    rdfs:subClassOf sysml2:CaseUsage ;
    umlmeta:oclConstraint "verifiedRequirement = if objectiveRequirement = null then OrderedSet{} else objectiveRequirement.featureMembership-> selectByKind(RequirementVerificationMembership). verifiedRequirement->asOrderedSet() endif" ;
    umlmeta:oclConstraint "specializesFromLibrary('VerificationCases::verificationCases')" ;
    umlmeta:oclConstraint "isComposite and owningType <> null and (owningType.oclIsKindOf(VerificationCaseDefinition) or owningType.oclIsKindOf(VerificationCaseUsage)) implies specializesFromLibrary('VerificationCases::VerificationCase::subVerificationCases')" .

sysml2:ViewDefinition a owl:Class ;
    rdfs:label "ViewDefinition"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Views" ;
    skos:definition "A ViewDefinition is a PartDefinition that specifies how a view artifact is constructed to satisfy a viewpoint . It specifies a viewConditions to define the model content to be presented and a viewRendering to define how the model content is presented."@en ;
    rdfs:subClassOf sysml2:PartDefinition ;
    umlmeta:oclConstraint "viewCondition = ownedMembership-> selectByKind(ElementFilterMembership). condition" ;
    umlmeta:oclConstraint "satisfiedViewpoint = ownedRequirement-> selectByKind(ViewpointUsage)-> select(isComposite)" ;
    umlmeta:oclConstraint "viewRendering = let renderings: OrderedSet(ViewRenderingMembership) = featureMembership->selectByKind(ViewRenderingMembership) in if renderings->isEmpty() then null else renderings->first().referencedRendering endif" ;
    umlmeta:oclConstraint "specializesFromLibrary('Views::View')" ;
    umlmeta:oclConstraint "view = usage->selectByKind(ViewUsage)" ;
    umlmeta:oclConstraint "featureMembership-> selectByKind(ViewRenderingMembership)-> size() <= 1" .

sysml2:ViewRenderingMembership a owl:Class ;
    rdfs:label "ViewRenderingMembership"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Views" ;
    skos:definition "A ViewRenderingMembership is a FeatureMembership that identifies the viewRendering of a ViewDefinition or ViewUsage ."@en ;
    rdfs:subClassOf sysml2:FeatureMembership ;
    umlmeta:oclConstraint "referencedRendering = let referencedFeature : Feature = ownedRendering.referencedFeatureTarget() in if referencedFeature = null then ownedRendering else if referencedFeature.oclIsKindOf(RenderingUsage) then refrencedFeature.oclAsType(RenderingUsage) else null endif endif" ;
    umlmeta:oclConstraint "owningType.oclIsKindOf(ViewDefinition) or owningType.oclIsKindOf(ViewUsage)" .

sysml2:ViewUsage a owl:Class ;
    rdfs:label "ViewUsage"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Views" ;
    skos:definition "A ViewUsage is a usage of a ViewDefinition to specify the generation of a view of the members of a collection of exposedNamespaces . The ViewUsage can satisfy more viewpoints than its definition, and it can specialize the viewRendering specified by its definition."@en ;
    rdfs:subClassOf sysml2:PartUsage ;
    umlmeta:oclConstraint "owningType <> null and (owningType.oclIsKindOf(ViewDefinition) or owningType.oclIsKindOf(ViewUsage)) implies specializesFromLibrary('Views::View::subviews')" ;
    umlmeta:oclConstraint "satisfiedViewpoint = ownedRequirement-> selectByKind(ViewpointUsage)-> select(isComposite)" ;
    umlmeta:oclConstraint "specializesFromLibrary('Views::views')" ;
    umlmeta:oclConstraint "exposedElement = ownedImport->selectByKind(Expose). importedMemberships(Set{}).memberElement-> select(elm | includeAsExposed(elm))-> asOrderedSet()" ;
    umlmeta:oclConstraint "featureMembership-> selectByKind(ViewRenderingMembership)-> size() <= 1" ;
    umlmeta:oclConstraint "viewCondition = ownedMembership-> selectByKind(ElementFilterMembership). condition" ;
    umlmeta:oclConstraint "viewRendering = let renderings: OrderedSet(ViewRenderingMembership) = featureMembership->selectByKind(ViewRenderingMembership) in if renderings->isEmpty() then null else renderings->first().referencedRendering endif" .

sysml2:ViewpointDefinition a owl:Class ;
    rdfs:label "ViewpointDefinition"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Views" ;
    skos:definition "A ViewpointDefinition is a RequirementDefinition that specifies one or more stakeholder concerns that are to be satisfied by creating a view of a model."@en ;
    rdfs:subClassOf sysml2:RequirementDefinition ;
    umlmeta:oclConstraint "viewpointStakeholder = framedConcern.featureMemberhsip-> selectByKind(StakeholderMembership). ownedStakeholderParameter" ;
    umlmeta:oclConstraint "specializesFromLibrary('Views::Viewpoint')" .

sysml2:ViewpointUsage a owl:Class ;
    rdfs:label "ViewpointUsage"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Views" ;
    skos:definition "A ViewpointUsage is a Usage of a ViewpointDefinition ."@en ;
    rdfs:subClassOf sysml2:RequirementUsage ;
    umlmeta:oclConstraint "isComposite and owningType <> null and (owningType.oclIsKindOf(ViewDefinition) or owningType.oclIsKindOf(ViewUsage)) implies specializesFromLibrary('Views::View::viewpointSatisfactions')" ;
    umlmeta:oclConstraint "specializesFromLibrary('Views::viewpoints')" ;
    umlmeta:oclConstraint "viewpointStakeholder = framedConcern.featureMemberhsip-> selectByKind(StakeholderMembership). ownedStakeholderParameter" .

sysml2:WhileLoopActionUsage a owl:Class ;
    rdfs:label "WhileLoopActionUsage"@en ;
    umlmeta:language "SysML v2"@en ;
    umlmeta:omgPackage "Actions" ;
    skos:definition "A WhileLoopActionUsage is a LoopActionUsage that specifies that the bodyAction ActionUsage should be performed repeatedly while the result of the whileArgument Expression is true or until the result of the untilArgument Expression (if provided) is true. The whileArgument Expression is evaluated before each (possible) performance of the bodyAction , and the untilArgument Expression is evaluated after each performance of the bodyAction ."@en ;
    rdfs:subClassOf sysml2:LoopActionUsage ;
    umlmeta:oclConstraint "specializesFromLibrary('Actions::whileLoopActions')" ;
    umlmeta:oclConstraint "whileArgument = let parameter : Feature = inputParameter(1) in if parameter <> null and parameter.oclIsKindOf(Expression) then parameter.oclAsType(Expression) else null endif" ;
    umlmeta:oclConstraint "inputParameters()->size() >= 2" ;
    umlmeta:oclConstraint "untilArgument = let parameter : Feature = inputParameter(3) in if parameter <> null and parameter.oclIsKindOf(Expression) then parameter.oclAsType(Expression) else null endif" ;
    umlmeta:oclConstraint "isSubactionUsage() implies specializesFromLibrary('Actions::Action::whileLoops')" .

