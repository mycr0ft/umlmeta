uml:DurationInterval a owl:Class ;
    rdfs:label "DurationInterval"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Values" ;
    skos:definition "A DurationInterval defines the range between two Durations."@en ;
    rdfs:subClassOf uml:Interval ;
