@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix umlmeta: <https://mycr0ft.github.io/umlmeta/ns#> .
@prefix bpmn: <https://mycr0ft.github.io/umlmeta/ontology/uml-family-relationships/bpmn#> .
@prefix sp: <https://mycr0ft.github.io/umlmeta/ontology/uml-family-relationships/sp#> .
@prefix sysml: <https://mycr0ft.github.io/umlmeta/ontology/uml-family-relationships/sysml#> .
@prefix sysml2: <https://mycr0ft.github.io/umlmeta/ontology/uml-family-relationships/sysml2#> .
@prefix uaf: <https://mycr0ft.github.io/umlmeta/ontology/uml-family-relationships/uaf#> .
@prefix uml: <https://mycr0ft.github.io/umlmeta/ontology/uml-family-relationships/uml#> .

<https://mycr0ft.github.io/umlmeta/ontology/uml-family-relationships> a owl:Ontology ;
    rdfs:label "UML-family relationship ontology"@en ;
    rdfs:comment "Generated from the OMG metamodel feeds preserved by umlmeta. Class hierarchy, property domains and ranges, multiplicities, composites, subset links, recorded opposites and normative OCL constraints are stated facts; the relationship matrix keeps stated, implied and observed apart."@en ;
    owl:versionInfo "1" .

umlmeta:language a owl:AnnotationProperty .
umlmeta:omgPackage a owl:AnnotationProperty .
umlmeta:abstract a owl:AnnotationProperty .
umlmeta:stereotypeUri a owl:AnnotationProperty .
umlmeta:oclConstraint a owl:AnnotationProperty .
umlmeta:composite a owl:AnnotationProperty .
umlmeta:derived a owl:AnnotationProperty .

uml:Element a owl:Class ;
    rdfs:label "Element"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "CommonStructure" ;
    umlmeta:abstract true ;
    skos:definition "An Element is a constituent of a model. As such, it has the capability of owning other Elements."@en ;
    umlmeta:oclConstraint "mustBeOwned() implies owner->notEmpty()" ;
    umlmeta:oclConstraint "not allOwnedElements()->includes(self)" .

uml:Relationship a owl:Class ;
    rdfs:label "Relationship"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "CommonStructure" ;
    umlmeta:abstract true ;
    skos:definition "Relationship is an abstract concept that specifies some kind of relationship between Elements."@en ;
    rdfs:subClassOf uml:Element ;
    umlmeta:oclConstraint "mustBeOwned() implies owner->notEmpty()" ;
    umlmeta:oclConstraint "not allOwnedElements()->includes(self)" .

uml:DirectedRelationship a owl:Class ;
    rdfs:label "DirectedRelationship"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "CommonStructure" ;
    umlmeta:abstract true ;
    skos:definition "A DirectedRelationship represents a relationship between a collection of source model Elements and a collection of target model Elements."@en ;
    rdfs:subClassOf uml:Relationship ;
    umlmeta:oclConstraint "mustBeOwned() implies owner->notEmpty()" ;
    umlmeta:oclConstraint "not allOwnedElements()->includes(self)" .

uml:ParameterableElement a owl:Class ;
    rdfs:label "ParameterableElement"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "CommonStructure" ;
    umlmeta:abstract true ;
    skos:definition "A ParameterableElement is an Element that can be exposed as a formal TemplateParameter for a template, or specified as an actual parameter in a binding of a template."@en ;
    rdfs:subClassOf uml:Element ;
    umlmeta:oclConstraint "mustBeOwned() implies owner->notEmpty()" ;
    umlmeta:oclConstraint "not allOwnedElements()->includes(self)" .

uml:NamedElement a owl:Class ;
    rdfs:label "NamedElement"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "CommonStructure" ;
    umlmeta:abstract true ;
    skos:definition "A NamedElement is an Element in a model that may have a name. The name may be given directly and/or via the use of a StringExpression."@en ;
    rdfs:subClassOf uml:Element ;
    umlmeta:oclConstraint "(namespace = null and owner <> null) implies visibility = null" ;
    umlmeta:oclConstraint "(name <> null and allNamespaces()->select(ns | ns.name = null)->isEmpty()) implies qualifiedName = allNamespaces()->iterate( ns : Namespace; agg: String = name | ns.name.concat(self.separator()).concat(agg))" ;
    umlmeta:oclConstraint "name=null or allNamespaces()->select( ns | ns.name=null )->notEmpty() implies qualifiedName = null" .

uml:PackageableElement a owl:Class ;
    rdfs:label "PackageableElement"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "CommonStructure" ;
    umlmeta:abstract true ;
    skos:definition "A PackageableElement is a NamedElement that may be owned directly by a Package. A PackageableElement is also able to serve as the parameteredElement of a TemplateParameter."@en ;
    rdfs:subClassOf uml:ParameterableElement ;
    rdfs:subClassOf uml:NamedElement ;
    umlmeta:oclConstraint "visibility = null implies namespace = null" .

uml:Dependency a owl:Class ;
    rdfs:label "Dependency"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "CommonStructure" ;
    skos:definition "A Dependency is a Relationship that signifies that a single model Element or a set of model Elements requires other model Elements for their specification or implementation. This means that the complete semantics of the client Element(s) are either semantically or structurally dependent on the definition of the supplier Element(s)."@en ;
    rdfs:subClassOf uml:DirectedRelationship ;
    rdfs:subClassOf uml:PackageableElement ;
    umlmeta:oclConstraint "visibility = null implies namespace = null" .

uml:Abstraction a owl:Class ;
    rdfs:label "Abstraction"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "CommonStructure" ;
    skos:definition "An Abstraction is a Relationship that relates two Elements or sets of Elements that represent the same concept at different levels of abstraction or from different viewpoints."@en ;
    rdfs:subClassOf uml:Dependency ;
    umlmeta:oclConstraint "visibility = null implies namespace = null" .

uml:RedefinableElement a owl:Class ;
    rdfs:label "RedefinableElement"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Classification" ;
    umlmeta:abstract true ;
    skos:definition "A RedefinableElement is an element that, when defined in the context of a Classifier, can be redefined more specifically or differently in the context of another Classifier that specializes (directly or indirectly) the context Classifier."@en ;
    rdfs:subClassOf uml:NamedElement ;
    umlmeta:oclConstraint "redefinedElement->forAll(re | re.isConsistentWith(self))" ;
    umlmeta:oclConstraint "redefinedElement->forAll(re | not re.isLeaf)" ;
    umlmeta:oclConstraint "redefinedElement->forAll(re | self.isRedefinitionContextValid(re))" .

uml:ActivityNode a owl:Class ;
    rdfs:label "ActivityNode"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Activities" ;
    umlmeta:abstract true ;
    skos:definition "ActivityNode is an abstract class for points in the flow of an Activity connected by ActivityEdges."@en ;
    rdfs:subClassOf uml:RedefinableElement ;
    umlmeta:oclConstraint "redefinedElement->forAll(re | re.isConsistentWith(self))" ;
    umlmeta:oclConstraint "redefinedElement->forAll(re | not re.isLeaf)" ;
    umlmeta:oclConstraint "redefinedElement->forAll(re | self.isRedefinitionContextValid(re))" .

uml:ExecutableNode a owl:Class ;
    rdfs:label "ExecutableNode"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Activities" ;
    umlmeta:abstract true ;
    skos:definition "An ExecutableNode is an abstract class for ActivityNodes whose execution may be controlled using ControlFlows and to which ExceptionHandlers may be attached."@en ;
    rdfs:subClassOf uml:ActivityNode ;
    umlmeta:oclConstraint "redefinedElement->forAll(re | re.isConsistentWith(self))" ;
    umlmeta:oclConstraint "redefinedElement->forAll(re | not re.isLeaf)" ;
    umlmeta:oclConstraint "redefinedElement->forAll(re | self.isRedefinitionContextValid(re))" .

uml:Action a owl:Class ;
    rdfs:label "Action"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Actions" ;
    umlmeta:abstract true ;
    skos:definition "An Action is the fundamental unit of executable functionality. The execution of an Action represents some transformation or processing in the modeled system. Actions provide the ExecutableNodes within Activities and may also be used within Interactions."@en ;
    rdfs:subClassOf uml:ExecutableNode ;
    umlmeta:oclConstraint "redefinedElement->forAll(re | re.isConsistentWith(self))" ;
    umlmeta:oclConstraint "redefinedElement->forAll(re | not re.isLeaf)" ;
    umlmeta:oclConstraint "redefinedElement->forAll(re | self.isRedefinitionContextValid(re))" .

uml:AcceptEventAction a owl:Class ;
    rdfs:label "AcceptEventAction"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Actions" ;
    skos:definition "An AcceptEventAction is an Action that waits for the occurrence of one or more specific Events."@en ;
    rdfs:subClassOf uml:Action ;
    umlmeta:oclConstraint "not isUnmarshall and trigger->exists(event.oclIsKindOf(SignalEvent) or event.oclIsKindOf(TimeEvent)) implies output->size() = 1 and output->first().is(1,1)" ;
    umlmeta:oclConstraint "input->size() = 0" ;
    umlmeta:oclConstraint "(self.oclIsTypeOf(AcceptEventAction) and (trigger->forAll(event.oclIsKindOf(ChangeEvent) or event.oclIsKindOf(CallEvent)))) implies output->size() = 0" ;
    umlmeta:oclConstraint "isUnmarshall and self.oclIsTypeOf(AcceptEventAction) implies trigger->size()=1 and trigger->asSequence()->first().event.oclIsKindOf(SignalEvent) and let attribute: OrderedSet(Property) = trigger->asSequence()->first().event.oclAsType(SignalEvent).signal.allAttributes() in attribute->size()>0 and result->size() = attribute->size() and Sequence{1..result->size()}->forAll(i | result->at(i).type = attribute->at(i).type and result->at(i).isOrdered = attribute->at(i).isOrdered and result->at(i).includesMultiplicity(attribute->at(i)))" ;
    umlmeta:oclConstraint "not isUnmarshall implies result->isEmpty() or let type: Type = result->first().type in type=null or (trigger->forAll(event.oclIsKindOf(SignalEvent)) and trigger.event.oclAsType(SignalEvent).signal->forAll(s | s.conformsTo(type)))" .

uml:AcceptCallAction a owl:Class ;
    rdfs:label "AcceptCallAction"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Actions" ;
    skos:definition "An AcceptCallAction is an AcceptEventAction that handles the receipt of a synchronous call request. In addition to the values from the Operation input parameters, the Action produces an output that is needed later to supply the information to the ReplyAction necessary to return control to the caller. An AcceptCallAction is for synchronous calls. If it is used to handle an asynchronous call, execution of the subsequent ReplyAction will complete immediately with no effect."@en ;
    rdfs:subClassOf uml:AcceptEventAction ;
    umlmeta:oclConstraint "let parameter: OrderedSet(Parameter) = trigger.event->asSequence()->first().oclAsType(CallEvent).operation.inputParameters() in result->size() = parameter->size() and Sequence{1..result->size()}->forAll(i | parameter->at(i).type.conformsTo(result->at(i).type) and parameter->at(i).isOrdered = result->at(i).isOrdered and parameter->at(i).compatibleWith(result->at(i)))" ;
    umlmeta:oclConstraint "trigger->size()=1 and trigger->asSequence()->first().event.oclIsKindOf(CallEvent)" ;
    umlmeta:oclConstraint "isUnmarshall = true" .

uml:InteractionFragment a owl:Class ;
    rdfs:label "InteractionFragment"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Interactions" ;
    umlmeta:abstract true ;
    skos:definition "InteractionFragment is an abstract notion of the most general interaction unit. An InteractionFragment is a piece of an Interaction. Each InteractionFragment is conceptually like an Interaction by itself."@en ;
    rdfs:subClassOf uml:NamedElement ;
    umlmeta:oclConstraint "(namespace = null and owner <> null) implies visibility = null" ;
    umlmeta:oclConstraint "(name <> null and allNamespaces()->select(ns | ns.name = null)->isEmpty()) implies qualifiedName = allNamespaces()->iterate( ns : Namespace; agg: String = name | ns.name.concat(self.separator()).concat(agg))" ;
    umlmeta:oclConstraint "name=null or allNamespaces()->select( ns | ns.name=null )->notEmpty() implies qualifiedName = null" .

uml:ExecutionSpecification a owl:Class ;
    rdfs:label "ExecutionSpecification"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Interactions" ;
    umlmeta:abstract true ;
    skos:definition "An ExecutionSpecification is a specification of the execution of a unit of Behavior or Action within the Lifeline. The duration of an ExecutionSpecification is represented by two OccurrenceSpecifications, the start OccurrenceSpecification and the finish OccurrenceSpecification."@en ;
    rdfs:subClassOf uml:InteractionFragment ;
    umlmeta:oclConstraint "start.covered = finish.covered" .

uml:ActionExecutionSpecification a owl:Class ;
    rdfs:label "ActionExecutionSpecification"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Interactions" ;
    skos:definition "An ActionExecutionSpecification is a kind of ExecutionSpecification representing the execution of an Action."@en ;
    rdfs:subClassOf uml:ExecutionSpecification ;
    umlmeta:oclConstraint "(enclosingInteraction->notEmpty() or enclosingOperand.combinedFragment->notEmpty()) and let parentInteraction : Set(Interaction) = enclosingInteraction.oclAsType(Interaction)->asSet()->union( enclosingOperand.combinedFragment->closure(enclosingOperand.combinedFragment)-> collect(enclosingInteraction).oclAsType(Interaction)->asSet()) in (parentInteraction->size() = 1) and self.action.interaction->asSet() = parentInteraction" .

uml:TypedElement a owl:Class ;
    rdfs:label "TypedElement"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "CommonStructure" ;
    umlmeta:abstract true ;
    skos:definition "A TypedElement is a NamedElement that may have a Type specified for it."@en ;
    rdfs:subClassOf uml:NamedElement ;
    umlmeta:oclConstraint "(namespace = null and owner <> null) implies visibility = null" ;
    umlmeta:oclConstraint "(name <> null and allNamespaces()->select(ns | ns.name = null)->isEmpty()) implies qualifiedName = allNamespaces()->iterate( ns : Namespace; agg: String = name | ns.name.concat(self.separator()).concat(agg))" ;
    umlmeta:oclConstraint "name=null or allNamespaces()->select( ns | ns.name=null )->notEmpty() implies qualifiedName = null" .

uml:ObjectNode a owl:Class ;
    rdfs:label "ObjectNode"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Activities" ;
    umlmeta:abstract true ;
    skos:definition "An ObjectNode is an abstract ActivityNode that may hold tokens within the object flow in an Activity. ObjectNodes also support token selection, limitation on the number of tokens held, specification of the state required for tokens being held, and carrying control values."@en ;
    rdfs:subClassOf uml:ActivityNode ;
    rdfs:subClassOf uml:TypedElement ;
    umlmeta:oclConstraint "selection<>null implies selection.inputParameters()->size()=1 and selection.inputParameters()->forAll(p | not p.isUnique and p.is(0,*) and self.type.conformsTo(p.type)) and selection.outputParameters()->size()=1 and selection.inputParameters()->forAll(p | self.type.conformsTo(p.type))" ;
    umlmeta:oclConstraint "(selection<>null) = (ordering=ObjectNodeOrderingKind::ordered)" ;
    umlmeta:oclConstraint "(not isControlType) implies incoming->union(outgoing)->forAll(oclIsKindOf(ObjectFlow))" .

uml:MultiplicityElement a owl:Class ;
    rdfs:label "MultiplicityElement"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "CommonStructure" ;
    umlmeta:abstract true ;
    skos:definition "A multiplicity is a definition of an inclusive interval of non-negative integers beginning with a lower bound and ending with a (possibly infinite) upper bound. A MultiplicityElement embeds this information to specify the allowable cardinalities for an instantiation of the Element."@en ;
    rdfs:subClassOf uml:Element ;
    umlmeta:oclConstraint "upperBound() >= lowerBound()" ;
    umlmeta:oclConstraint "lowerBound() >= 0" ;
    umlmeta:oclConstraint "(no specification serialized)" ;
    umlmeta:oclConstraint "(no specification serialized)" ;
    umlmeta:oclConstraint "lowerValue <> null implies lowerValue.integerValue() <> null" ;
    umlmeta:oclConstraint "upperValue <> null implies upperValue.unlimitedValue() <> null" .

uml:Pin a owl:Class ;
    rdfs:label "Pin"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Actions" ;
    umlmeta:abstract true ;
    skos:definition "A Pin is an ObjectNode and MultiplicityElement that provides input values to an Action or accepts output values from an Action."@en ;
    rdfs:subClassOf uml:ObjectNode ;
    rdfs:subClassOf uml:MultiplicityElement ;
    umlmeta:oclConstraint "isControl implies isControlType" ;
    umlmeta:oclConstraint "not isUnique" .

uml:InputPin a owl:Class ;
    rdfs:label "InputPin"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Actions" ;
    skos:definition "An InputPin is a Pin that holds input values to be consumed by an Action."@en ;
    rdfs:subClassOf uml:Pin ;
    umlmeta:oclConstraint "outgoing->notEmpty() implies action<>null and action.oclIsKindOf(StructuredActivityNode) and action.oclAsType(StructuredActivityNode).allOwnedNodes()->includesAll(outgoing.target)" .

uml:ActionInputPin a owl:Class ;
    rdfs:label "ActionInputPin"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Actions" ;
    skos:definition "An ActionInputPin is a kind of InputPin that executes an Action to determine the values to input to another Action."@en ;
    rdfs:subClassOf uml:InputPin ;
    umlmeta:oclConstraint "fromAction.input->forAll(oclIsKindOf(ActionInputPin))" ;
    umlmeta:oclConstraint "fromAction.output->size() = 1" ;
    umlmeta:oclConstraint "fromAction.incoming->union(outgoing)->isEmpty() and fromAction.input.incoming->isEmpty() and fromAction.output.outgoing->isEmpty()" .

uml:Namespace a owl:Class ;
    rdfs:label "Namespace"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "CommonStructure" ;
    umlmeta:abstract true ;
    skos:definition "A Namespace is an Element in a model that owns and/or imports a set of NamedElements that can be identified by name."@en ;
    rdfs:subClassOf uml:NamedElement ;
    umlmeta:oclConstraint "membersAreDistinguishable()" ;
    umlmeta:oclConstraint "packageImport.importedPackage.oclAsType(Namespace)->excludes(self)" ;
    umlmeta:oclConstraint "elementImport.importedElement.oclAsType(Element)->excludesAll(ownedMember)" .

uml:Type a owl:Class ;
    rdfs:label "Type"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "CommonStructure" ;
    umlmeta:abstract true ;
    skos:definition "A Type constrains the values represented by a TypedElement."@en ;
    rdfs:subClassOf uml:PackageableElement ;
    umlmeta:oclConstraint "visibility = null implies namespace = null" .

uml:TemplateableElement a owl:Class ;
    rdfs:label "TemplateableElement"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "CommonStructure" ;
    umlmeta:abstract true ;
    skos:definition "A TemplateableElement is an Element that can optionally be defined as a template and bound to other templates."@en ;
    rdfs:subClassOf uml:Element ;
    umlmeta:oclConstraint "mustBeOwned() implies owner->notEmpty()" ;
    umlmeta:oclConstraint "not allOwnedElements()->includes(self)" .

uml:Classifier a owl:Class ;
    rdfs:label "Classifier"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Classification" ;
    umlmeta:abstract true ;
    skos:definition "A Classifier represents a classification of instances according to their Features."@en ;
    rdfs:subClassOf uml:Type ;
    rdfs:subClassOf uml:Namespace ;
    rdfs:subClassOf uml:RedefinableElement ;
    rdfs:subClassOf uml:TemplateableElement ;
    umlmeta:oclConstraint "parents()->forAll(c | self.maySpecializeType(c))" ;
    umlmeta:oclConstraint "powertypeExtent->forAll( gs | gs.generalization->forAll( gen | not (gen.general = self) and not gen.general.allParents()->includes(self) and not (gen.specific = self) and not self.allParents()->includes(gen.specific) ))" ;
    umlmeta:oclConstraint "parents()->forAll(not isFinalSpecialization)" ;
    umlmeta:oclConstraint "not allParents()->includes(self)" .

uml:BehavioredClassifier a owl:Class ;
    rdfs:label "BehavioredClassifier"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "SimpleClassifiers" ;
    umlmeta:abstract true ;
    skos:definition "A BehavioredClassifier may have InterfaceRealizations, and owns a set of Behaviors one of which may specify the behavior of the BehavioredClassifier itself."@en ;
    rdfs:subClassOf uml:Classifier ;
    umlmeta:oclConstraint "classifierBehavior->notEmpty() implies classifierBehavior.specification->isEmpty()" .

uml:StructuredClassifier a owl:Class ;
    rdfs:label "StructuredClassifier"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "StructuredClassifiers" ;
    umlmeta:abstract true ;
    skos:definition "StructuredClassifiers may contain an internal structure of connected elements each of which plays a role in the overall Behavior modeled by the StructuredClassifier."@en ;
    rdfs:subClassOf uml:Classifier ;
    umlmeta:oclConstraint "parents()->forAll(c | self.maySpecializeType(c))" ;
    umlmeta:oclConstraint "powertypeExtent->forAll( gs | gs.generalization->forAll( gen | not (gen.general = self) and not gen.general.allParents()->includes(self) and not (gen.specific = self) and not self.allParents()->includes(gen.specific) ))" ;
    umlmeta:oclConstraint "parents()->forAll(not isFinalSpecialization)" ;
    umlmeta:oclConstraint "not allParents()->includes(self)" .

uml:EncapsulatedClassifier a owl:Class ;
    rdfs:label "EncapsulatedClassifier"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "StructuredClassifiers" ;
    umlmeta:abstract true ;
    skos:definition "An EncapsulatedClassifier may own Ports to specify typed interaction points."@en ;
    rdfs:subClassOf uml:StructuredClassifier ;
    umlmeta:oclConstraint "parents()->forAll(c | self.maySpecializeType(c))" ;
    umlmeta:oclConstraint "powertypeExtent->forAll( gs | gs.generalization->forAll( gen | not (gen.general = self) and not gen.general.allParents()->includes(self) and not (gen.specific = self) and not self.allParents()->includes(gen.specific) ))" ;
    umlmeta:oclConstraint "parents()->forAll(not isFinalSpecialization)" ;
    umlmeta:oclConstraint "not allParents()->includes(self)" .

uml:Class a owl:Class ;
    rdfs:label "Class"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "StructuredClassifiers" ;
    skos:definition "A Class classifies a set of objects and specifies the features that characterize the structure and behavior of those objects. A Class may have an internal structure and Ports."@en ;
    rdfs:subClassOf uml:EncapsulatedClassifier ;
    rdfs:subClassOf uml:BehavioredClassifier ;
    umlmeta:oclConstraint "not isActive implies (ownedReception->isEmpty() and classifierBehavior = null)" .

uml:Behavior a owl:Class ;
    rdfs:label "Behavior"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "CommonBehavior" ;
    umlmeta:abstract true ;
    skos:definition "Behavior is a specification of how its context BehavioredClassifier changes state over time. This specification may be either a definition of possible behavior execution or emergent behavior, or a selective illustration of an interesting subset of possible executions. The latter form is typically used for capturing examples, such as a trace of a particular execution."@en ;
    rdfs:subClassOf uml:Class ;
    umlmeta:oclConstraint "specification <> null implies _'context'.ownedBehavior->select(specification=self.specification)->size() = 1" ;
    umlmeta:oclConstraint "specification <> null implies ownedParameter->size() = specification.ownedParameter->size()" ;
    umlmeta:oclConstraint "_'context'.feature->includes(specification)" .

uml:Activity a owl:Class ;
    rdfs:label "Activity"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Activities" ;
    skos:definition "An Activity is the specification of parameterized Behavior as the coordinated sequencing of subordinate units."@en ;
    rdfs:subClassOf uml:Behavior ;
    umlmeta:oclConstraint "ownedParameter->forAll(p | p.direction <> ParameterDirectionKind::inout implies node->select( oclIsKindOf(ActivityParameterNode) and oclAsType(ActivityParameterNode).parameter = p)->size()= 1)" ;
    umlmeta:oclConstraint "ownedParameter->forAll(p | p.direction = ParameterDirectionKind::inout implies let associatedNodes : Set(ActivityNode) = node->select( oclIsKindOf(ActivityParameterNode) and oclAsType(ActivityParameterNode).parameter = p) in associatedNodes->size()=2 and associatedNodes->select(incoming->notEmpty())->size() select(outgoing->notEmpty())->size()<=1 )" .

uml:ActivityEdge a owl:Class ;
    rdfs:label "ActivityEdge"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Activities" ;
    umlmeta:abstract true ;
    skos:definition "An ActivityEdge is an abstract class for directed connections between two ActivityNodes."@en ;
    rdfs:subClassOf uml:RedefinableElement ;
    umlmeta:oclConstraint "activity<>null implies source.containingActivity() = activity and target.containingActivity() = activity" .

