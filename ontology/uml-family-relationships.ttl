uml:LiteralReal a owl:Class ;
    rdfs:label "LiteralReal"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Values" ;
    skos:definition "A LiteralReal is a specification of a Real value."@en ;
    rdfs:subClassOf uml:LiteralSpecification ;
