    umlmeta:oclConstraint "memberEnd->exists(aggregation <> AggregationKind::none) implies (memberEnd->size() = 2 and memberEnd->exists(aggregation = AggregationKind::none))" ;
    umlmeta:oclConstraint "memberEnd->size() > 2 implies ownedEnd->includesAll(memberEnd)" ;
    umlmeta:oclConstraint "memberEnd->forAll(type->notEmpty())" .

uml:AssociationClass a owl:Class ;
