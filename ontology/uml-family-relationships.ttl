    umlmeta:oclConstraint "parents()->forAll(not isFinalSpecialization)" ;
    umlmeta:oclConstraint "not allParents()->includes(self)" .

uml:Association a owl:Class ;
    rdfs:label "Association"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "StructuredClassifiers" ;
    skos:definition "A link is a tuple of values that refer to typed objects. An Association classifies a set of links, each of which is an instance of the Association. Each value in the link refers to an instance of the type of the corresponding end of the Association."@en ;
    rdfs:subClassOf uml:Classifier ;
