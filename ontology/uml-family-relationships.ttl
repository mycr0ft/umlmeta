    rdfs:subClassOf uml:Node ;
    umlmeta:oclConstraint "part->forAll(oclIsKindOf(Node))" .

uml:ValueSpecification a owl:Class ;
    rdfs:label "ValueSpecification"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Values" ;
    umlmeta:abstract true ;
    skos:definition "A ValueSpecification is the specification of a (possibly empty) set of values. A ValueSpecification is a ParameterableElement that may be exposed as a formal TemplateParameter and provided as the actual parameter in the binding of a template."@en ;
    rdfs:subClassOf uml:TypedElement ;
    rdfs:subClassOf uml:PackageableElement ;
    umlmeta:oclConstraint "visibility = null implies namespace = null" .

uml:Duration a owl:Class ;
    rdfs:label "Duration"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Values" ;
    skos:definition "A Duration is a ValueSpecification that specifies the temporal distance between two time instants."@en ;
    rdfs:subClassOf uml:ValueSpecification ;
    umlmeta:oclConstraint "expr = null implies (observation->size() = 1 and observation->forAll(oclIsKindOf(DurationObservation)))" .

uml:IntervalConstraint a owl:Class ;
    rdfs:label "IntervalConstraint"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Values" ;
    skos:definition "An IntervalConstraint is a Constraint that is specified by an Interval."@en ;
    rdfs:subClassOf uml:Constraint ;
    umlmeta:oclConstraint "(no specification serialized)" ;
    umlmeta:oclConstraint "(no specification serialized)" ;
    umlmeta:oclConstraint "not constrainedElement->includes(self)" .

uml:DurationConstraint a owl:Class ;
    rdfs:label "DurationConstraint"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Values" ;
    skos:definition "A DurationConstraint is a Constraint that refers to a DurationInterval."@en ;
    rdfs:subClassOf uml:IntervalConstraint ;
    umlmeta:oclConstraint "if (constrainedElement->size() = 2) then (firstEvent->size() = 2) else (firstEvent->size() = 0) endif" ;
    umlmeta:oclConstraint "constrainedElement->size() = 1 or constrainedElement->size()=2" .

uml:Interval a owl:Class ;
    rdfs:label "Interval"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Values" ;
    skos:definition "An Interval defines the range between two ValueSpecifications."@en ;
    rdfs:subClassOf uml:ValueSpecification ;
