uml:Observation a owl:Class ;
    rdfs:label "Observation"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Values" ;
    umlmeta:abstract true ;
    skos:definition "Observation specifies a value determined by observing an event or events that occur relative to other model Elements."@en ;
    rdfs:subClassOf uml:PackageableElement ;
    umlmeta:oclConstraint "visibility = null implies namespace = null" .

uml:DurationObservation a owl:Class ;
    rdfs:label "DurationObservation"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Values" ;
    skos:definition "A DurationObservation is a reference to a duration during an execution. It points out the NamedElement(s) in the model to observe and whether the observations are when this NamedElement is entered or when it is exited."@en ;
    rdfs:subClassOf uml:Observation ;
    umlmeta:oclConstraint "if (event->size() = 2) then (firstEvent->size() = 2) else (firstEvent->size() = 0) endif" .

uml:ElementImport a owl:Class ;
    rdfs:label "ElementImport"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "CommonStructure" ;
    skos:definition "An ElementImport identifies a NamedElement in a Namespace other than the one that owns that NamedElement and allows the NamedElement to be referenced using an unqualified name in the Namespace owning the ElementImport."@en ;
    rdfs:subClassOf uml:DirectedRelationship ;
    umlmeta:oclConstraint "importedElement.visibility <> null implies importedElement.visibility = VisibilityKind::public" ;
    umlmeta:oclConstraint "visibility = VisibilityKind::public or visibility = VisibilityKind::private" .

uml:Enumeration a owl:Class ;
    rdfs:label "Enumeration"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "SimpleClassifiers" ;
