uml:InstanceSpecification a owl:Class ;
    rdfs:label "InstanceSpecification"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Classification" ;
    skos:definition "An InstanceSpecification is a model element that represents an instance in a modeled system. An InstanceSpecification can act as a DeploymentTarget in a Deployment relationship, in the case that it represents an instance of a Node. It can also act as a DeployedArtifact, if it represents an instance of an Artifact."@en ;
    rdfs:subClassOf uml:DeploymentTarget ;
    rdfs:subClassOf uml:PackageableElement ;
    rdfs:subClassOf uml:DeployedArtifact ;
    umlmeta:oclConstraint "deploymentForArtifact->notEmpty() implies classifier->exists(oclIsKindOf(Artifact))" ;
    umlmeta:oclConstraint "classifier->forAll(c | (c.allSlottableFeatures()->forAll(f | slot->select(s | s.definingFeature = f)->size() <= 1)))" ;
    umlmeta:oclConstraint "slot->forAll(s | classifier->exists (c | c.allSlottableFeatures()->includes (s.definingFeature)))" ;
    umlmeta:oclConstraint "deployment->notEmpty() implies classifier->exists(node | node.oclIsKindOf(Node) and Node.allInstances()->exists(n | n.part->exists(p | p.type = node)))" .

uml:EnumerationLiteral a owl:Class ;
    rdfs:label "EnumerationLiteral"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "SimpleClassifiers" ;
    skos:definition "An EnumerationLiteral is a user-defined data value for an Enumeration."@en ;
    rdfs:subClassOf uml:InstanceSpecification ;
    umlmeta:oclConstraint "deploymentForArtifact->notEmpty() implies classifier->exists(oclIsKindOf(Artifact))" ;
    umlmeta:oclConstraint "classifier->forAll(c | (c.allSlottableFeatures()->forAll(f | slot->select(s | s.definingFeature = f)->size() <= 1)))" ;
    umlmeta:oclConstraint "slot->forAll(s | classifier->exists (c | c.allSlottableFeatures()->includes (s.definingFeature)))" ;
    umlmeta:oclConstraint "deployment->notEmpty() implies classifier->exists(node | node.oclIsKindOf(Node) and Node.allInstances()->exists(n | n.part->exists(p | p.type = node)))" .

uml:ExceptionHandler a owl:Class ;
    rdfs:label "ExceptionHandler"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Activities" ;
    skos:definition "An ExceptionHandler is an Element that specifies a handlerBody ExecutableNode to execute in case the specified exception occurs during the execution of the protected ExecutableNode."@en ;
    rdfs:subClassOf uml:Element ;
    umlmeta:oclConstraint "handlerBody.incoming->isEmpty() and handlerBody.outgoing->isEmpty() and exceptionInput.incoming->isEmpty()" ;
    umlmeta:oclConstraint "(protectedNode.oclIsKindOf(Action) and protectedNode.oclAsType(Action).output->notEmpty()) implies ( handlerBody.oclIsKindOf(Action) and let protectedNodeOutput : OrderedSet(OutputPin) = protectedNode.oclAsType(Action).output, handlerBodyOutput : OrderedSet(OutputPin) = handlerBody.oclAsType(Action).output in protectedNodeOutput->size() = handlerBodyOutput->size() and Sequence{1..protectedNodeOutput->size()}->forAll(i | handlerBodyOutput->at(i).type.conformsTo(protectedNodeOutput->at(i).type) and handlerBodyOutput->at(i).isOrdered=protectedNodeOutput->at(i).isOrdered and handlerBodyOutput->at(i).compatibleWith(protectedNodeOutput->at(i))) )" ;
    umlmeta:oclConstraint "handlerBody.oclIsKindOf(Action) and let inputs: OrderedSet(InputPin) = handlerBody.oclAsType(Action).input in inputs->size()=1 and inputs->first()=exceptionInput" ;
    umlmeta:oclConstraint "let nodes:Set(ActivityNode) = handlerBody.oclAsType(Action).allOwnedNodes() in nodes.outgoing->forAll(nodes->includes(target)) and nodes.incoming->forAll(nodes->includes(source))" ;
    umlmeta:oclConstraint "handlerBody.owner=protectedNode.owner" ;
    umlmeta:oclConstraint "exceptionInput.type=null or exceptionType->forAll(conformsTo(exceptionInput.type.oclAsType(Classifier)))" .

uml:ExecutionEnvironment a owl:Class ;
    rdfs:label "ExecutionEnvironment"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Deployments" ;
    skos:definition "An execution environment is a node that offers an execution environment for specific types of components that are deployed on it in the form of executable artifacts."@en ;
    rdfs:subClassOf uml:Node ;
    umlmeta:oclConstraint "part->forAll(oclIsKindOf(Node))" .

uml:ExecutionOccurrenceSpecification a owl:Class ;
    rdfs:label "ExecutionOccurrenceSpecification"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Interactions" ;
    skos:definition "An ExecutionOccurrenceSpecification represents moments in time at which Actions or Behaviors start or finish."@en ;
    rdfs:subClassOf uml:OccurrenceSpecification ;
    umlmeta:oclConstraint "(namespace = null and owner <> null) implies visibility = null" ;
    umlmeta:oclConstraint "(name <> null and allNamespaces()->select(ns | ns.name = null)->isEmpty()) implies qualifiedName = allNamespaces()->iterate( ns : Namespace; agg: String = name | ns.name.concat(self.separator()).concat(agg))" ;
    umlmeta:oclConstraint "name=null or allNamespaces()->select( ns | ns.name=null )->notEmpty() implies qualifiedName = null" .

uml:ExpansionNode a owl:Class ;
    rdfs:label "ExpansionNode"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Actions" ;
    skos:definition "An ExpansionNode is an ObjectNode used to indicate a collection input or output for an ExpansionRegion. A collection input of an ExpansionRegion contains a collection that is broken into its individual elements inside the region, whose content is executed once per element. A collection output of an ExpansionRegion combines individual elements produced by the execution of the region into a collection for use outside the region."@en ;
    rdfs:subClassOf uml:ObjectNode ;
    umlmeta:oclConstraint "regionAsInput->notEmpty() xor regionAsOutput->notEmpty()" .

uml:ExpansionRegion a owl:Class ;
    rdfs:label "ExpansionRegion"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Actions" ;
    skos:definition "An ExpansionRegion is a StructuredActivityNode that executes its content multiple times corresponding to elements of input collection(s)."@en ;
    rdfs:subClassOf uml:StructuredActivityNode ;
    umlmeta:oclConstraint "output.outgoing.target->excludesAll(allOwnedNodes()-input)" ;
    umlmeta:oclConstraint "edge=self.sourceNodes().outgoing->intersection(self.allOwnedNodes().incoming)-> union(self.targetNodes().incoming->intersection(self.allOwnedNodes().outgoing))->asSet()" ;
    umlmeta:oclConstraint "input.incoming.source->excludesAll(allOwnedNodes()-output)" .

uml:Expression a owl:Class ;
    rdfs:label "Expression"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Values" ;
    skos:definition "An Expression represents a node in an expression tree, which may be non-terminal or terminal. It defines a symbol, and has a possibly empty sequence of operands that are ValueSpecifications. It denotes a (possibly empty) set of values when evaluated in a context."@en ;
    rdfs:subClassOf uml:ValueSpecification ;
    umlmeta:oclConstraint "visibility = null implies namespace = null" .

uml:Extend a owl:Class ;
    rdfs:label "Extend"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "UseCases" ;
    skos:definition "A relationship from an extending UseCase to an extended UseCase that specifies how and when the behavior defined in the extending UseCase can be inserted into the behavior defined in the extended UseCase."@en ;
    rdfs:subClassOf uml:DirectedRelationship ;
    rdfs:subClassOf uml:NamedElement ;
    umlmeta:oclConstraint "extensionLocation->forAll (xp | extendedCase.extensionPoint->includes(xp))" .

uml:Extension a owl:Class ;
    rdfs:label "Extension"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Packages" ;
    skos:definition "An extension is used to indicate that the properties of a metaclass are extended through a stereotype, and gives the ability to flexibly add (and later remove) stereotypes to classes."@en ;
    rdfs:subClassOf uml:Association ;
    umlmeta:oclConstraint "metaclassEnd()->notEmpty() and metaclassEnd().type.oclIsKindOf(Class)" ;
    umlmeta:oclConstraint "memberEnd->size() = 2" .

uml:StructuralFeature a owl:Class ;
    rdfs:label "StructuralFeature"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Classification" ;
    umlmeta:abstract true ;
    skos:definition "A StructuralFeature is a typed feature of a Classifier that specifies the structure of instances of the Classifier."@en ;
    rdfs:subClassOf uml:Feature ;
    rdfs:subClassOf uml:TypedElement ;
    rdfs:subClassOf uml:MultiplicityElement ;
    umlmeta:oclConstraint "redefinedElement->forAll(re | re.isConsistentWith(self))" ;
    umlmeta:oclConstraint "redefinedElement->forAll(re | not re.isLeaf)" ;
    umlmeta:oclConstraint "redefinedElement->forAll(re | self.isRedefinitionContextValid(re))" .

uml:Property a owl:Class ;
    rdfs:label "Property"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Classification" ;
    skos:definition "A Property is a StructuralFeature. A Property related by ownedAttribute to a Classifier (other than an association) represents an attribute and might also represent an association end. It relates an instance of the Classifier to a value or set of values of the type of the attribute. A Property related by memberEnd to an Association represents an end of the Association. The type of the Property is the type of the end of the Association. A Property has the capability of being a DeploymentTarget in a Deployment relationship. This enables modeling the deployment to hierarchical nodes that have Properties functioning as internal parts. Property specializes ParameterableElement to specify that a Property can be exposed as a formal template parameter, and provided as an actual parameter in a binding of a template."@en ;
    rdfs:subClassOf uml:StructuralFeature ;
    rdfs:subClassOf uml:ConnectableElement ;
    rdfs:subClassOf uml:DeploymentTarget ;
    umlmeta:oclConstraint "subsettedProperty->notEmpty() implies (subsettingContext()->notEmpty() and subsettingContext()->forAll (sc | subsettedProperty->forAll(sp | sp.subsettingContext()->exists(c | sc.conformsTo(c)))))" ;
    umlmeta:oclConstraint "isDerivedUnion implies isReadOnly" ;
    umlmeta:oclConstraint "isComposite and association <> null implies opposite.upperBound() <= 1" ;
    umlmeta:oclConstraint "(redefinedProperty->notEmpty()) implies (redefinitionContext->notEmpty() and redefinedProperty->forAll(rp| ((redefinitionContext->collect(fc| fc.allParents()))->asSet())->collect(c| c.allFeatures())->asSet()->includes(rp)))" ;
    umlmeta:oclConstraint "subsettedProperty->forAll(sp | self.type.conformsTo(sp.type) and ((self.upperBound()->notEmpty() and sp.upperBound()->notEmpty()) implies self.upperBound() <= sp.upperBound() ))" ;
    umlmeta:oclConstraint "(self.isAttribute() and (templateParameterSubstitution->notEmpty()) implies (templateParameterSubstitution->forAll(ts | ts.formal.oclIsKindOf(Property) and ts.formal.oclAsType(Property).isAttribute())))" ;
    umlmeta:oclConstraint "isDerivedUnion implies isDerived" ;
    umlmeta:oclConstraint "deployment->notEmpty() implies owner.oclIsKindOf(Node) and Node.allInstances()->exists(n | n.part->exists(p | p = self))" ;
    umlmeta:oclConstraint "subsettedProperty->forAll(sp | sp.name <> name)" ;
    umlmeta:oclConstraint "(opposite->notEmpty() and owningAssociation->isEmpty()) implies classifier = opposite.type" ;
    umlmeta:oclConstraint "qualifier->notEmpty() implies association->notEmpty()" .

uml:ExtensionEnd a owl:Class ;
    rdfs:label "ExtensionEnd"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Packages" ;
    skos:definition "An extension end is used to tie an extension to a stereotype when extending a metaclass. The default multiplicity of an extension end is 0..1."@en ;
    rdfs:subClassOf uml:Property ;
    umlmeta:oclConstraint "(lowerBound() = 0 or lowerBound() = 1) and upperBound() = 1" ;
    umlmeta:oclConstraint "self.aggregation = AggregationKind::composite" .

uml:ExtensionPoint a owl:Class ;
    rdfs:label "ExtensionPoint"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "UseCases" ;
    skos:definition "An ExtensionPoint identifies a point in the behavior of a UseCase where that behavior can be extended by the behavior of some other (extending) UseCase, as specified by an Extend relationship."@en ;
    rdfs:subClassOf uml:RedefinableElement ;
    umlmeta:oclConstraint "name->notEmpty ()" .

uml:State a owl:Class ;
    rdfs:label "State"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "StateMachines" ;
    skos:definition "A State models a situation during which some (usually implicit) invariant condition holds."@en ;
    rdfs:subClassOf uml:Vertex ;
    rdfs:subClassOf uml:Namespace ;
    umlmeta:oclConstraint "connectionPoint->forAll(kind = PseudostateKind::entryPoint or kind = PseudostateKind::exitPoint)" ;
    umlmeta:oclConstraint "isSubmachineState implies connection->notEmpty( )" ;
    umlmeta:oclConstraint "connectionPoint->notEmpty() implies isComposite" ;
    umlmeta:oclConstraint "self.isSubmachineState implies (self.connection->forAll (cp | cp.entry->forAll (ps | ps.stateMachine = self.submachine) and cp.exit->forAll (ps | ps.stateMachine = self.submachine)))" ;
    umlmeta:oclConstraint "isComposite implies not isSubmachineState" .

uml:FinalState a owl:Class ;
    rdfs:label "FinalState"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "StateMachines" ;
    skos:definition "A special kind of State, which, when entered, signifies that the enclosing Region has completed. If the enclosing Region is directly contained in a StateMachine and all other Regions in that StateMachine also are completed, then it means that the entire StateMachine behavior is completed."@en ;
    rdfs:subClassOf uml:State ;
    umlmeta:oclConstraint "exit->isEmpty()" ;
    umlmeta:oclConstraint "outgoing->size() = 0" ;
    umlmeta:oclConstraint "region->size() = 0" ;
    umlmeta:oclConstraint "submachine->isEmpty()" ;
    umlmeta:oclConstraint "entry->isEmpty()" ;
    umlmeta:oclConstraint "doActivity->isEmpty()" .

uml:FlowFinalNode a owl:Class ;
    rdfs:label "FlowFinalNode"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Activities" ;
    skos:definition "A FlowFinalNode is a FinalNode that terminates a flow by consuming the tokens offered to it."@en ;
    rdfs:subClassOf uml:FinalNode ;
    umlmeta:oclConstraint "outgoing->isEmpty()" .

uml:ForkNode a owl:Class ;
    rdfs:label "ForkNode"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Activities" ;
    skos:definition "A ForkNode is a ControlNode that splits a flow into multiple concurrent flows."@en ;
    rdfs:subClassOf uml:ControlNode ;
    umlmeta:oclConstraint "let allEdges : Set(ActivityEdge) = incoming->union(outgoing) in allEdges->forAll(oclIsKindOf(ControlFlow)) or allEdges->forAll(oclIsKindOf(ObjectFlow))" ;
    umlmeta:oclConstraint "incoming->size()=1" .

uml:OpaqueBehavior a owl:Class ;
    rdfs:label "OpaqueBehavior"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "CommonBehavior" ;
    skos:definition "An OpaqueBehavior is a Behavior whose specification is given in a textual language other than UML."@en ;
    rdfs:subClassOf uml:Behavior ;
    umlmeta:oclConstraint "specification <> null implies _'context'.ownedBehavior->select(specification=self.specification)->size() = 1" ;
    umlmeta:oclConstraint "specification <> null implies ownedParameter->size() = specification.ownedParameter->size()" ;
    umlmeta:oclConstraint "_'context'.feature->includes(specification)" .

uml:FunctionBehavior a owl:Class ;
    rdfs:label "FunctionBehavior"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "CommonBehavior" ;
    skos:definition "A FunctionBehavior is an OpaqueBehavior that does not access or modify any objects or other external data."@en ;
    rdfs:subClassOf uml:OpaqueBehavior ;
