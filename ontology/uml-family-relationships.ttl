uml:BehavioralFeature a owl:Class ;
    rdfs:label "BehavioralFeature"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Classification" ;
    umlmeta:abstract true ;
    skos:definition "A BehavioralFeature is a feature of a Classifier that specifies an aspect of the behavior of its instances. A BehavioralFeature is implemented (realized) by a Behavior. A BehavioralFeature specifies that a Classifier will respond to a designated request by invoking its implementing method."@en ;
    rdfs:subClassOf uml:Feature ;
    rdfs:subClassOf uml:Namespace ;
