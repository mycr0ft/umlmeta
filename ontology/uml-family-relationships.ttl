    umlmeta:oclConstraint "Values for the ownedOperation metaproperty must be stereotyped «ResourceMethod» or its specializations." ;
    umlmeta:oclConstraint "Values for the ownedPort metaproperty must be stereotyped «ResourcePort» or its specializations." ;
    umlmeta:oclConstraint "Is capable of performing only «Function» elements or its specializations." .

uaf:TemporalPart a owl:Class ;
    rdfs:label "TemporalPart"@en ;
    umlmeta:language "UAF"@en ;
    umlmeta:omgPackage "Classification" ;
    skos:altLabel "TemporalPart"@en ;
    umlmeta:stereotypeUri "UAF::Structure::TemporalPart" ;
    skos:definition "Usage of a StrategicPhase in the context of another StrategicPhase. It asserts that one StrategicPhase is a spatial part of another. Creates a whole-part relationship that represents the temporal structure of the StrategicPhase."@en ;
    rdfs:subClassOf uml:Property ;
    rdfs:subClassOf uaf:MeasurableElement ;
    umlmeta:oclConstraint "Value for class metaproperty must be stereotyped «EnterprisePhase» or its specializations." ;
    umlmeta:oclConstraint "Value for type metaproperty must be stereotyped «EnterprisePhase» or its specializations." .

uaf:ValueItem a owl:Class ;
    rdfs:label "ValueItem"@en ;
    umlmeta:language "UAF"@en ;
    umlmeta:omgPackage "StructuredClassifiers" ;
    skos:altLabel "ValueItem"@en ;
    umlmeta:stereotypeUri "UAF::Taxonomy::ValueItem" ;
    skos:definition "An ideal, custom, or institution that an enterprise promotes or agrees with. It may be positive or negative, depending on point of view."@en ;
    rdfs:subClassOf uaf:StrategicAsset ;
    rdfs:subClassOf uaf:MeasurementSet ;
    rdfs:subClassOf uml:DataType ;
    umlmeta:oclConstraint "UML::Association.allInstances()->select(a| a.memberEnd->forAll(e| e.type->notEmpty() and Block.allInstances().base_Class->includes(e.type)))->forAll(a | a.memberEnd->size()=2)" ;
    umlmeta:oclConstraint "self.base_Class.ownedConnector->forAll(c | c.end->size()=2 )" ;
    umlmeta:oclConstraint "-- Cannot be expressed in OCL" ;
    umlmeta:oclConstraint "self.base_Class.ownedAttribute->select(a| ValueType.allInstances().base_DataType->includes(a.type))->forAll(a|a.isComposite())" ;
    umlmeta:oclConstraint "self.base_Class->closure(part->select(p|p.type.oclIsKindOf(UML::Class)).type.oclAsType(UML::Class))->excludes(self.base_Class)" ;
    umlmeta:oclConstraint "UML::Classifier.allInstances()->select(c | c.general->includes(self.base_Class))->forAll(c | Block.allInstances()->includes(c))" ;
    umlmeta:oclConstraint "self.base_Class.ownedAttribute->select(a| ValueType.allInstances().base_DataType->includes(a.type))->forAll(a|a.isComposite())" .

uaf:ValueStream a owl:Class ;
    rdfs:label "ValueStream"@en ;
    umlmeta:language "UAF"@en ;
    umlmeta:omgPackage "Classification" ;
    skos:altLabel "ValueStream"@en ;
    umlmeta:stereotypeUri "UAF::Processes::ValueStream" ;
    skos:definition "An end-to-end collection of activities that create a result for a customer, who may be the ultimate customer or an internal end-user of the value stream. Value stream nested within another value stream may represent Value Stream Stage - a distinct, identifiable phase or step within a value stream [The Business Architecture Metamodel Guide, 2020]."@en ;
    rdfs:subClassOf uaf:ActualStrategicPhase ;
    rdfs:subClassOf uml:InstanceSpecification ;
    umlmeta:oclConstraint "Value for the classifier metaproperty must be stereotyped by «StrategicPhase» or its specializations." ;
    umlmeta:oclConstraint "Must fall within the start and end dates of the enclosing ActualStrategicPhase having this ActualStrategicPhase set as a value for a slot." .

uaf:VersionOfConfiguration a owl:Class ;
    rdfs:label "VersionOfConfiguration"@en ;
    umlmeta:language "UAF"@en ;
    umlmeta:omgPackage "Classification" ;
    skos:altLabel "VersionOfConfiguration"@en ;
    umlmeta:stereotypeUri "UAF::Roadmap::VersionOfConfiguration" ;
    skos:definition "A property of a WholeLifeConfiguration, used in version control of a VersionedElement. It asserts that a VersionedElement is a version of a WholeLifeConfiguration."@en ;
    rdfs:subClassOf uml:Property ;
    rdfs:subClassOf uaf:MeasurableElement ;
    umlmeta:oclConstraint "Value for the class metaproperty must be stereotyped «WholeLifeConfiguration» or its specializations." ;
    umlmeta:oclConstraint "Value for the type metaproperty must be stereotyped by the specialization of «VersionedElement»." .

uaf:VersionSuccession a owl:Class ;
    rdfs:label "VersionSuccession"@en ;
    umlmeta:language "UAF"@en ;
    umlmeta:omgPackage "CommonStructure" ;
    skos:altLabel "VersionSuccession"@en ;
    umlmeta:stereotypeUri "UAF::Roadmap::VersionSuccession" ;
    skos:definition "A dependency relationship between two VersionOfConfigurations that denotes that one VersionOfConfiguration follows from another."@en ;
    rdfs:subClassOf uml:Dependency ;
    rdfs:subClassOf uaf:MeasurableElement ;
    umlmeta:oclConstraint "Value for the client metaproperty must be stereotyped «VersionOfConfiguration» or its specializations." ;
    umlmeta:oclConstraint "Value for the supplier metaproperty must be stereotyped «VersionOfConfiguration» or its specializations." .

uaf:View a owl:Class ;
    rdfs:label "View"@en ;
    umlmeta:language "UAF"@en ;
    umlmeta:omgPackage "StructuredClassifiers" ;
    skos:altLabel "View"@en ;
    umlmeta:stereotypeUri "UAF::Summary and Overview::View" ;
    skos:definition "An information item, governed by an architecture viewpoint, comprising part of an architecture description that communicates some aspect of an architecture."@en ;
    rdfs:subClassOf sysml:View ;
    rdfs:subClassOf uml:Class ;
    rdfs:subClassOf uaf:PropertySet ;
    umlmeta:oclConstraint "Conform.allInstances()->select(base_Generalization.specific = self.base_Class)->size() = 1" ;
    umlmeta:oclConstraint "self.viewpoint = Viewpoint.allInstances()->any(base_Class = Conform.allInstances()->any(base_Generalization.specific = self.base_Class).base_Generalization.general)" ;
    umlmeta:oclConstraint "self.stakeholder = Viewpoint.allInstances()->any(base_Class = Conform.allInstances()->any(base_Generalization.specific = self.base_Class).base_Generalization.general).stakeholder" .

uaf:Viewpoint a owl:Class ;
    rdfs:label "Viewpoint"@en ;
    umlmeta:language "UAF"@en ;
    umlmeta:omgPackage "StructuredClassifiers" ;
    skos:altLabel "Viewpoint"@en ;
    umlmeta:stereotypeUri "UAF::Summary and Overview::Viewpoint" ;
    skos:definition "Conventions for the creation, interpretation and use of an architecture view to frame one or more concerns that governs the creation of views."@en ;
    rdfs:subClassOf sysml:Viewpoint ;
    rdfs:subClassOf uml:Class ;
    rdfs:subClassOf uaf:PropertySet ;
    umlmeta:oclConstraint "self.method = self.base_Class.allFeatures()->select(f | f.oclIsKindOf(UML::Operation))->select(o | Standard::Create.allInstances().base_BehavioralFeature->includes(o)).oclAsType(UML::Operation).method" ;
    umlmeta:oclConstraint "self.base_Class.ownedOperation->exists(o | o.name='View' and Standard::Create.allInstances().base_BehavioralFeature->includes(o))" .

uaf:VisionStatement a owl:Class ;
