    umlmeta:language "UAF"@en ;
    umlmeta:omgPackage "Classification" ;
    skos:altLabel "FieldedCapability"@en ;
    umlmeta:stereotypeUri "UAF::Taxonomy::FieldedCapability" ;
    skos:definition "An actual, fully-realized capability. A FieldedCapability is typed by a CapabilityConfiguration."@en ;
    rdfs:subClassOf uaf:ActualResource ;
    rdfs:subClassOf uml:InstanceSpecification ;
    umlmeta:oclConstraint "Value for the classifier metaproperty must be stereotyped «CapabilityConfiguration» or its specializations." .

uaf:FillsPost a owl:Class ;
    rdfs:label "FillsPost"@en ;
    umlmeta:language "UAF"@en ;
    umlmeta:omgPackage "CommonStructure" ;
    skos:altLabel "FillsPost"@en ;
    umlmeta:stereotypeUri "UAF::Connectivity::FillsPost" ;
    skos:definition "A dependency relationship that asserts that an ActualPerson fills an ActualPost."@en ;
    rdfs:subClassOf sysml:Allocate ;
    rdfs:subClassOf uml:Abstraction ;
    rdfs:subClassOf uaf:MeasurableElement ;
    umlmeta:oclConstraint "Value for the client metaproperty must be stereotyped by «ActualPerson» or its specializations." ;
    umlmeta:oclConstraint "Value for the supplier metaproperty must be stereotyped by «ActualPost» or its specializations." .

uaf:Forecast a owl:Class ;
    rdfs:label "Forecast"@en ;
    umlmeta:language "UAF"@en ;
    umlmeta:omgPackage "CommonStructure" ;
    skos:altLabel "Forecast"@en ;
    umlmeta:stereotypeUri "UAF::Roadmap::Forecast" ;
    skos:definition "A dependency relationship that specifies a transition from one Resource Performer, Standard, Competence to another future one. It is related to an ActualStrategicPhase to give it a temporal context."@en ;
    rdfs:subClassOf uml:Dependency ;
    rdfs:subClassOf uaf:MeasurableElement ;
    umlmeta:oclConstraint "Value for the supplier property must be stereotyped by the specialization of «SubjectOfForecast»." ;
    umlmeta:oclConstraint "Value for the client metaproperty must be stereotyped by the specialization of «SubjectOfForecast»." ;
    umlmeta:oclConstraint "Values for the client and supplier metaproperties must be stereotyped by the same specialization of «SubjectOfForecast» (e.g. «Software» to «Software», «Standard» to «Standard», etc)." .

uaf:Function a owl:Class ;
    rdfs:label "Function"@en ;
    umlmeta:language "UAF"@en ;
    umlmeta:omgPackage "Activities" ;
    skos:altLabel "Function"@en ;
    umlmeta:stereotypeUri "UAF::Processes::Function" ;
    skos:definition "An Activity which is specified in the context to the ResourcePerformer (human or machine) that IsCapableToPerform it."@en ;
    rdfs:subClassOf uaf:Activity ;
    rdfs:subClassOf uml:Activity ;
    rdfs:subClassOf uaf:SubjectOfResourceConstraint ;
    umlmeta:oclConstraint "The values for the ownedParameter metaproperty must be stereotyped «ResourceParameter» or its specializations." .

uaf:FunctionAction a owl:Class ;
    rdfs:label "FunctionAction"@en ;
    umlmeta:language "UAF"@en ;
    umlmeta:omgPackage "Actions" ;
    skos:altLabel "FunctionAction"@en ;
    umlmeta:stereotypeUri "UAF::Processes::FunctionAction" ;
    skos:definition "A call of a Function indicating that the Function is performed by a ResourceRole in a specific context."@en ;
    rdfs:subClassOf uml:CallBehaviorAction ;
    rdfs:subClassOf uaf:MeasurableElement ;
    umlmeta:oclConstraint "Value for the activity metaproperty must be stereotyped «Function» or its specializations." ;
    umlmeta:oclConstraint "Value for the behavior metaproperty must be stereotyped «Function» or its specializations." .

uaf:FunctionEdge a owl:Class ;
    rdfs:label "FunctionEdge"@en ;
    umlmeta:language "UAF"@en ;
    umlmeta:omgPackage "Activities" ;
    umlmeta:abstract true ;
    skos:altLabel "FunctionEdge"@en ;
    umlmeta:stereotypeUri "UAF::Processes::FunctionEdge" ;
    skos:definition "Abstract grouping for FunctionControlFlow and FunctionObjectFlow."@en ;
    rdfs:subClassOf uml:ActivityEdge ;
    rdfs:subClassOf uaf:MeasurableElement ;
    umlmeta:oclConstraint "«FunctionEdge» must be owned directly or indirectly by «Function» or its specializations." .

uaf:FunctionControlFlow a owl:Class ;
    rdfs:label "FunctionControlFlow"@en ;
    umlmeta:language "UAF"@en ;
    umlmeta:omgPackage "Activities" ;
    skos:altLabel "FunctionControlFlow"@en ;
    umlmeta:stereotypeUri "UAF::Processes::FunctionControlFlow" ;
    skos:definition "An ActivityEdge that shows the flow of control between FunctionActions."@en ;
    rdfs:subClassOf uml:ControlFlow ;
    rdfs:subClassOf uaf:FunctionEdge ;
    umlmeta:oclConstraint "Value for the source metaproperty must be stereotyped «FunctionAction» or its specializations." ;
    umlmeta:oclConstraint "Value for the target metaproperty must be stereotyped «FunctionAction» or its specializations." .

uaf:FunctionObjectFlow a owl:Class ;
    rdfs:label "FunctionObjectFlow"@en ;
    umlmeta:language "UAF"@en ;
    umlmeta:omgPackage "Activities" ;
    skos:altLabel "FunctionObjectFlow"@en ;
    umlmeta:stereotypeUri "UAF::Processes::FunctionObjectFlow" ;
    skos:definition "An ActivityEdge that shows the flow of Resources (objects/data) between FunctionActions."@en ;
    rdfs:subClassOf uml:ObjectFlow ;
    rdfs:subClassOf uaf:FunctionEdge ;
    umlmeta:oclConstraint "selection<>null implies selection.inputParameters()->size()=1 and selection.inputParameters()->forAll(not isUnique and is(0,*)) and selection.outputParameters()->size()=1" ;
    umlmeta:oclConstraint "not (source.oclIsKindOf(ExecutableNode) or target.oclIsKindOf(ExecutableNode))" ;
    umlmeta:oclConstraint "transformation<>null implies transformation.inputParameters()->size()=1 and transformation.outputParameters()->size()=1" ;
    umlmeta:oclConstraint "selection<>null implies source.oclIsKindOf(ObjectNode)" ;
    umlmeta:oclConstraint "(no specification serialized)" ;
    umlmeta:oclConstraint "(no specification serialized)" ;
    umlmeta:oclConstraint "(no specification serialized)" ;
    umlmeta:oclConstraint "not (isMulticast and isMultireceive)" .

uaf:GeoPoliticalExtentType a owl:Class ;
    rdfs:label "GeoPoliticalExtentType"@en ;
    umlmeta:language "UAF"@en ;
    umlmeta:omgPackage "SimpleClassifiers" ;
    skos:altLabel "GeoPoliticalExtentType"@en ;
    umlmeta:stereotypeUri "UAF::Parameters::GeoPoliticalExtentType" ;
    skos:definition "A type of geospatial extent whose boundaries are defined by declaration or agreement by political parties."@en ;
    rdfs:subClassOf uaf:Condition ;
    rdfs:subClassOf uml:DataType ;
    rdfs:subClassOf uaf:ResourceExchangeItem ;
    rdfs:subClassOf uaf:OperationalExchangeItem ;
    rdfs:subClassOf uaf:StrategicExchangeItem ;
    umlmeta:oclConstraint "UML::Classifier.allInstances()->forAll(c | c.general->includes(self.base_DataType) implies ValueType.allInstances().base_DataType->includes(c))" ;
    umlmeta:oclConstraint "self.unit->notEmpty() and self.unit.classifier->notEmpty() implies self.unit.classifier->forAll(c | c.oclIsKindOf(Libraries::UnitAndQuantityKind::Unit))" ;
    umlmeta:oclConstraint "self.quantityKind->notEmpty() and self.quantityKind.classifier->notEmpty() implies self.quantityKind.classifier->forAll(c | c.oclIsKindOf(Libraries::UnitAndQuantityKind::QuantityKind))" .

uaf:GovernedBy a owl:Class ;
    rdfs:label "GovernedBy"@en ;
    umlmeta:language "UAF"@en ;
    umlmeta:omgPackage "CommonStructure" ;
    skos:altLabel "GovernedBy"@en ;
    umlmeta:stereotypeUri "UAF::Traceability::GovernedBy" ;
    skos:definition "An abstraction relationship that exists between the ServiceContract and the Service that it governs."@en ;
    rdfs:subClassOf sysml:Allocate ;
    rdfs:subClassOf uml:Abstraction ;
    rdfs:subClassOf uaf:MeasurableElement ;
    umlmeta:oclConstraint "Value for the client metaproperty must be stereotyped «Service» or its specializations." ;
    umlmeta:oclConstraint "Value for the supplier metaproperty must be stereotyped «ServiceContract» or its specializations." .

uaf:HighLevelOperationalConcept a owl:Class ;
    rdfs:label "HighLevelOperationalConcept"@en ;
    umlmeta:language "UAF"@en ;
    umlmeta:omgPackage "StructuredClassifiers" ;
    skos:altLabel "HighLevelOperationalConcept"@en ;
    umlmeta:stereotypeUri "UAF::Taxonomy::HighLevelOperationalConcept" ;
    skos:definition "Describes the Resources and Locations required to meet an operational scenario from an integrated systems point of view. It is used to communicate overall quantitative and qualitative system characteristics to stakeholders."@en ;
    rdfs:subClassOf sysml:Block ;
    rdfs:subClassOf uml:Class ;
    rdfs:subClassOf uaf:PropertySet ;
    umlmeta:oclConstraint "UML::Association.allInstances()->select(a| a.memberEnd->forAll(e| e.type->notEmpty() and Block.allInstances().base_Class->includes(e.type)))->forAll(a | a.memberEnd->size()=2)" ;
    umlmeta:oclConstraint "self.base_Class.ownedConnector->forAll(c | c.end->size()=2 )" ;
    umlmeta:oclConstraint "-- Cannot be expressed in OCL" ;
    umlmeta:oclConstraint "self.base_Class.ownedAttribute->select(a| ValueType.allInstances().base_DataType->includes(a.type))->forAll(a|a.isComposite())" ;
    umlmeta:oclConstraint "self.base_Class->closure(part->select(p|p.type.oclIsKindOf(UML::Class)).type.oclAsType(UML::Class))->excludes(self.base_Class)" ;
    umlmeta:oclConstraint "UML::Classifier.allInstances()->select(c | c.general->includes(self.base_Class))->forAll(c | Block.allInstances()->includes(c))" ;
    umlmeta:oclConstraint "self.base_Class.ownedAttribute->select(a| ValueType.allInstances().base_DataType->includes(a.type))->forAll(a|a.isComposite())" .

uaf:ISO8601DateTime a owl:Class ;
    rdfs:label "ISO8601DateTime"@en ;
    umlmeta:language "UAF"@en ;
    umlmeta:omgPackage "Values" ;
    skos:altLabel "ISO8601DateTime"@en ;
    umlmeta:stereotypeUri "UAF::Taxonomy::ISO8601DateTime" ;
    skos:definition "A date and time specified in the ISO8601 date-time format including timezone designator (TZD): YYYY-MM-DDThh:mm:ssTZD."@en ;
    rdfs:subClassOf uml:LiteralString ;
    rdfs:subClassOf uaf:UAFElement ;
    umlmeta:oclConstraint "visibility = null implies namespace = null" .

uaf:ImpactedBy a owl:Class ;
    rdfs:label "ImpactedBy"@en ;
    umlmeta:language "UAF"@en ;
    umlmeta:omgPackage "CommonStructure" ;
    skos:altLabel "ImpactedBy"@en ;
    umlmeta:stereotypeUri "UAF::Motivation::ImpactedBy" ;
    skos:definition "A dependency relationship denoting that a Capability is affected by an Opportunity."@en ;
    rdfs:subClassOf uml:Abstraction ;
    rdfs:subClassOf uaf:MeasurableElement ;
    umlmeta:oclConstraint "In case of value for ImpactedBy.client is stereotyped: a. by any of specializations of «Architecture», values for the supplier metaproperty must be stereotyped «Challenge» or its specializations, b. by any of specializations of «ActualStrategicPhase», values for the supplier metaproperty must be stereotyped «Challenge» or its specializations, c. «OperationalActivity» or its specializations, values for the supplier metaproperty must be stereotyped «Challenge» or its specializations, d. «Capability» or its specializations, values for the supplier metaproperty must be stereotyped «Opportunity» or its specializations, e. «ActualOutcome» or its specializations, values for the supplier metaproperty must be stereotyped «EnterpriseGoal» or its specializations." ;
    umlmeta:oclConstraint "In case of value for ImpactedBy.supplier is stereotyped: a. «Challenge» or its specializations, values for the client metaproperty must be stereotyped by any of specializations of «Architecture» or «ActualStrategicPhase», or «OperationalActivity» or its specializations, b. «Opportunity» or its specializations, values for the client metaproperty must be stereotyped «Capability» or its specializations, c. «EnterpriseGoal» or its specializations, values for the client metaproperty must be stereotyped «ActualOutcome» or its specializations." .

uaf:Implements a owl:Class ;
    rdfs:label "Implements"@en ;
    umlmeta:language "UAF"@en ;
    umlmeta:omgPackage "CommonStructure" ;
    skos:altLabel "Implements"@en ;
    umlmeta:stereotypeUri "UAF::Traceability::Implements" ;
    skos:definition "An abstraction relationship that defines how an element in the upper layer of abstraction is implemented by a semantically equivalent element (for example tracing the Functions to the OperationalActivities) in the lower level of abstraction."@en ;
    rdfs:subClassOf sysml:Allocate ;
    rdfs:subClassOf uml:Abstraction ;
    rdfs:subClassOf uaf:MeasurableElement ;
    umlmeta:oclConstraint "In case of value for Implements.supplier is stereotyped: a. by any of specializations of «OperationalAgent», values for the client metaproperty must be stereotyped by any of specializations of «ResourcePerformer», b. «OperationalActivity» or its specializations, values for the client metaproperty must be stereotyped «Function» or its specializations, c. «ServiceFunction» or its specializations, values for the client metaproperty must be stereotyped «Function» or its specializations, d. «ServiceInterface» or its specializations, values for the client metaproperty must be stereotyped «ResourceInterface» or its specializations, e. «OperationalInterface» or its specializations, values for the client metaproperty must be stereotyped «ResourceInterface» or its specializations, f. «OperationalConnector» or its specializations, values for the client metaproperty must be stereotyped «ResourceConnector» or its specializations, g. «OperationalExchange» or its specializations, values for the client metaproperty must be stereotyped «ResourceExchange» or its specializations, g. «OperationalRole» or its specializations, values for the client metaproperty must be stereotyped «ResourceRole» or its specializations, h. «ResourceConnector» or its specializations, values for the client metaproperty must be stereotyped «ResourceConnector» or its specializations, i. «OperationalInformation» or its specializations, values for the client metaproperty must be stereotyped «ResourceInformation» or its specializations. j. by any of specializations of «ActualStrategicPhase», values for the client metaproperty must be stereotyped by any of specializations of «Architecture» or «OperationalActivity». k. «Service» or its specializations, values for the supplier metaproperty must be stereotyped «ResourceService» or its specializations. l. «StrategicInformation» or its specializations, values for the client metaproperty must be stereotyped «OperationalInformation» or its specializations." ;
    umlmeta:oclConstraint "In case of value for Implements.client is stereotyped: a. by any of specializations of «ResourcePerformer», values for the supplier metaproperty must be stereotyped by any of specializations of «OperationalAgent», b. «Function» or its specializations, values for the supplier metaproperty must be stereotyped «OperationalActivity», «ServiceFunction» or their specializations, c. «ResourceInterface» or its specializations, values for the supplier metaproperty must be stereotyped «ServiceInterface», «OperationalInterface», or their specializations, d. «ResourceConnector» or its specializations, values for the supplier metaproperty must be stereotyped «OperationalConnector», «ResourceConnector» or their specializations, e. «ResourceExchange» or its specializations, values for the supplier metaproperty must be stereotyped «OperationalExchange» or its specializations, f. «ResourceRole» or its specializations, values for the supplier metaproperty must be stereotyped «OperationalRole» or its specializations, g. «OperationalActivity» or its specializations, values for the supplier metaproperty must be stereotyped «ActualStrategicPhase» or its specializations, h. «ResourceInformation» or its specializations, values for the supplier metaproperty must be stereotyped «OperationalInformation» or its specializations. i. by any of specializations of «Architecture», values for the supplier metaproperty must be stereotyped by any of specializations of «ActualStrategicPhase». j. «ResourceService» or its specializations, values for the supplier metaproperty must be stereotyped «Service» or its specializations. k. «OperationalInformation» or its specializations, values for the supplier metaproperty must be stereotyped «StrategicInformation» or its specializations. l. «ServiceInterface» or its specializations, values for the supplier metaproperty must be stereotyped «OperationalInterface» or its specializations." .

uaf:Information a owl:Class ;
    rdfs:label "Information"@en ;
    umlmeta:language "UAF"@en ;
    umlmeta:omgPackage "CommonStructure" ;
    skos:altLabel "Information"@en ;
    umlmeta:stereotypeUri "UAF::Information::Information" ;
    skos:definition "A comment that describes the state of an item of interest in any medium or form -- and is communicated or received."@en ;
    rdfs:subClassOf uaf:MeasurableElement ;
    rdfs:subClassOf uml:Comment ;
    umlmeta:oclConstraint "Value for the annotatedElement metaproperty must be stereotyped by a specialization of «UAFElement»." .

uaf:SubjectOfOperationalConstraint a owl:Class ;
    rdfs:label "SubjectOfOperationalConstraint"@en ;
    umlmeta:language "UAF"@en ;
    umlmeta:omgPackage "CommonStructure" ;
    umlmeta:abstract true ;
    skos:altLabel "SubjectOfOperationalConstraint"@en ;
    umlmeta:stereotypeUri "UAF::Constraints::SubjectOfOperationalConstraint" ;
    skos:definition "An abstract grouping of elements that can be the subject of an OperationalConstraint."@en ;
    rdfs:subClassOf uaf:UAFElement ;
    rdfs:subClassOf uml:Element ;
    umlmeta:oclConstraint "mustBeOwned() implies owner->notEmpty()" ;
    umlmeta:oclConstraint "not allOwnedElements()->includes(self)" .

uaf:InformationModel a owl:Class ;
    rdfs:label "InformationModel"@en ;
    umlmeta:language "UAF"@en ;
    umlmeta:omgPackage "Packages" ;
    skos:altLabel "InformationModel"@en ;
    umlmeta:stereotypeUri "UAF::Information::InformationModel" ;
    skos:definition "A structural specification of information types, showing relationships between them. The type of information captured in the InformationModel is described using the enumeration InformationModelKind (Conceptual, Logical, and Physical)."@en ;
    rdfs:subClassOf uml:Package ;
    rdfs:subClassOf uaf:SubjectOfOperationalConstraint ;
    rdfs:subClassOf uaf:SubjectOfResourceConstraint ;
    umlmeta:oclConstraint "packagedElement->forAll(e | e.visibility<> null implies e.visibility = VisibilityKind::public or e.visibility = VisibilityKind::private)" .

uaf:IsCapableToPerform a owl:Class ;
    rdfs:label "IsCapableToPerform"@en ;
    umlmeta:language "UAF"@en ;
    umlmeta:omgPackage "CommonStructure" ;
    skos:altLabel "IsCapableToPerform"@en ;
    umlmeta:stereotypeUri "UAF::Processes::IsCapableToPerform" ;
    skos:definition "An Abstraction relationship defining the traceability between the structural elements to the Activities that they can perform."@en ;
    rdfs:subClassOf sysml:Allocate ;
    rdfs:subClassOf uml:Abstraction ;
    rdfs:subClassOf uaf:MeasurableElement ;
    umlmeta:oclConstraint "In case of value for IsCapableToPerform.supplier is stereotyped: a. «OperationalActivity» or its specializations, values for the client metaproperty must be stereotyped by any of specializations of «OperationalAgent», b. «ServiceFunction» or its specializations, values for the client metaproperty must be stereotyped «Service» or its specializations, c. «Function» or its specializations, except for «ProjectActivity», values for the client metaproperty must be stereotyped by any of specializations of «ResourcePerformer», d. «ProjectActivity» or its specializations, values for the client metaproperty must be stereotyped by any of specializations of «Project»." ;
    umlmeta:oclConstraint "In case of value for IsCapableToPerform.client is stereotyped: a. by a specialization of «OperationalAgent», values for the supplier metaproperty must be stereotyped «OperationalActivity» or its specializations, b. «Service» or its specializations, values for the supplier metaproperty must be stereotyped «ServiceFunction» or its specializations, c. by a specialization of «ResourcePerformer», values for the supplier metaproperty must be stereotyped «Function» or its specializations, except for «ProjectActivity», d. by a specialization of «Project», values for the supplier metaproperty must be stereotyped «ProjectActivity» or its specializations." .

uaf:OperationalAsset a owl:Class ;
    rdfs:label "OperationalAsset"@en ;
    umlmeta:language "UAF"@en ;
    umlmeta:omgPackage "StructuredClassifiers" ;
    umlmeta:abstract true ;
    skos:altLabel "OperationalAsset"@en ;
    umlmeta:stereotypeUri "UAF::Taxonomy::OperationalAsset" ;
    skos:definition "An abstract element used to group the elements of OperationalAgent and OperationalInformation allowing them to own OperationalInformationRoles."@en ;
    rdfs:subClassOf uaf:Asset ;
    rdfs:subClassOf uml:Class ;
    umlmeta:oclConstraint "UML::Association.allInstances()->select(a| a.memberEnd->forAll(e| e.type->notEmpty() and Block.allInstances().base_Class->includes(e.type)))->forAll(a | a.memberEnd->size()=2)" ;
    umlmeta:oclConstraint "self.base_Class.ownedConnector->forAll(c | c.end->size()=2 )" ;
    umlmeta:oclConstraint "-- Cannot be expressed in OCL" ;
    umlmeta:oclConstraint "self.base_Class.ownedAttribute->select(a| ValueType.allInstances().base_DataType->includes(a.type))->forAll(a|a.isComposite())" ;
    umlmeta:oclConstraint "self.base_Class->closure(part->select(p|p.type.oclIsKindOf(UML::Class)).type.oclAsType(UML::Class))->excludes(self.base_Class)" ;
    umlmeta:oclConstraint "UML::Classifier.allInstances()->select(c | c.general->includes(self.base_Class))->forAll(c | Block.allInstances()->includes(c))" ;
    umlmeta:oclConstraint "self.base_Class.ownedAttribute->select(a| ValueType.allInstances().base_DataType->includes(a.type))->forAll(a|a.isComposite())" .

uaf:OperationalAgent a owl:Class ;
    rdfs:label "OperationalAgent"@en ;
    umlmeta:language "UAF"@en ;
    umlmeta:omgPackage "StructuredClassifiers" ;
    umlmeta:abstract true ;
    skos:altLabel "OperationalAgent"@en ;
    umlmeta:stereotypeUri "UAF::Structure::OperationalAgent" ;
    skos:definition "An abstract type grouping OperationalArchitecture and OperationalPerformer."@en ;
    rdfs:subClassOf uaf:OperationalAsset ;
    rdfs:subClassOf uml:Class ;
    rdfs:subClassOf uaf:SubjectOfOperationalConstraint ;
    rdfs:subClassOf uaf:CapableElement ;
    rdfs:subClassOf uaf:Desirer ;
    umlmeta:oclConstraint "Values for the ownedPort metaproperty must be stereotyped «OperationalPort» or its specializations." ;
    umlmeta:oclConstraint "Values for the ownedOperation metaproperty must be stereotyped «OperationalMethod» or its specializations." ;
    umlmeta:oclConstraint "Is capable of performing only «OperationalActivity» elements or its specializations." .

uaf:OperationalPerformer a owl:Class ;
    rdfs:label "OperationalPerformer"@en ;
    umlmeta:language "UAF"@en ;
    umlmeta:omgPackage "StructuredClassifiers" ;
    skos:altLabel "OperationalPerformer"@en ;
    umlmeta:stereotypeUri "UAF::Structure::OperationalPerformer" ;
    skos:definition "A logical agent that IsCapableToPerform OperationalActivities which produce, consume and process Resources."@en ;
    rdfs:subClassOf uaf:OperationalAgent ;
    rdfs:subClassOf uml:Class ;
    umlmeta:oclConstraint "Values for the ownedPort metaproperty must be stereotyped «OperationalPort» or its specializations." ;
    umlmeta:oclConstraint "Values for the ownedOperation metaproperty must be stereotyped «OperationalMethod» or its specializations." ;
    umlmeta:oclConstraint "Is capable of performing only «OperationalActivity» elements or its specializations." .

uaf:KnownResource a owl:Class ;
    rdfs:label "KnownResource"@en ;
    umlmeta:language "UAF"@en ;
    umlmeta:omgPackage "StructuredClassifiers" ;
    skos:altLabel "KnownResource"@en ;
    umlmeta:stereotypeUri "UAF::Structure::KnownResource" ;
    skos:definition "Asserts that a known ResourcePerformer constrains the implementation of the OperationalPerformer that plays the role in the OperationalArchitecture."@en ;
    rdfs:subClassOf uaf:OperationalPerformer ;
    rdfs:subClassOf uaf:ResourcePerformer ;
    rdfs:subClassOf uml:Class ;
    umlmeta:oclConstraint "Values for the ownedPort metaproperty must be stereotyped «OperationalPort» or its specializations." ;
    umlmeta:oclConstraint "Values for the ownedOperation metaproperty must be stereotyped «OperationalMethod» or its specializations." ;
    umlmeta:oclConstraint "Is capable of performing only «OperationalActivity» elements or its specializations." .

uaf:Location a owl:Class ;
    rdfs:label "Location"@en ;
    umlmeta:language "UAF"@en ;
    umlmeta:omgPackage "SimpleClassifiers" ;
    skos:altLabel "Location"@en ;
    umlmeta:stereotypeUri "UAF::Parameters::Location" ;
    skos:definition "A specification of the generic area in which a LocationHolder is required to be located."@en ;
    rdfs:subClassOf uaf:Condition ;
    rdfs:subClassOf uml:DataType ;
    rdfs:subClassOf uaf:ConceptItem ;
    umlmeta:oclConstraint "UML::Classifier.allInstances()->forAll(c | c.general->includes(self.base_DataType) implies ValueType.allInstances().base_DataType->includes(c))" ;
    umlmeta:oclConstraint "self.unit->notEmpty() and self.unit.classifier->notEmpty() implies self.unit.classifier->forAll(c | c.oclIsKindOf(Libraries::UnitAndQuantityKind::Unit))" ;
    umlmeta:oclConstraint "self.quantityKind->notEmpty() and self.quantityKind.classifier->notEmpty() implies self.quantityKind.classifier->forAll(c | c.oclIsKindOf(Libraries::UnitAndQuantityKind::QuantityKind))" .

uaf:MapsToCapability a owl:Class ;
    rdfs:label "MapsToCapability"@en ;
    umlmeta:language "UAF"@en ;
    umlmeta:omgPackage "CommonStructure" ;
    skos:altLabel "MapsToCapability"@en ;
    umlmeta:stereotypeUri "UAF::Traceability::MapsToCapability" ;
    skos:definition "An Abstraction relationship denoting that an Activity contributes to providing a Capability."@en ;
    rdfs:subClassOf sysml:Allocate ;
    rdfs:subClassOf uml:Abstraction ;
    rdfs:subClassOf uaf:MeasurableElement ;
    umlmeta:oclConstraint "Value for the client metaproperty must be stereotyped a specialization of «Activity»." ;
    umlmeta:oclConstraint "Value for the supplier metaproperty must be stereotyped «Capability»." .

uaf:MapsToGoal a owl:Class ;
    rdfs:label "MapsToGoal"@en ;
    umlmeta:language "UAF"@en ;
    umlmeta:omgPackage "CommonStructure" ;
    skos:altLabel "MapsToGoal"@en ;
    umlmeta:stereotypeUri "UAF::Information::MapsToGoal" ;
    skos:definition "A dependency relationship denoting that some StrategicInformation contributes to achieving an EnterpriseGoal or Objective."@en ;
    rdfs:subClassOf sysml:Refine ;
    rdfs:subClassOf uaf:MeasurableElement ;
    rdfs:subClassOf uml:Element ;
