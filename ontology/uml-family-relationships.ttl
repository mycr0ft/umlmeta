uml:Interaction a owl:Class ;
    rdfs:label "Interaction"@en ;
    umlmeta:language "UML 2.5.1"@en ;
    umlmeta:omgPackage "Interactions" ;
    skos:definition "An Interaction is a unit of Behavior that focuses on the observable exchange of information between connectable elements."@en ;
    rdfs:subClassOf uml:Behavior ;
